+// CXL: whole slots from the start of the current block. The unused tail of a
+// block (block size modulo slot size) is never handed out: it is not covered
+// by an object.
+char* Arena::AllocateCxlSlot(size_t bytes) {
+  cxl::ArenaSlotCounters& c = cxl::GetArenaSlotCounters();
+  c.allocs.fetch_add(1, std::memory_order_relaxed);
+  uint64_t seen = c.max_bytes.load(std::memory_order_relaxed);
+  while (seen < bytes && !c.max_bytes.compare_exchange_weak(
+                             seen, bytes, std::memory_order_relaxed)) {
+  }
+  const size_t n = bytes == 0 ? 1 : (bytes + cxl_slot_bytes_ - 1) / cxl_slot_bytes_;
+  if (n > 1) {
+    c.cross.fetch_add(1, std::memory_order_relaxed);
+    if (n > cxl_slots_per_block_) {
+      fprintf(stderr, "CXL arena: allocation of %zu B exceeds a block of slots\n",
+              bytes);
+      abort();
+    }
+  }
+  if (n > cxl_slots_left_) {
+    cxl_slot_ptr_ = AllocateNewBlock(kBlockSize);
+    cxl_slots_left_ = cxl_slots_per_block_;
+  }
+  char* result = cxl_slot_ptr_;
+  cxl_slot_ptr_ += n * cxl_slot_bytes_;
+  cxl_slots_left_ -= n;
+  alloc_bytes_remaining_ = cxl_slots_left_ * cxl_slot_bytes_;
+  return result;
+}
