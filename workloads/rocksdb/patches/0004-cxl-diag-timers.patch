+// ---- diagnostic timers (patches/0004): counters only, no behaviour change ----
+// Clock: steady_clock (CLOCK_MONOTONIC, as the server's now_ns). DiagTimer = event count, total ns, and the largest
+// single event since the last TakeMax() (the server resets it at every stats read: a per-step max).
+inline uint64_t DiagNowNs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+struct DiagTimer {
+  std::atomic<uint64_t> count{0}, ns{0}, max_ns{0};
+  void Add(uint64_t d) {
+    count.fetch_add(1, std::memory_order_relaxed);
+    ns.fetch_add(d, std::memory_order_relaxed);
+    uint64_t m = max_ns.load(std::memory_order_relaxed);
+    while (d > m && !max_ns.compare_exchange_weak(m, d, std::memory_order_relaxed)) {
+    }
+  }
+  uint64_t TakeMax() { return max_ns.exchange(0, std::memory_order_relaxed); }
+};
+struct DiagCounters {
+  // ConcurrentArena::AllocateCxlSlot (arena slot mode): wait for the arena SpinMutex, counted only when the first
+  // try_lock fails (all acquisitions = ArenaSlotCounters::allocs)
+  DiagTimer slot_lock_wait;
+  // Arena::AllocateCxlSlot: AllocateNewBlock (BlockSource::Get) of a new block, inside the slot lock
+  DiagTimer slot_new_block;
+  // DBImpl::PreprocessWrite, write leader: DB mutex acquisition of the flush-scheduling block, and the whole block
+  // (DB mutex, WaitForPendingWrites, ScheduleFlushes = SwitchMemtable); the write-buffer-manager flush block
+  DiagTimer flush_mutex_wait, schedule_flushes, wbm_flush;
+};
+inline DiagCounters& GetDiagCounters() {
+  static DiagCounters c;
+  return c;
+}
