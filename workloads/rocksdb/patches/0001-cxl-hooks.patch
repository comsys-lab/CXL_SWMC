+// CXL: hooks for the CXL_SWMC rocksdb workload (workloads/rocksdb/DESIGN.md). Not part of upstream RocksDB.
+// Header-only so the patch adds no build-system entries.
+//
+// One primary DB per process uses these hooks; it is recognised by DBOptions::db_host_id == Hooks::primary_host_id
+// (secondary instances opened in the same process for remote views keep another db_host_id and are unaffected).
+//  - blocks: memtable arenas of the primary take their blocks from this source (shared memory), the arena's 2 KiB
+//    inline block is not used, and the destructor returns the blocks with the memtable id instead of freeing them.
+//  - on_superversion: called with the DB mutex held after every SuperVersion install of the primary's default
+//    column family, with its memtables (mutable first, then immutables newest first).
+//  - RemoteMemtableGet: read-only lookup in a memtable skiplist given its head node (any process mapping the same
+//    memory at the same address); InlineSkipList node layout and memtable entry format of this RocksDB version.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "rocksdb/rocksdb_namespace.h"
+
+namespace ROCKSDB_NAMESPACE {
+namespace cxl {
+
+class BlockSource {
+ public:
+  virtual ~BlockSource() = default;
+  // A block of `bytes` (<= the source's block size) or nullptr when exhausted (RocksDB then aborts the write).
+  virtual char* Get(size_t bytes) = 0;
+  // All blocks of one arena at its destruction; owner = the memtable id (0 if never set).
+  virtual void Put(const std::vector<char*>& blocks, uint64_t owner) = 0;
+};
+
+struct MemtableInfo {
+  uint64_t id;       // MemTable::GetID()
+  const void* head;  // skiplist head node (nullptr: not a skiplist memtable)
+  int max_height;    // skiplist max height (levels of the head node)
+};
+
+struct Hooks {
+  std::string primary_host_id;  // empty = hooks off
+  BlockSource* blocks = nullptr;
+  std::function<void(const std::vector<MemtableInfo>&)> on_superversion;
+};
+
+inline Hooks& GetHooks() {
+  static Hooks h;
+  return h;
+}
+inline bool IsPrimary(const std::string& db_host_id) {
+  const Hooks& h = GetHooks();
+  return !h.primary_host_id.empty() && db_host_id == h.primary_host_id;
+}
+
+// ---- remote lookup ----
+enum class RemoteResult { kNotFound, kFound, kDeleted, kUnsupported };
+
+// Read access to skiplist memory. Plain: direct loads (acquire for links). A coherence backend may supply its own
+// (e.g. copies inside read sections); `next` must return the level-n link of node x, `read` copies n bytes at p.
+struct DirectAccess {
+  const void* next(const void* x, int n) const {
+    const auto* links = static_cast<const std::atomic<const void*>*>(x);
+    return (links - n)->load(std::memory_order_acquire);
+  }
+  void read(const void* p, void* out, size_t n) const { std::memcpy(out, p, n); }
+};
+
+namespace detail {
+// varint32 decode from a bounded buffer; returns bytes used, 0 on error
+inline size_t varint32(const unsigned char* p, size_t avail, uint32_t* v) {
+  uint32_t r = 0;
+  for (size_t i = 0; i < 5 && i < avail; i++) {
+    r |= uint32_t(p[i] & 0x7f) << (7 * i);
+    if (!(p[i] & 0x80)) {
+      *v = r;
+      return i + 1;
+    }
+  }
+  return 0;
+}
+// user key of the entry at node x (entry = varint32 ikey_len, ikey = user key + 8 B trailer, varint32 vlen, value).
+// The entry starts right after next_[0] (InlineSkipList: Key() = &next_[1]). `buf` receives at least the internal key.
+template <class A>
+inline bool entry_ikey(const A& a, const void* x, std::string* buf, size_t* hdr) {
+  const char* key = static_cast<const char*>(x) + sizeof(void*);
+  unsigned char lenb[5];
+  a.read(key, lenb, 5);
+  uint32_t klen;
+  size_t h = varint32(lenb, 5, &klen);
+  if (!h || klen < 8) return false;
+  buf->resize(klen);
+  a.read(key + h, &(*buf)[0], klen);
+  *hdr = h;
+  return true;
+}
+}  // namespace detail
+
+// Newest entry of user_key in the skiplist at head (internal key order: user key bytewise ascending, then sequence
+// descending). value receives the value of a kTypeValue entry; *seq the entry's sequence number.
+template <class A = DirectAccess>
+inline RemoteResult RemoteMemtableGet(const void* head, int max_height, const std::string& user_key,
+                                      std::string* value, uint64_t* seq, const A& a = A()) {
+  const void* x = head;
+  std::string ik;
+  size_t hdr = 0;
+  const void* found = nullptr;
+  for (int level = max_height - 1; level >= 0;) {
+    const void* nx = a.next(x, level);
+    if (nx != nullptr) {
+      if (!detail::entry_ikey(a, nx, &ik, &hdr)) return RemoteResult::kUnsupported;
+      size_t ulen = ik.size() - 8;
+      int c = std::memcmp(ik.data(), user_key.data(), std::min(ulen, user_key.size()));
+      bool less = c < 0 || (c == 0 && ulen < user_key.size());
+      if (less) {
+        x = nx;
+        continue;
+      }
+    }
+    if (level == 0) {
+      found = nx;
+      break;
+    }
+    level--;
+  }
+  if (found == nullptr) return RemoteResult::kNotFound;
+  // `ik` holds the internal key of `found` (the last node examined at level 0)
+  size_t ulen = ik.size() - 8;
+  if (ulen != user_key.size() || std::memcmp(ik.data(), user_key.data(), ulen) != 0) return RemoteResult::kNotFound;
+  uint64_t trailer;
+  std::memcpy(&trailer, ik.data() + ulen, 8);
+  *seq = trailer >> 8;
+  unsigned type = unsigned(trailer & 0xff);
+  if (type == 0x0 || type == 0x7) return RemoteResult::kDeleted;  // kTypeDeletion, kTypeSingleDeletion
+  if (type != 0x1) return RemoteResult::kUnsupported;             // only kTypeValue entries are written here
+  const char* vp = static_cast<const char*>(found) + sizeof(void*) + hdr + ik.size();
+  unsigned char lenb[5];
+  a.read(vp, lenb, 5);
+  uint32_t vlen;
+  size_t vh = detail::varint32(lenb, 5, &vlen);
+  if (!vh) return RemoteResult::kUnsupported;
+  value->resize(vlen);
+  if (vlen) a.read(vp + vh, &(*value)[0], vlen);
+  return RemoteResult::kFound;
+}
+
+}  // namespace cxl
+}  // namespace ROCKSDB_NAMESPACE

