+// ---- write sections (coherence backends; DESIGN.md §7) ----
+// When set, every store RocksDB makes into a shared memtable object (new entry, its links, a predecessor's link,
+// the skiplist head) is bracketed by write_begin(addr) / write_end(token) of the object holding addr. write_begin
+// returns nullptr for memory outside the shared pools (no section). Sections never nest: each scope covers one
+// object and ends before the next one starts. Owner-private scratch in the arena (the skiplist Splice) and reads by
+// the owner node take no section (single writer, HW coherent within a node; recorded deviation).
+struct Sections {
+  void* (*write_begin)(const void* addr) = nullptr;
+  void (*write_end)(void* token) = nullptr;
+};
+inline Sections& GetSections() {
+  static Sections s;
+  return s;
+}
+class WriteScope {
+ public:
+  explicit WriteScope(const void* addr) {
+    const Sections& s = GetSections();
+    if (s.write_begin) token_ = s.write_begin(addr);
+  }
+  ~WriteScope() {
+    if (token_) GetSections().write_end(token_);
+  }
+  WriteScope(const WriteScope&) = delete;
+  WriteScope& operator=(const WriteScope&) = delete;
+
+ private:
+  void* token_ = nullptr;
+};
