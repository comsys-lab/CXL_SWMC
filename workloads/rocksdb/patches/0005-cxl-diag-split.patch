 inline DiagCounters& GetDiagCounters() {
   static DiagCounters c;
   return c;
 }
+// patches/0005: ns the calling thread spent inside the coherence backend's section begin / end calls (the backend adds
+// to it; RocksDB only reads deltas)
+inline uint64_t& DiagSectionNs() {
+  thread_local uint64_t ns = 0;
+  return ns;
+}
+// patches/0005: times a scope into `all` (wall) and `rdb` (wall minus the section time inside it)
+class DiagSplitScope {
+ public:
+  DiagSplitScope(DiagTimer& all, DiagTimer& rdb)
+      : all_(all), rdb_(rdb), t0_(DiagNowNs()), s0_(DiagSectionNs()) {}
+  ~DiagSplitScope() {
+    const uint64_t d = DiagNowNs() - t0_, s = DiagSectionNs() - s0_;
+    all_.Add(d);
+    rdb_.Add(d > s ? d - s : 0);
+  }
+  DiagSplitScope(const DiagSplitScope&) = delete;
+  DiagSplitScope& operator=(const DiagSplitScope&) = delete;
+
+ private:
+  DiagTimer& all_;
+  DiagTimer& rdb_;
+  const uint64_t t0_, s0_;
+};
 
