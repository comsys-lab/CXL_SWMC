diff --git a/third-party/nr_rust/node-replication/src/nr/waitstat.rs b/third-party/nr_rust/node-replication/src/nr/waitstat.rs
new file mode 100644
index 0000000..022b723
--- /dev/null
+++ b/third-party/nr_rust/node-replication/src/nr/waitstat.rs
@@ -0,0 +1,44 @@
+// De Stijl port instrumentation (MOT1 v6, build 71): per-thread contended-wait accounting for the read side of NR.
+// Observation only; no behaviour change. Recorded episodes (each counted once, duration in TSC cycles, plain rdtsc
+// without fences):
+//   - a read-side sync loop (Replica::execute / execute_anchor / sync_combine) that found the combiner lock held by
+//     another thread: from the first failed acquisition until this thread acquires the lock or the replica is synced;
+//   - RwLock::read while a writer (combiner replay) holds the write lock: from the first observation until the read
+//     lock is held.
+// The C++ side (src/common/coh_stats.h) reads the calling thread's totals through nr_thread_wait_stat() and
+// attributes deltas to the object read sections.
+
+use core::sync::atomic::{AtomicBool, Ordering};
+
+/// Totals of the calling thread: [episodes, cycles].
+#[thread_local]
+static mut WAIT: [u64; 2] = [0, 0];
+
+/// Timers on (default) or off (MEGALON_COH_TIMERS=0): off keeps the counts, durations stay 0.
+pub static TIMERS: AtomicBool = AtomicBool::new(true);
+
+#[inline(always)]
+pub fn now() -> u64 {
+    if TIMERS.load(Ordering::Relaxed) {
+        unsafe { core::arch::x86_64::_rdtsc() }
+    } else {
+        0
+    }
+}
+
+/// Ends an episode that started at `t0` (a value of `now()`).
+#[cold]
+#[inline(never)]
+pub fn add(t0: u64) {
+    let t1 = now();
+    unsafe {
+        let w = &mut *core::ptr::addr_of_mut!(WAIT);
+        w[0] += 1;
+        w[1] += t1.wrapping_sub(t0);
+    }
+}
+
+/// Address of the calling thread's [episodes, cycles]; stable for the thread's lifetime.
+pub fn thread_ptr() -> *const u64 {
+    unsafe { core::ptr::addr_of!(WAIT) as *const u64 }
+}
