+/* Build 71 instrumentation (MOT1 v6 Fig 2/3a; observation only). Coherence time of the CALLING thread since its
+ * Register(): durations in ns (plain rdtsc without fences, converted with the TSC rate), counts in events. Field order
+ * = mshim::CohSnap (systems/megalon/shim/megalon_objapi.h, contract v2). Intervals (exact definitions:
+ * reports/M2-megalon-port-changes.md §13):
+ *   read_sections / write_sections    ObjectReadStart / ObjectWriteStart calls that returned 0 (this thread)
+ *   check_*        read sections only, 1 in check_sample per thread (the 1st, N+1th, ...): ReadStart entry .. return
+ *                  plus, if ReadEnd returns true, ReadEnd entry .. return; minus the (A) and (D) time inside them.
+ *                  check_sampled = sampled sections; estimate of all sections = check_ns_sampled * check_sample
+ *   stale (A)      read_start found a stale copy: from read_seq_start's PAGE_INCOHERENT until the restarted attempt
+ *                  succeeded (whole-object flush + the restart: GetAnchor, read_seq_start), minus (D) inside it
+ *   concur (B)     ReadEnd returned false on PAGE_INCOHERENT: ReadStart return .. ReadEnd return (the discarded
+ *                  section body, read_end's checks, the whole-object flush), minus (D) inside read_end
+ *   meta (C)       ReadEnd returned false on META_OUTDATE: ReadStart return .. ReadEnd return, minus (D)
+ *   spin (D)       contended waits inside ObjectReadStart/ObjectReadEnd: read_seqlock_begin while the version is
+ *                  odd (a writer holds it), NR combiner-lock waits in the read-side sync loops, NR replica RwLock
+ *                  read waits; one count per episode. Never overlaps check/stale/concur/meta
+ *   wstart         ObjectWriteStart entry .. return, everything (GetAnchor, switch_rw incl. reclaim, retries,
+ *                  write_seq_start, NR waits); switch_rw (each SwitchRW call) and reclaim (each critical-path
+ *                  reclaim attempt inside it) are sub-intervals of wstart
+ *   wflush         ObjectWriteEnd entry .. return (whole-object clflushopt + fence, write_seq_end); wflush_bytes =
+ *                  bytes flushed (0 in the hwcc flavor: no flush) */
+struct ObjectThreadCoh {
+    uint64_t read_sections, write_sections;
+    uint64_t check_sample, check_ns_sampled, check_sampled;
+    uint64_t stale_cnt, stale_ns;
+    uint64_t concur_cnt, concur_ns;
+    uint64_t meta_cnt, meta_ns;
+    uint64_t spin_cnt, spin_ns;
