+
+/// Build 71 instrumentation: a read that waits for a writer of the replica's RwLock records exactly one wait episode
+/// with a non-zero duration; an uncontended read records none.
+#[test]
+fn waitstat_records_contended_read_lock_only() {
+    use node_replication::nr::rwlock::RwLock;
+    use node_replication::nr::waitstat;
+    let ws = || unsafe {
+        let p = waitstat::thread_ptr();
+        (*p, *p.add(1))
+    };
+    let lock = Arc::new(RwLock::<usize>::default());
+    let (c0, _) = ws();
+    drop(lock.read(0));
+    assert_eq!(ws().0, c0, "uncontended read must not record a wait");
+    let held = Arc::new(AtomicBool::new(false));
+    let (l2, h2) = (lock.clone(), held.clone());
+    let w = std::thread::spawn(move || {
+        let g = l2.write(1);
+        h2.store(true, Ordering::SeqCst);
+        std::thread::sleep(std::time::Duration::from_millis(20));
+        drop(g);
+    });
+    while !held.load(Ordering::SeqCst) {}
+    let (c1, y1) = ws();
+    drop(lock.read(0));
+    let (c2, y2) = ws();
+    w.join().unwrap();
+    assert_eq!(c2 - c1, 1, "one wait episode");
+    assert!(y2 - y1 > 1_000_000, "waited ~20 ms, got {} cycles", y2 - y1);
+}
