new file mode 100644
index 0000000..00d7f64
--- /dev/null
+++ b/src/common/coh_stats.cc
@@ -0,0 +1,69 @@
+#include "coh_stats.h"
+
+#include <time.h>
+
+#include <atomic>
+#include <cstdlib>
+#include <cstring>
+
+#include "index/nr_hashmap.h"
+
+namespace rackobj::coh {
+
+Config g_cfg;
+thread_local Tls tls;
+
+namespace {
+
+uint64_t MonoNs() {
+    timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull + static_cast<uint64_t>(ts.tv_nsec);
+}
+
+uint64_t load_tsc, load_ns;
+std::atomic<double> cached_hz{0.0};
+
+__attribute__((constructor)) void Init() {
+    if (const char *v = std::getenv("MEGALON_COH_TIMERS")) g_cfg.timers = std::strcmp(v, "0") != 0;
+    if (const char *v = std::getenv("MEGALON_COH_CHECK_SAMPLE")) {
+        long n = std::strtol(v, nullptr, 10);
+        g_cfg.check_sample = n >= 1 ? static_cast<uint64_t>(n) : 64;
+    }
+    NrFfi::nr_coh_set_timers(g_cfg.timers);
+    load_ns = MonoNs();
+    load_tsc = __rdtsc();
+}
+
+}  // namespace
+
+const uint64_t *NrPtr() {
+    if (!tls.nr) tls.nr = NrFfi::nr_thread_wait_stat();
+    return tls.nr;
+}
+
+void ResetThread() {
+    Tls &t = tls;
+    const uint64_t rs_cnt = t.rseq_spin_cnt, rs_cyc = t.rseq_spin_cyc, rc_cnt = t.reclaim_cnt, rc_cyc = t.reclaim_cyc;
+    std::memset(static_cast<void *>(&t), 0, sizeof(t));
+    t.rseq_spin_cnt = rs_cnt;
+    t.rseq_spin_cyc = rs_cyc;
+    t.reclaim_cnt = rc_cnt;
+    t.reclaim_cyc = rc_cyc;
+    t.nr = NrFfi::nr_thread_wait_stat();
+}
+
+double TscHz() {
+    double hz = cached_hz.load(std::memory_order_relaxed);
+    if (hz > 0) return hz;
+    uint64_t ns = MonoNs(), tsc = __rdtsc();
+    while (ns - load_ns < 20000000ull) {  // at least 20 ms of reference interval
+        ns = MonoNs();
+        tsc = __rdtsc();
+    }
+    hz = static_cast<double>(tsc - load_tsc) * 1e9 / static_cast<double>(ns - load_ns);
+    if (ns - load_ns >= 200000000ull) cached_hz.store(hz, std::memory_order_relaxed);
+    return hz;
+}
+
+}  // namespace rackobj::coh
diff --git a/src/common/coh_stats.h b/src/common/coh_stats.h
new file mode 100644
index 0000000..213a354
--- /dev/null
+++ b/src/common/coh_stats.h
@@ -0,0 +1,65 @@
+// De Stijl port instrumentation (MOT1 v6 Fig 2/3a, build 71): per-thread coherence time of the object API.
+// Observation only: no protocol change. Semantics of every field: rackobj.h ObjectThreadCoh and
+// reports/M2-megalon-port-changes.md §13 (De Stijl control repo).
+//
+// Timers: plain rdtsc without fences (accumulated in TSC cycles, converted to ns with the TSC rate when read).
+// Environment (read once at load):
+//   MEGALON_COH_TIMERS=0          no rdtsc at all (counts kept, durations 0); default 1
+//   MEGALON_COH_CHECK_SAMPLE=N    section checks timed in 1 of N read sections per thread; default 64, >= 1
+#pragma once
+
+#include <x86intrin.h>
+
+#include <cstdint>
+
+namespace rackobj::coh {
+
+struct Config {
+    bool timers = true;
+    uint64_t check_sample = 64;
+};
+extern Config g_cfg;
+
+inline uint64_t Now() { return g_cfg.timers ? __rdtsc() : 0; }
+
+// Thread-local accumulators, zero-initialised (no TLS constructor). Raw totals (any caller) and the object-API
+// attribution (CohSnap fields, in cycles).
+struct Tls {
+    // raw, recorded at the spin/reclaim sites for any caller (slot or object path)
+    uint64_t rseq_spin_cnt, rseq_spin_cyc;  // read_seqlock_begin while the sequence is odd (contended only)
+    uint64_t reclaim_cnt, reclaim_cyc;      // SwitchRW critical-path reclaim attempts (SampleVictim .. FinishReclaim)
+    const uint64_t *nr;                     // NR read-side wait totals [episodes, cycles] (nr_thread_wait_stat)
+    // object API attribution since Register()
+    uint64_t read_sections, write_sections;
+    uint64_t check_cyc, check_sampled;
+    uint64_t stale_cnt, stale_cyc;
+    uint64_t concur_cnt, concur_cyc;
+    uint64_t meta_cnt, meta_cyc;
+    uint64_t spin_cnt, spin_cyc;
+    uint64_t wstart_cyc, switch_rw_cnt, switch_rw_cyc, reclaim_obj_cnt, reclaim_obj_cyc;
+    uint64_t wflush_cnt, wflush_cyc, wflush_bytes;
+    // open read section
+    uint64_t sample_left;  // read sections until the next sampled one (0: the next one is sampled)
+    uint64_t sec_ret;      // Now() at ReadStart return
+    uint64_t sec_sp0_cnt, sec_sp0_cyc, sec_sp1_cyc;  // SpinNow at ReadStart entry (cnt, cyc) and return (cyc)
+    bool sec_sampled;      // this section's checks are timed
+};
+extern thread_local Tls tls;
+
+// Contended-wait totals of the calling thread (read_seqlock_begin spin + NR read-side waits).
+struct Spin {
+    uint64_t cnt, cyc;
+};
+const uint64_t *NrPtr();
+inline Spin SpinNow(Tls &t) {
+    const uint64_t *nr = t.nr ? t.nr : NrPtr();
+    return Spin{t.rseq_spin_cnt + nr[0], t.rseq_spin_cyc + nr[1]};
+}
+
+// Called at Register(): zero the attribution (the raw totals are monotonic) and bind the NR pointer.
+void ResetThread();
+
+// TSC rate (Hz), measured against CLOCK_MONOTONIC from library load to the first call that is >= 200 ms later.
+double TscHz();
+
