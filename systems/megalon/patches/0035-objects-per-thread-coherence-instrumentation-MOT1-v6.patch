+// ---- phase 7 (build 71): per-thread coherence counters (rackobj::GetObjectThreadCoh) move in constructed cases ----
+constexpr uint64_t kCohA = kBase + 6;  // node 0 creates; node 1 sees a stale copy after node 0's write
+uint64_t CohX(size_t n) { return kBase + 30 + n; }   // RW object of node n (concurrent write, writer spin)
+uint64_t CohRO(size_t n) { return kBase + 40 + n; }  // RO object of node n until the helper's first write (meta)
+uint64_t CohOv(size_t n) { return kBase + 50 + n; }  // 64 B object of node n (overhead loop)
+constexpr size_t kCohLen = 4096 * 4;
+
+rackobj::ObjectThreadCoh Coh() {
+    rackobj::ObjectThreadCoh c{};
+    rackobj::GetObjectThreadCoh(&c);
+    return c;
+}
+
+// b - a, field by field (all fields are monotonic per thread)
+rackobj::ObjectThreadCoh CohDiff(const rackobj::ObjectThreadCoh &a, const rackobj::ObjectThreadCoh &b) {
+    rackobj::ObjectThreadCoh d = b;
+    const uint64_t *pa = reinterpret_cast<const uint64_t *>(&a);
+    uint64_t *pd = reinterpret_cast<uint64_t *>(&d);
+    for (size_t i = 0; i < offsetof(rackobj::ObjectThreadCoh, reserved) / 8; i++) pd[i] -= pa[i];
+    d.check_sample = b.check_sample;
+    return d;
+}
+
+std::string CohStr(const rackobj::ObjectThreadCoh &c) {
+    char b[768];
+    std::snprintf(b, sizeof(b),
+                  "rs=%lu ws=%lu check(sample 1/%lu)=%lu ns over %lu | stale %lu/%lu ns | concur %lu/%lu ns | meta %lu/%lu "
+                  "ns | spin %lu/%lu ns | wstart %lu ns, switch_rw %lu/%lu ns, reclaim %lu/%lu ns | wflush %lu/%lu ns/%lu B "
+                  "| tsc %lu kHz timers %lu",
+                  c.read_sections, c.write_sections, c.check_sample, c.check_ns_sampled, c.check_sampled, c.stale_cnt,
+                  c.stale_ns, c.concur_cnt, c.concur_ns, c.meta_cnt, c.meta_ns, c.spin_cnt, c.spin_ns, c.wstart_ns,
+                  c.switch_rw_cnt, c.switch_rw_ns, c.reclaim_cnt, c.reclaim_ns, c.wflush_cnt, c.wflush_ns,
+                  c.wflush_bytes, c.reserved[0], c.reserved[1]);
+    return b;
+}
+
+// A second registered thread of this node (one open section per thread: the helper is the second party). Registered
+// once: NR registrations are never freed (<= 32 per node).
+class HelperThread {
+public:
+    explicit HelperThread(int tid) : t_([this, tid] { Loop(tid); }) {}
+    ~HelperThread() {
+        {
+            std::lock_guard<std::mutex> l(m_);
+            stop_ = true;
+        }
+        cv_.notify_all();
+        t_.join();
+    }
+    void Start(std::function<void()> f) {
+        std::lock_guard<std::mutex> l(m_);
+        job_ = std::move(f);
+        done_ = false;
+        cv_.notify_all();
+    }
+    void Wait() {
+        std::unique_lock<std::mutex> l(m_);
+        cv_.wait(l, [&] { return done_; });
+    }
+    void Run(std::function<void()> f) {
+        Start(std::move(f));
+        Wait();
+    }
+
+private:
+    void Loop(int tid) {
+        rackobj::Register(tid);
+        for (;;) {
+            std::function<void()> f;
+            {
+                std::unique_lock<std::mutex> l(m_);
+                cv_.wait(l, [&] { return job_ || stop_; });
+                if (!job_) break;
+                f = std::move(job_);
+                job_ = nullptr;
+            }
+            f();
+            {
+                std::lock_guard<std::mutex> l(m_);
+                done_ = true;
+            }
+            cv_.notify_all();
+        }
+        rackobj::UnRegister();
+    }
+    std::mutex m_;
+    std::condition_variable cv_;
+    std::function<void()> job_;
+    bool done_ = true, stop_ = false;
+    std::thread t_;
+};
+
+void CohPhase(int helper_tid) {
+    HelperThread helper(helper_tid);
+    rackobj::ObjectStats os{};
+    rackobj::GetObjectStats(&os);
+    const bool hwcc = os.static_records_used > 0;  // hwcc flavor: static records (objects RW at create), no stale/RO
+    const bool timed = Coh().reserved[1] == 1;
+    auto tpos = [&](uint64_t ns) { return !timed || ns > 0; };  // durations are 0 with MEGALON_COH_TIMERS=0
+    EXPECT(rackobj::ObjectCreate(CohX(node_id), kConcLen) == 0);
+    EXPECT(rackobj::ObjectCreate(CohRO(node_id), 4096) == 0);
+    WriteGen(CohX(node_id), 1);
+    if (node_id == 0) {
+        EXPECT(rackobj::ObjectCreate(kCohA, kCohLen) == 0);
+        WriteGen(kCohA, 1);
+    }
+    Barrier("coh created");
+    rackobj::ObjectHandle h;
+    auto read_gen = [&](uint64_t id) {
+        uint64_t g;
+        do {
+            CHECK_EQ(rackobj::ObjectReadStart(id, &h), 0);
+            g = InspectGen(h.ptr, h.size, id);
+        } while (!rackobj::ObjectReadEnd(&h));
+        return g;
+    };
+    // (A) stale copy at read_start: node 1 validates kCohA, node 0 rewrites it, node 1 reads again
+    if (node_id == 1) EXPECT(read_gen(kCohA) == 1);
+    Barrier("coh A validated");
+    if (node_id == 0) {
+        auto c0 = Coh();
+        WriteGen(kCohA, 2);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH flush (node 0 write of kCohA): " << CohStr(d);
+        EXPECT(d.write_sections == 1 && d.wflush_cnt == 1);
+        EXPECT(d.wflush_bytes == kCohLen || d.wflush_bytes == 0);  // 0 only in the hwcc flavor (no flush)
+        EXPECT(tpos(d.wflush_ns) && tpos(d.wstart_ns));
+        EXPECT(d.read_sections == 0 && d.stale_cnt == 0 && d.concur_cnt == 0 && d.meta_cnt == 0);
+    }
+    Barrier("coh A rewritten");
+    if (node_id == 1) {
+        auto c0 = Coh();
+        EXPECT(read_gen(kCohA) == 2);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH stale (node 1 read of kCohA after node 0's write): " << CohStr(d);
+        EXPECT(hwcc || (d.stale_cnt == 1 && tpos(d.stale_ns)));
+        EXPECT(d.read_sections == 1 && d.concur_cnt == 0 && d.meta_cnt == 0);
+    }
+    Barrier("coh A checked");
+
+    // (B) concurrent write between read_start and read_end (same node, helper thread writes)
+    {
+        auto c0 = Coh();
+        CHECK_EQ(rackobj::ObjectReadStart(CohX(node_id), &h), 0);
+        helper.Run([] { WriteGen(CohX(node_id), 3); });
+        const bool ok = rackobj::ObjectReadEnd(&h);
+        EXPECT(!ok);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH concurrent (read of C(own) while the helper wrote it): " << CohStr(d);
+        EXPECT(d.concur_cnt == 1 && tpos(d.concur_ns) && d.meta_cnt == 0 && d.stale_cnt == 0);
+        EXPECT(read_gen(CohX(node_id)) == 3);
+    }
+    // (C) metadata notification: reading an RO object while the helper's write switches it RO -> RW (log event)
+    {
+        auto c0 = Coh();
+        rackobj::ObjectThreadCoh hd{};
+        CHECK_EQ(rackobj::ObjectReadStart(CohRO(node_id), &h), 0);
+        helper.Run([&hd] {
+            auto a = Coh();
+            WriteGen(CohRO(node_id), 1);
+            hd = CohDiff(a, Coh());
+        });
+        const bool ok = rackobj::ObjectReadEnd(&h);
+        EXPECT(!ok);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH meta (read of RO(own) while the helper switched it RO->RW): " << CohStr(d);
+        LOG(INFO) << "COH switch_rw (helper write of RO(own)): " << CohStr(hd);
+        if (!hwcc) {
+            EXPECT(d.meta_cnt == 1 && tpos(d.meta_ns) && d.concur_cnt == 0);
+            EXPECT(hd.switch_rw_cnt >= 1 && tpos(hd.switch_rw_ns) && hd.wstart_ns >= hd.switch_rw_ns);
+        }
+        EXPECT(hd.reclaim_ns <= hd.switch_rw_ns && hd.wflush_cnt == 1 && hd.write_sections == 1);
+    }
+    // (D) contended spin: the helper holds a write section on C(own) for 20 ms while this thread starts a read
+    {
+        std::atomic<int> st{0};
+        auto c0 = Coh();
+        helper.Start([&st] {
+            rackobj::ObjectHandle wh;
+            CHECK_EQ(rackobj::ObjectWriteStart(CohX(node_id), &wh), 0);
+            st.store(1);
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+            auto *p = reinterpret_cast<uint64_t *>(wh.ptr);
+            for (size_t i = 2; i < wh.size / 8; i++) p[i] = ConcWord(CohX(node_id), 5, i);
+            p[1] = node_id;
+            p[0] = 5;
+            rackobj::ObjectWriteEnd(&wh);
+        });
+        while (st.load() == 0) {
+        }
+        const uint64_t g = read_gen(CohX(node_id));
+        helper.Wait();
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH spin (read of C(own) while the helper held its write section 20 ms): " << CohStr(d);
+        EXPECT(g == 5);
+        EXPECT(d.spin_cnt >= 1 && (!timed || d.spin_ns >= 5000000));
+        EXPECT(d.check_ns_sampled < 5000000);  // the spin is not counted as section-check time
+    }
+    // section checks: 1 in check_sample read sections per thread is timed
+    {
+        auto c0 = Coh();
+        const uint64_t n = 4 * c0.check_sample;
+        for (uint64_t i = 0; i < n; i++) (void)read_gen(CohX(node_id));
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "COH checks (" << n << " uncontended read sections): " << CohStr(d);
+        EXPECT(d.read_sections == n && d.check_sampled == 4 && tpos(d.check_ns_sampled));
+        EXPECT(d.stale_cnt == 0 && d.concur_cnt == 0 && d.meta_cnt == 0);
+    }
+    Barrier("coh checked");
+}
+
+// Optional (OBJECT_TEST_OVERHEAD=<sections>, node 0 only, node 1 waits): ns per read / write section of a 64 B object
+// (one thread, no contention), timers on and off alternating in one process (rackobj::SetCohTimersForMeasurement).
+void OverheadPhase(uint64_t n) {
+    if (node_id == 0) {
+        const bool initial = rackobj::CohTimersOn();
+        EXPECT(rackobj::ObjectCreate(CohOv(0), 64) == 0);
+        WriteGen(CohOv(0), 1);
+        rackobj::ObjectHandle h;
+        for (int rep = 0; rep < 10; rep++) {
+            const bool on = rep % 2 == 0;
+            rackobj::SetCohTimersForMeasurement(on);
+            auto t0 = std::chrono::steady_clock::now();
+            uint64_t sink = 0;
+            for (uint64_t i = 0; i < n; i++) {
+                do {
+                    CHECK_EQ(rackobj::ObjectReadStart(CohOv(0), &h), 0);
+                    sink += h.ptr[0];
+                } while (!rackobj::ObjectReadEnd(&h));
+            }
+            auto t1 = std::chrono::steady_clock::now();
+            for (uint64_t i = 0; i < n; i++) {
+                CHECK_EQ(rackobj::ObjectWriteStart(CohOv(0), &h), 0);
+                reinterpret_cast<uint64_t *>(h.ptr)[0] = i;
+                rackobj::ObjectWriteEnd(&h);
+            }
+            auto t2 = std::chrono::steady_clock::now();
+            auto ns = [](auto a, auto b) { return std::chrono::duration<double, std::nano>(b - a).count(); };
+            LOG(INFO) << "COH-OVERHEAD rep " << rep << " timers " << on << " sample 1/" << Coh().check_sample
+                      << ": read section " << ns(t0, t1) / static_cast<double>(n) << " ns, write section "
+                      << ns(t1, t2) / static_cast<double>(n) << " ns (" << n << " each, sink " << (sink & 1) << ")";
+        }
+        rackobj::SetCohTimersForMeasurement(initial);
+    }
+    Barrier("overhead done");
+}
+
