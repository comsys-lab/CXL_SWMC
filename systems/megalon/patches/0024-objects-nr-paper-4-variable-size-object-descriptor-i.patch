--- a/third-party/nr_rust/ffi/types.rs
+++ b/third-party/nr_rust/ffi/types.rs
@@ -68,6 +68,44 @@ pub fn init_empty_gcd_entry_with_wmeta_idx(wmeta_idx: isize) -> GCDEntry {
     }
 }
 
+// De Stijl port, phase B: variable-size objects as the paper proposes (§4: "keeping the object size as a field in
+// the logically shared metadata", size fixed at create). One object = one index entry = one coherence record
+// (dynamic: none while read-shared). The descriptor lives in the object's own entry of the replicated map, so it
+// reaches every node only through the NR log, like a slot's cn index. Encoding in the fixed GCDEntry ABI
+// (lib/object_store.h mirrors it):
+//   cn_array_[0] = (OBJ_CN_FLAG | base offset / OBJ_GRANULE, false)
+//       the object's location in LNR: byte offset from the replica's flush base (the slot data base, `base_addr`),
+//       in 64 B units. It is the object's "cn index": unique per object (objects never overlap) and disjoint from
+//       slot indexes (bit 62), so change notifications of objects and slots never alias.
+//   cn_array_[1] = (size in bytes, invalidate_ = true)
+//       invalidate_ is set so that no "local copy on logical node 0" check can ever treat the size as a copy.
+//   wmeta_idx_    = the coherence record, as for slots (-1: read-shared).
+// Replaying any response that carries such an entry flushes [base, base + size) (IdxGetter::obj_span), where a
+// slot response flushes its slot.
+pub const OBJ_CN_FLAG: isize = 1 << 62;
+pub const OBJ_GRANULE: usize = 64;
+const _: () = assert!(LOGICAL_NODE_NUM >= 1, "object encoding needs cn_array_[1]");
+
+pub fn obj_entry(off_units: isize, size: isize, wmeta_idx: isize) -> GCDEntry {
+    assert!(off_units >= 0 && off_units < OBJ_CN_FLAG && size > 0);
+    let mut e = init_empty_gcd_entry();
+    e.wmeta_idx_ = wmeta_idx;
+    e.cn_array_[0] = CNStatus { cn_idx_: OBJ_CN_FLAG | off_units, invalidate_: false };
+    e.cn_array_[1] = CNStatus { cn_idx_: size, invalidate_: true };
+    e
+}
+
+/// (byte offset from the flush base, size) if `e` is an object entry.
+pub fn obj_decode(e: &GCDEntry) -> Option<(usize, usize)> {
+    let cn = e.cn_array_[0].cn_idx_;
+    if cn < 0 || cn & OBJ_CN_FLAG == 0 {
+        return None;
+    }
+    let size = e.cn_array_[1].cn_idx_;
+    assert!(size > 0, "object entry without a size");
+    Some(((cn & !OBJ_CN_FLAG) as usize * OBJ_GRANULE, size as usize))
+}
+
 // BlockId definition that toggles based on KEY_SIZE constant
 // When KEY_SIZE == 24: matches blockid_file.h (server_id, inode, offset)
 // When KEY_SIZE != 24: matches blockid_variable.h (offset + padding)
@@ -196,6 +234,10 @@ impl IdxGetter for GCDReponse {
     fn cn_idx(&self) -> isize {
         self.value.cn_array_[0].cn_idx_
     }
+
+    fn obj_span(&self) -> Option<(usize, usize)> {
+        obj_decode(&self.value)
+    }
 }
 
 // OptionGCDReponse struct
@@ -220,6 +262,10 @@ impl IdxGetter for OptionGCDReponse {
     fn cn_idx(&self) -> isize {
         self.as_ref().map_or(-1, |r| r.cn_idx())
     }
+
+    fn obj_span(&self) -> Option<(usize, usize)> {
+        self.as_ref().and_then(|r| r.obj_span())
+    }
 }
 
 // Debug function for GCDEntry initialization
