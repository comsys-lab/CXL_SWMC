+/// De Stijl port (paper §4 variable-size objects): replay flushes of objects issued by another node, per process
+/// (cost counters; slots are not counted).
+static OBJ_REPLAY_FLUSHES: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+static OBJ_REPLAY_FLUSH_BYTES: core::sync::atomic::AtomicUsize = core::sync::atomic::AtomicUsize::new(0);
+
+/// (count, bytes) of object replay flushes in this process (0 without the `scr`/`no-coherence` features).
+pub fn obj_replay_flush_stats() -> (usize, usize) {
+    (OBJ_REPLAY_FLUSHES.load(Ordering::Relaxed), OBJ_REPLAY_FLUSH_BYTES.load(Ordering::Relaxed))
+}
+
 #[cfg(any(feature = "scr", feature = "no-coherence"))]
 fn flush_mem_region(ptr: *const u8, size: usize) {
     const CACHE_LINE_SIZE: usize = 64;
@@ -1158,8 +1168,17 @@ where
         if !mine {
             #[cfg(any(feature = "scr", feature = "no-coherence"))]
             {
-                let region_ptr = unsafe { self.base_addr.add(idx as usize * self.slot_size) };
-                flush_mem_region(region_ptr, self.slot_size);
+                // De Stijl port (paper §4): a variable-size object is flushed over its whole byte range, exactly
+                // where upstream flushes a slot; slots keep upstream's range.
+                if let Some((off, len)) = resp.obj_span() {
+                    let region_ptr = unsafe { self.base_addr.add(off) };
+                    flush_mem_region(region_ptr, len);
+                    OBJ_REPLAY_FLUSHES.fetch_add(1, Ordering::Relaxed);
+                    OBJ_REPLAY_FLUSH_BYTES.fetch_add(len, Ordering::Relaxed);
+                } else {
+                    let region_ptr = unsafe { self.base_addr.add(idx as usize * self.slot_size) };
+                    flush_mem_region(region_ptr, self.slot_size);
+                }
             }
         }
     }
