+// ---- phase 8 (build 73): KV Get/Put (the paper's key-value API) in the same per-thread counters ----
+constexpr size_t kKvLen = 1024;  // <= SLOT_SIZE of every KEY_SIZE build
+off_t KvKey(size_t n, size_t i) { return static_cast<off_t>(600000 + n * 100000 + i); }
+
+void KvPut(off_t key, uint64_t gen) {
+    uint64_t w[kKvLen / 8];
+    for (size_t i = 0; i < kKvLen / 8; i++) w[i] = mix64(static_cast<uint64_t>(key) ^ (gen << 20) ^ (i << 44));
+    w[0] = gen;
+    (void)rackobj::Put(reinterpret_cast<const uint8_t *>(w), kKvLen, key);
+}
+
+// generation of the value, 0 if torn, ~0 if the key is missing
+uint64_t KvGetGen(off_t key) {
+    uint64_t w[kKvLen / 8];
+    if (rackobj::Get(reinterpret_cast<uint8_t *>(w), kKvLen, key) <= 0) return ~0ull;
+    for (size_t i = 1; i < kKvLen / 8; i++)
+        if (w[i] != mix64(static_cast<uint64_t>(key) ^ (w[0] << 20) ^ (i << 44))) return 0;
+    return w[0];
+}
+
+void KvCohPhase(HelperThread &helper, bool churn) {
+    rackobj::ObjectStats os{};
+    rackobj::GetObjectStats(&os);
+    const bool hwcc = os.static_records_used > 0;
+    const bool timed = Coh().reserved[1] == 1;
+    auto tpos = [&](uint64_t ns) { return !timed || ns > 0; };
+    const off_t own = KvKey(node_id, 0);
+    {  // create (admit) and update: write sections, wflush bytes = value size
+        auto c0 = Coh();
+        KvPut(own, 1);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "KVCOH create (Put of a new key): " << CohStr(d) << " | admit " << d.reserved[3] << "/"
+                  << d.reserved[4] << " ns, kv " << d.reserved[5] << "/" << d.reserved[6];
+        EXPECT(d.write_sections == 1 && d.reserved[6] == 1 && d.reserved[3] == 1 && tpos(d.reserved[4]));
+        EXPECT(d.wflush_cnt == 1 && (d.wflush_bytes == kKvLen || hwcc) && tpos(d.wstart_ns));
+        EXPECT(d.reserved[4] <= d.wstart_ns && d.read_sections == 0);
+        c0 = Coh();
+        KvPut(own, 2);
+        d = CohDiff(c0, Coh());
+        LOG(INFO) << "KVCOH update (Put of an existing key): " << CohStr(d) << " | admit " << d.reserved[3];
+        EXPECT(d.write_sections == 1 && d.reserved[3] == 0 && d.wflush_cnt == 1);
+        EXPECT((d.wflush_bytes == kKvLen || hwcc) && tpos(d.wflush_ns) && tpos(d.wstart_ns));
+    }
+    if (node_id == 0) KvPut(KvKey(0, 1), 1);
+    Barrier("kv created");
+    // (A) stale copy: node 1 validates node 0's key, node 0 rewrites it, node 1 reads again
+    if (node_id == 1) EXPECT(KvGetGen(KvKey(0, 1)) == 1);
+    Barrier("kv A validated");
+    if (node_id == 0) KvPut(KvKey(0, 1), 2);
+    Barrier("kv A rewritten");
+    if (node_id == 1) {
+        auto c0 = Coh();
+        EXPECT(KvGetGen(KvKey(0, 1)) == 2);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "KVCOH stale (node 1 Get after node 0's Put): " << CohStr(d);
+        EXPECT(hwcc || (d.stale_cnt == 1 && tpos(d.stale_ns)));
+        EXPECT(d.read_sections == 1 && d.reserved[5] == 1 && d.concur_cnt == 0 && d.meta_cnt == 0);
+    }
+    Barrier("kv A checked");
+    // (B) concurrent write and (D) writer spin: the helper rewrites the own key in a loop while this thread reads it
+    {
+        std::atomic<bool> stop{false};
+        helper.Start([&stop, own] {
+            for (uint64_t g = 3; !stop.load(std::memory_order_relaxed); g++) KvPut(own, g);
+        });
+        auto c0 = Coh();
+        rackobj::ObjectThreadCoh d{};
+        uint64_t gets = 0, torn = 0;
+        const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        while (std::chrono::steady_clock::now() < until) {
+            for (int i = 0; i < 1000; i++, gets++) torn += KvGetGen(own) == 0;
+            d = CohDiff(c0, Coh());
+            if (d.concur_cnt >= 1 && d.spin_cnt >= 1) break;
+        }
+        stop.store(true);
+        helper.Wait();
+        LOG(INFO) << "KVCOH concurrent+spin (" << gets << " Gets while the helper rewrote the key): " << CohStr(d);
+        EXPECT(torn == 0 && d.read_sections == gets);
+        EXPECT(hwcc || (d.concur_cnt >= 1 && tpos(d.concur_ns)));
+        EXPECT(d.spin_cnt >= 1 && tpos(d.spin_ns));
+    }
+    {  // section checks: 1 in check_sample Gets is timed
+        auto c0 = Coh();
+        const uint64_t n = 4 * c0.check_sample;
+        for (uint64_t i = 0; i < n; i++) (void)KvGetGen(own);
+        auto d = CohDiff(c0, Coh());
+        LOG(INFO) << "KVCOH checks (" << n << " uncontended Gets): " << CohStr(d);
+        EXPECT(d.read_sections == n && d.reserved[5] == n && d.check_sampled == 4 && tpos(d.check_ns_sampled));
+        EXPECT(d.stale_cnt == 0 && d.concur_cnt == 0 && d.meta_cnt == 0);
+    }
+    Barrier("kv checked");
+    if (!churn || hwcc) return;
+    // (C) notification and switch_rw (reclaim config): more keys than records, so the record manager reclaims keys
+    // to RO; the helper rewrites random keys (RO -> RW switches = log events) while this thread reads random keys
+    constexpr size_t kKeys = 2048;
+    for (size_t i = 0; i < kKeys; i++) KvPut(KvKey(node_id, 10 + i), 1);
+    Barrier("kv churn created");
+    {
+        std::atomic<bool> stop{false};
+        rackobj::ObjectThreadCoh hd{};
+        helper.Start([&stop, &hd] {
+            auto a = Coh();
+            std::mt19937_64 rng(77 + node_id);
+            for (uint64_t g = 2; !stop.load(std::memory_order_relaxed); g++)
+                KvPut(KvKey(rng() & 1, 10 + rng() % kKeys), g);
+            hd = CohDiff(a, Coh());
+        });
+        std::mt19937_64 rng(99 + node_id);
+        auto c0 = Coh();
+        rackobj::ObjectThreadCoh d{};
+        uint64_t gets = 0, torn = 0;
+        const auto until = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+        while (std::chrono::steady_clock::now() < until) {
+            for (int i = 0; i < 1000; i++, gets++) torn += KvGetGen(KvKey(rng() & 1, 10 + rng() % kKeys)) == 0;
+            d = CohDiff(c0, Coh());
+            if (d.meta_cnt >= 1) break;
+        }
+        stop.store(true);
+        helper.Wait();
+        LOG(INFO) << "KVCOH meta (" << gets << " random Gets during random Puts, reclaim config): " << CohStr(d);
+        LOG(INFO) << "KVCOH churn writer: " << CohStr(hd) << " | admit " << hd.reserved[3];
+        EXPECT(torn == 0);
+        EXPECT(d.meta_cnt >= 1 && tpos(d.meta_ns));
+        EXPECT(hd.switch_rw_cnt >= 1 && tpos(hd.switch_rw_ns) && hd.switch_rw_ns <= hd.wstart_ns);
+        EXPECT(hd.reclaim_ns <= hd.wstart_ns);
+    }
+    Barrier("kv churn checked");
+}
+
 // Optional (OBJECT_TEST_OVERHEAD=<sections>, node 0 only, node 1 waits): ns per read / write section of a 64 B object
 // (one thread, no contention), timers on and off alternating in one process (rackobj::SetCohTimersForMeasurement).
 void OverheadPhase(uint64_t n) {
@@ -758,7 +887,12 @@ int main(int argc, char **argv) {
     }
 
     // ---- phase 7: per-thread coherence counters (build 71) ----
-    CohPhase(1 + 2 * readers + 2);
+    {
+        HelperThread helper(1 + 2 * readers + 2);  // one registration for phases 7 and 8 (<= 32 per node)
+        CohPhase(helper);
+        // ---- phase 8: KV Get/Put counters (build 73) ----
+        KvCohPhase(helper, churn > 0);
+    }
     if (const char *ov = std::getenv("OBJECT_TEST_OVERHEAD")) OverheadPhase(std::strtoull(ov, nullptr, 10));
 
     rackobj::ObjectStats st{};
