     uint64_t wstart_ns, switch_rw_cnt, switch_rw_ns, reclaim_cnt, reclaim_ns;
     uint64_t wflush_cnt, wflush_ns, wflush_bytes;
     uint64_t reserved[8];  // [0] TSC rate in kHz used for the conversion; [1] timers on (1/0); [2] (build 72)
-                           // negative TSC intervals clamped to 0 in this thread (should stay 0)
