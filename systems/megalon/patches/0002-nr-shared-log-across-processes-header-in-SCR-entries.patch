+/// NR log layout for placing the log in shared memory (De Stijl port).
+#[repr(C)]
+pub struct NrLogLayout {
+    pub header_size: usize,
+    pub header_align: usize,
+    pub entry_size: usize,
+    pub entry_align: usize,
+    pub entries: usize,
+}
+
+#[no_mangle]
+pub extern "C" fn nr_log_layout(log_bytes: usize) -> NrLogLayout {
+    NrLogLayout {
+        header_size: std::mem::size_of::<Log<Modify>>(),
+        header_align: std::mem::align_of::<Log<Modify>>(),
+        entry_size: NR_LOG_ENTRY_SIZE,
+        entry_align: Log::<Modify>::entry_align(),
+        entries: log_entries_for_bytes(log_bytes),
+    }
+}
+
+/// Creates this process's NR instance on a log shared with the other nodes.
+///
+/// `init`: construct the log header (`log_hdr`, HWcc) and its `log_entries`
+/// entries (`log_body`, SWcc) and register all `num_replica` tokens. Otherwise
+/// attach without writing. The local replica is `node_id` (log token
+/// `node_id + 1`). Returns null if the log in memory does not match.
+/// A background thread replays the log on the local replica every
+/// `sync_interval_us` (0 disables it). A remote replica that holds back GC for
+/// longer than `stuck_timeout_ms` aborts the process.
+#[no_mangle]
+pub extern "C" fn create_node_replicated_shared(
+    cap: NonZeroUsize,
+    num_replica: NonZeroUsize,
+    node_id: usize,
+    base_addr: *const u8,
+    slot_size: usize,
+    log_hdr: *mut u8,
+    log_body: *mut u8,
+    log_entries: usize,
+    init: bool,
+    stuck_timeout_ms: u64,
+    sync_interval_us: u64,
+) -> *mut Mutex<NrRapper> {
+    assert!(usize::from(num_replica) == LOGICAL_NODE_NUM);
+    assert!(node_id < LOGICAL_NODE_NUM);
+
+    let log: &'static Log<Modify> = match unsafe {
+        Log::<Modify>::new_in_place(
+            log_hdr as *mut Log<Modify>,
+            log_body,
+            log_entries,
+            usize::from(num_replica),
+            (),
+            init,
+        )
+    } {
+        Ok(l) => l,
+        Err(e) => {
+            eprintln!("megalon-nr: shared log {} failed: {}", if init { "init" } else { "attach" }, e);
+            return std::ptr::null_mut();
+        }
+    };
+
+    let remote_wait = RemoteWait {
+        now_ns: port_now_ns,
+        timeout_ns: stuck_timeout_ms.saturating_mul(1_000_000),
+        on_stuck: port_on_stuck,
+    };
+    let _ = port_now_ns(); // start the clock
+
+    let a = NrHashMapFFi::new(usize::from(cap));
+    let nrht = Arc::new(
+        NodeReplicated::<NrHashMapFFi>::new_shared_node(
+            node_id,
+            num_replica,
+            noop_chg_affinity,
+            a,
+            log,
+            base_addr,
+            slot_size,
+            remote_wait,
+        )
+        .unwrap(),
+    );
+
+    let stop_signal = Arc::new(AtomicBool::new(false));
+    let thread_handle = if sync_interval_us > 0 {
+        let nr = Arc::clone(&nrht);
+        let stop = Arc::clone(&stop_signal);
+        Some(
+            std::thread::Builder::new()
+                .name("nr-log-sync".into())
+                .spawn(move || {
+                    let period = std::time::Duration::from_micros(sync_interval_us);
+                    while !stop.load(Ordering::Acquire) {
+                        nr.log_sync_local();
+                        std::thread::sleep(period);
+                    }
+                })
+                .expect("cannot spawn NR log-sync thread"),
+        )
+    } else {
+        None
+    };
+
+    Box::into_raw(Box::new(Mutex::new(NrRapper {
+        nrht,
+        thread_handle,
+        stop_signal,
+    })))
+}
+
+/// Stops the background log-sync thread (if any); the instance stays usable.
+#[no_mangle]
+pub extern "C" fn stop_log_sync(nrht_wrapper: *mut Mutex<NrRapper>) {
+    if nrht_wrapper.is_null() {
+        return;
+    }
+    unsafe {
+        let mut nrht = (*nrht_wrapper).lock().unwrap();
+        if let Some(handle) = nrht.thread_handle.take() {
+            nrht.stop_signal.store(true, Ordering::SeqCst);
+            handle.join().unwrap();
+        }
+    }
+}
