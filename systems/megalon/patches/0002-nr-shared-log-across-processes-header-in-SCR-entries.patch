+/// Size of one NR log entry (`Entry<Modify>`), recorded in the build manifest
+/// and in the layout hash. Writers/readers flush every line of it [V8].
+pub const NR_LOG_ENTRY_SIZE: usize = Log::<Modify>::entry_size();
+const _: () = assert!(NR_LOG_ENTRY_SIZE % 64 == 0 && NR_LOG_ENTRY_SIZE >= 128);
+
+/// Number of log entries for a log of (about) `bytes` bytes; same rounding as
+/// `Log::new_with_bytes`.
+fn log_entries_for_bytes(bytes: usize) -> usize {
+    let min = 2 * node_replication::nr::log::GC_FROM_HEAD;
+    core::cmp::max(min, bytes / NR_LOG_ENTRY_SIZE).next_power_of_two()
+}
