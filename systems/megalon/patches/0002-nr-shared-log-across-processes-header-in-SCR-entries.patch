+//! Pure-Rust tests for the De Stijl 2-node port of the NR shared log.
+//! Two "nodes" are two NodeReplicated instances in one process that share one
+//! log placed in a heap buffer (standing in for the CXL mapping): node 0
+//! initializes it in place, node 1 attaches. No devdax, no shared memory.
+
+use std::alloc::{alloc_zeroed, Layout};
+use std::num::NonZeroUsize;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::Arc;
+
+use node_replication::nr::{Log, NodeReplicated, RemoteWait};
+
+use super::*;
+
+const SLOTS: usize = 256;
+const SLOT_SIZE: usize = 1024;
+
+struct SharedMem {
+    hdr: *mut u8,
+    body: *mut u8,
+    entries: usize,
+    pages: *mut u8,
+}
+unsafe impl Send for SharedMem {}
+unsafe impl Sync for SharedMem {}
+
+fn shared_mem(entries: usize) -> SharedMem {
+    let l = nr_log_layout(0);
+    assert_eq!(l.entry_size, NR_LOG_ENTRY_SIZE);
+    unsafe {
+        let hdr = alloc_zeroed(Layout::from_size_align(l.header_size, l.header_align).unwrap());
+        let body = alloc_zeroed(Layout::from_size_align(entries * l.entry_size, l.entry_align.max(64)).unwrap());
+        let pages = alloc_zeroed(Layout::from_size_align(SLOTS * SLOT_SIZE, 4096).unwrap());
+        SharedMem { hdr, body, entries, pages }
+    }
+}
+
+fn log_of(m: &SharedMem, init: bool) -> Result<&'static Log<Modify>, &'static str> {
+    unsafe {
+        Log::<Modify>::new_in_place(m.hdr as *mut Log<Modify>, m.body, m.entries, LOGICAL_NODE_NUM, (), init)
+    }
+}
+
+fn test_now_ns() -> u64 {
+    port_now_ns()
+}
+
+fn test_on_stuck(rid: usize, ltail: usize, head: usize, tail: usize, _w: u64) -> ! {
+    panic!("remote replica {} stuck: ltail={} head={} tail={}", rid, ltail, head, tail);
+}
+
+fn node(m: &SharedMem, id: usize, init: bool, timeout_ms: u64) -> Arc<NodeReplicated<NrHashMapFFi>> {
+    let log = log_of(m, init).expect("in-place log");
+    let rw = RemoteWait { now_ns: test_now_ns, timeout_ns: timeout_ms * 1_000_000, on_stuck: test_on_stuck };
+    Arc::new(
+        NodeReplicated::<NrHashMapFFi>::new_shared_node(
+            id,
+            NonZeroUsize::new(LOGICAL_NODE_NUM).unwrap(),
+            noop_chg_affinity,
+            NrHashMapFFi::new(1024),
+            log,
+            m.pages,
+            SLOT_SIZE,
+            rw,
+        )
+        .unwrap(),
+    )
+}
+
+fn key(k: u64) -> BlockId {
+    let mut b = null_BlockId();
+    b.offset_ = k as _;
+    b
+}
+
+fn min_entries() -> usize {
+    2 * node_replication::nr::log::GC_FROM_HEAD
+}
+
+#[test]
+fn entry_size_covers_whole_lines() {
+    // [V8] Entry<Modify> is larger than one cache line; record it.
+    println!("NR_LOG_ENTRY_SIZE={}", NR_LOG_ENTRY_SIZE);
+    assert!(NR_LOG_ENTRY_SIZE >= 128);
+    assert_eq!(NR_LOG_ENTRY_SIZE % 64, 0);
+    assert_eq!(Log::<Modify>::entry_align() % 64, 0);
+    assert!(nr_log_layout(64 << 20).entries.is_power_of_two());
+}
+
+#[test]
+fn in_place_init_then_attach_without_writes() {
+    let m = shared_mem(min_entries());
+    let a = log_of(&m, true).unwrap();
+    // Attach must see the same header and must not write it.
+    let snapshot: Vec<u8> = unsafe {
+        std::slice::from_raw_parts(m.hdr, std::mem::size_of::<Log<Modify>>()).to_vec()
+    };
+    let b = log_of(&m, false).unwrap();
+    assert!(std::ptr::eq(a, b));
+    let after: &[u8] = unsafe { std::slice::from_raw_parts(m.hdr, std::mem::size_of::<Log<Modify>>()) };
+    assert_eq!(&snapshot[..], after);
+    assert_eq!(b.len(), min_entries());
+    // A mismatching attach is refused.
+    let bad = unsafe {
+        Log::<Modify>::new_in_place(m.hdr as *mut Log<Modify>, m.body, min_entries() * 2, LOGICAL_NODE_NUM, (), false)
+    };
+    assert!(bad.is_err());
+    let bad_n = unsafe {
+        Log::<Modify>::new_in_place(m.hdr as *mut Log<Modify>, m.body, min_entries() + 1, LOGICAL_NODE_NUM, (), true)
+    };
+    assert!(bad_n.is_err());
+}
+
+#[test]
+fn register_at_tokens_are_fixed() {
+    let m = shared_mem(min_entries());
+    let l = log_of(&m, true).unwrap();
+    assert!(l.register_at(0).is_none());
+    assert!(l.register_at(1).is_some());
+    assert!(l.register_at(2).is_some());
+    assert!(l.register_at(LOGICAL_NODE_NUM + 1).is_none());
+    // GC accounts for both replicas from the start: nobody has executed.
+    assert_eq!(l.ltail_at(0), 0);
+    assert_eq!(l.ltail_at(1), 0);
+}
+
+#[test]
+fn ops_cross_nodes_through_shared_log() {
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    // Only the local replica can be registered.
+    assert!(n0.register(1).is_none());
+    assert!(n1.register(0).is_none());
+
+    for k in 0..100u64 {
+        n0.execute_mut(Modify::PutArrayWmeta(key(k), k as isize, 0, -1), t0);
+    }
+    for k in 0..100u64 {
+        let r = n1.execute(Access::Get(key(k)), t1);
+        let e = r.0.expect("node 1 sees node 0's insert");
+        assert_eq!(e.value.cn_array_[0].cn_idx_, k as isize);
+    }
+    // And back.
+    n1.execute_mut(Modify::PutArrayWmeta(key(500), 7, 0, 3), t1);
+    let r = n0.execute(Access::Get(key(500)), t0);
+    assert_eq!(r.0.unwrap().value.wmeta_idx_, 3);
+}
+
+#[test]
+fn sync_replay_clears_change_notification() {
+    // [V4] A replay by the log-sync path (try_sync -> exec) clears matching
+    // change notifications exactly like combine does.
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    n0.execute_mut(Modify::PutArrayWmeta(key(1), 11, 0, -1), t0);
+
+    // Node 1 anchors on the entry (stores change_notif = 11).
+    let r = n1.execute_anchor(Access::Get(key(1)), t1);
+    assert_eq!(r.0.unwrap().value.cn_array_[0].cn_idx_, 11);
+    // No change yet: notification still valid.
+    let _ = n1.execute_anchor(Access::Get(key(1)), t1);
+
+    // Node 0 changes the entry; node 1 replays via the sync path only.
+    n0.execute_mut(Modify::DummyLog(key(1)), t0);
+    n1.log_sync_local();
+    assert!(!n1.check_notification_reset(t1), "replay must clear the notification");
+
+    // An unrelated replay leaves a fresh anchor intact.
+    let _ = n1.execute_anchor(Access::Get(key(1)), t1);
+    n0.execute_mut(Modify::PutArrayWmeta(key(2), 12, 0, -1), t0);
+    n1.log_sync_local();
+    assert!(n1.check_notification_reset(t1));
+}
+
+#[test]
+fn remote_progress_unblocks_gc_and_log_wraps() {
+    // Node 1 only replays from a background sync thread; node 0 appends
+    // several log lengths of ops, so GC must wait on the remote ltail.
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 10_000);
+    let n1 = node(&m, 1, false, 10_000);
+    let stop = Arc::new(AtomicBool::new(false));
+    let (n1c, stopc) = (Arc::clone(&n1), Arc::clone(&stop));
+    let syncer = std::thread::spawn(move || {
+        while !stopc.load(Ordering::Acquire) {
+            n1c.log_sync_local();
+            std::thread::sleep(std::time::Duration::from_micros(50));
+        }
+    });
+    let t0 = n0.register(0).unwrap();
+    let total = 5 * min_entries() as u64;
+    for k in 0..total {
+        // cn index must stay inside the slot buffer (replay flushes that slot)
+        n0.execute_mut(Modify::PutArrayWmeta(key(k % 64), (k as usize % SLOTS) as isize, 0, -1), t0);
+    }
+    stop.store(true, Ordering::Release);
+    syncer.join().unwrap();
+    let l = n0.log();
+    assert!(l.tail_now() >= total as usize);
+    assert!(l.head_now() > 0, "GC advanced past the first wrap");
+    let t1 = n1.register(1).unwrap();
+    let e = n1.execute(Access::Get(key(5)), t1).0.unwrap();
+    assert_eq!(e.value.cn_array_[0].cn_idx_, ((total - 64 + 5) as usize % SLOTS) as isize);
+}
+
+#[test]
+#[should_panic(expected = "stuck")]
+fn stuck_remote_replica_times_out() {
+    // Node 1 attaches but never replays: node 0 must not proceed silently.
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 200);
+    let _n1 = node(&m, 1, false, 200);
+    let t0 = n0.register(0).unwrap();
+    for k in 0..(4 * min_entries() as u64) {
+        n0.execute_mut(Modify::PutArrayWmeta(key(k % 16), (k as usize % SLOTS) as isize, 0, -1), t0);
+    }
+}
diff --git a/third-party/nr_rust/node-replication/src/log.rs b/third-party/nr_rust/node-replication/src/log.rs
index 05a4b03..1590021 100644
--- a/third-party/nr_rust/node-replication/src/log.rs
+++ b/third-party/nr_rust/node-replication/src/log.rs
@@ -421,6 +421,168 @@ where
         size_of::<Cell<Entry<T, M>>>()
     }
 
+    /// Returns the alignment a log entry requires.
+    pub const fn entry_align() -> usize {
+        core::mem::align_of::<Cell<Entry<T, M>>>()
+    }
+
+    /// Constructs (or attaches to) a log whose header and entries live in
+    /// caller-provided memory shared by several processes (De Stijl port: header
+    /// in the HW-coherent region, entries in the SW-coherent region, both mapped
+    /// at the same virtual address in every process).
+    ///
+    /// - `hdr` must point to `size_of::<Self>()` bytes aligned to
+    ///   `align_of::<Self>()`.
+    /// - `slog` must point to `n * entry_size()` bytes aligned to
+    ///   `entry_align()`; `n` must be a power of two and at least
+    ///   `2 * GC_FROM_HEAD`.
+    /// - `nreplicas` replicas are registered up front (tokens `1..=nreplicas`,
+    ///   see [`Log::register_at`]); their ltails start at 0.
+    /// - `init == true` writes the header and every entry. `init == false`
+    ///   writes nothing and only checks that the header describes `slog`/`n`.
+    ///
+    /// The returned log must never be dropped: `slog` is a `Box` over memory
+    /// that was not allocated by the global allocator.
+    ///
+    /// # Safety
+    /// The memory must stay mapped for the rest of the process and must not be
+    /// used for anything else.
+    #[cfg(not(loom))]
+    pub unsafe fn new_in_place(
+        hdr: *mut Self,
+        slog: *mut u8,
+        n: usize,
+        nreplicas: usize,
+        metadata: LM,
+        init: bool,
+    ) -> Result<&'static Self, &'static str> {
+        if hdr.is_null() || slog.is_null() {
+            return Err("null log memory");
+        }
+        if (hdr as usize) % core::mem::align_of::<Self>() != 0 {
+            return Err("log header misaligned");
+        }
+        if (slog as usize) % Self::entry_align() != 0 {
+            return Err("log entries misaligned");
+        }
+        if !n.is_power_of_two() || n < 2 * GC_FROM_HEAD {
+            return Err("log entry count must be a power of two >= 2*GC_FROM_HEAD");
+        }
+        if nreplicas == 0 || nreplicas >= MAX_REPLICAS_PER_LOG {
+            return Err("bad replica count");
+        }
+        let entries = slog as *mut Cell<Entry<T, M>>;
+
+        if init {
+            for i in 0..n {
+                core::ptr::write(entries.add(i), Cell::new(Entry::default()));
+            }
+
+            #[allow(clippy::declare_interior_mutable_const)]
+            const LMASK_DEFAULT: CachePadded<Cell<bool>> = CachePadded::new(Cell::new(true));
+            #[allow(clippy::declare_interior_mutable_const)]
+            const LTAIL_DEFAULT: CachePadded<AtomicUsize> = CachePadded::new(AtomicUsize::new(0));
+
+            core::ptr::write(
+                hdr,
+                Log {
+                    slog: Box::from_raw(core::ptr::slice_from_raw_parts_mut(entries, n)),
