+
+#[test]
+fn admit_on_existing_slot_never_demotes_and_reports_installed_record() {
+    // Attempt 12: a lost admit race must not drop the key's record (RO admit) and its "slot exists" answer means
+    // the record WAS installed (RW admit on an RO key), so the caller keeps it.
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    let wm = |n: &Arc<NodeReplicated<NrHashMapFFi>>, t| n.execute(Access::Get(key(4)), t).0.unwrap().value.wmeta_idx_;
+    n0.execute_mut(Modify::PutArrayWmeta(key(4), 14, NUMA_MEM, 6), t0); // RW with record 6
+
+    // RO admit losing to the existing RW entry: no change (upstream set wmeta -1 and orphaned record 6)
+    assert!(n1.execute_mut(Modify::CheckPutArrayWmeta(key(4), 15, NUMA_MEM, -1), t1).0.is_none());
+    assert_eq!((wm(&n0, t0), wm(&n1, t1)), (6, 6));
+    // RW admit losing to an RW entry: nothing installed
+    assert!(n1.execute_mut(Modify::CheckPutArrayWmeta(key(4), 15, NUMA_MEM, 7), t1).0.is_none());
+    assert_eq!(wm(&n1, t1), 6);
+
+    n0.execute_mut(Modify::CheckSwitchWmetaArray(key(4), -1), t0); // RO
+    // RO admit on an RO entry: idempotent "slot exists" answer, still RO
+    let r = n1.execute_mut(Modify::CheckPutArrayWmeta(key(4), 16, NUMA_MEM, -1), t1).0.unwrap();
+    assert_eq!((r.key == null_BlockId(), wm(&n1, t1)), (true, -1));
+    // RW admit on an RO entry: "slot exists" (FFI 2 = GCD_SLOT_UPDATE_FAILED) yet record 9 is installed
+    let r = n1.execute_mut(Modify::CheckPutArrayWmeta(key(4), 17, NUMA_MEM, 9), t1).0.unwrap();
+    assert!(r.key == null_BlockId());
+    assert_eq!((wm(&n0, t0), wm(&n1, t1)), (9, 9));
+    assert_eq!(n0.execute(Access::Get(key(4)), t0).0.unwrap().value.cn_array_[0].cn_idx_, 14, "slot unchanged");
+}
