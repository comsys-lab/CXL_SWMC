 namespace rackobj::common {
 
 bool WriteMetadata::WSeqBegin() { return write_seqlock_begin(&seqlock_); }
@@ -191,6 +193,27 @@ bool SharedMetadata::RecycleWmeta(size_t wm_index, bool with_lock) {
     }
 }
 
+// De Stijl port. Upstream freed `result` and left `victim` locked whenever they differed. They differ only in
+// artifact64, where the key comes from the victim's BlockId field: if that field is stale (the victim is no longer,
+// or not only, that key's record), the RO switch hits the key's real record. Upstream then (a) freed a record it had
+// not locked (free_seqlock_with_lock frees any locked record, i.e. it stole a writer's lock) or failed and leaked it,
+// and (b) never unlocked the victim, so every user of the victim blocked forever. Here: the key is RO now, so its
+// record is free to reclaim once we hold its lock (wait for a writer); the victim is unlocked and left allocated.
+bool SharedMetadata::FinishReclaim(size_t victim, std::optional<size_t> result) {
+    WriteMetadata *vic = &b_meta_.wmeta_start_addr_[victim];
+    if (!result.has_value()) {
+        vic->WUnlockOnly();
+        return false;
+    }
+    if (result.value() == victim) return RecycleWmeta(victim);
+
+    diag::reclaim_victim_mismatch.fetch_add(1, std::memory_order_relaxed);
+    vic->WUnlockOnly();
+    WriteMetadata *rec = &b_meta_.wmeta_start_addr_[result.value()];
+    if (!rec->WLockOnly()) return false;  // already free
+    return RecycleWmeta(result.value());
+}
