--- a/lib/globals.cc
+++ b/lib/globals.cc
@@ -53,11 +53,10 @@ ssize_t Put(const uint8_t* buf, uint64_t count, off_t key) { return lib::RackOBJ
 ssize_t Get(uint8_t* buf, uint64_t count, off_t key) { return lib::RackOBJKV::Get(buf, count, key); }
 
 void Register(int tid) {
+    // De Stijl port: every thread of this process belongs to this process's node; no NUMA pinning (the
+    // harness sets affinity inside each VM). At most 32 NR registrations per node (never freed).
     int rid = rackobj::TidToRid(tid);
 
-    int physical_numa_node = rackobj::RidToNumaNode(rid);
-    rackobj::pinThreadtoNumaNode(physical_numa_node);
-
 #ifdef NR
     RegisterNRThread(rid);
 #endif
@@ -65,7 +64,7 @@ void Register(int tid) {
     lib::thread_local_meta.file_backed_ = false;
     lib::thread_local_meta.logical_node_id_ = rid;
 
-    LOG(INFO) << "logical thread " << tid << " mapped to (" << rid << ", " << physical_numa_node << ")";
+    LOG(INFO) << "thread " << tid << " registered on node " << rid;
 }
 
 void UnRegister() {
@@ -86,7 +85,9 @@ size_t GetConfigSize_t(std::string c_name) {
     } else if (c_name == "num_logical_node") {
         return LOGICAL_NODE_NUM;
     } else if (c_name == "logical_nid") {
-        return static_cast<size_t>(lib::thread_local_meta.logical_node_id_);
+        return static_cast<size_t>(rackobj::GetNodeId());
+    } else if (c_name == "node_id") {
+        return static_cast<size_t>(rackobj::GetNodeId());
     }
 
     LOG(FATAL) << "GetConfigSize_t: " << c_name << " unrecognized";
diff --git a/src/common/config.cc b/src/common/config.cc
index d5a628c..65bbe67 100644
--- a/src/common/config.cc
+++ b/src/common/config.cc
@@ -76,8 +76,9 @@ RackOBJConfig::RackOBJConfig() {
     if (config["logical_scr_size"]) {
         logical_scr_size_ = convert_mem_size(config["logical_scr_size"].as<string>());
     } else {
-        logical_scr_size_ = DEFAULT_LOGICAL_SCR_SIZE;
-        LOG(WARNING) << "logical_scr_size_ not specified, default to " << DEFAULT_LOGICAL_SCR_SIZE;
+        // De Stijl port [V9]: the default differs per flavor (DYN_WMETA), so both flavors must be given the
+        // same explicit value
+        LOG(FATAL) << "config must specify \"logical_scr_size\" (same value for every flavor)";
     }
 
     if (config["ncr_size"]) {
@@ -124,6 +125,39 @@ RackOBJConfig::RackOBJConfig() {
 
     CHECK(config["key_space"]);
     key_space_ = config["key_space"].as<size_t>();
+
+    /* De Stijl 2-VM port: one node per process. scr_size/ncr_size/local_size are not used for placement
+     * any more (the shared layout comes from the region config, cxl_region.yaml). */
+    if (const char *env = std::getenv("MEGALON_NODE_ID")) {
+        node_id_ = std::stoi(env);
+        LOG(INFO) << "node_id " << node_id_ << " from MEGALON_NODE_ID";
+    } else if (config["node_id"]) {
+        node_id_ = config["node_id"].as<int>();
+    } else {
+        LOG(FATAL) << "config must specify \"node_id\" (or set MEGALON_NODE_ID)";
+    }
+    CHECK(node_id_ >= 0 && node_id_ < LOGICAL_NODE_NUM) << "node_id " << node_id_ << " out of range [0, "
+                                                        << LOGICAL_NODE_NUM << ")";
+
+    region_config_ = config["region_config"] ? config["region_config"].as<string>() : "";
+
+    reinit_ = config["reinit"] ? config["reinit"].as<bool>() : false;
+    if (const char *env = std::getenv("MEGALON_REINIT")) reinit_ = std::string(env) == "1";
+
+    attach_mprotect_ = config["attach_mprotect"] ? config["attach_mprotect"].as<bool>() : true;
+    stuck_timeout_ms_ = config["stuck_timeout_ms"] ? config["stuck_timeout_ms"].as<uint64_t>() : 10000;
+    log_sync_interval_us_ = config["log_sync_interval_us"] ? config["log_sync_interval_us"].as<uint64_t>() : 100;
+    CHECK(log_sync_interval_us_ >= 1 && log_sync_interval_us_ <= 100)
+        << "log_sync_interval_us must be in [1, 100] (design: sync every <= 100 us)";
+    attach_timeout_s_ = config["attach_timeout_s"] ? config["attach_timeout_s"].as<uint64_t>() : 600;
+    barrier_timeout_s_ = config["start_barrier_timeout_s"] ? config["start_barrier_timeout_s"].as<uint64_t>() : 600;
+    nr_log_bytes_ = config["nr_log_size"] ? convert_mem_size(config["nr_log_size"].as<string>()) : 64UL << 20;
+
+    LOG(INFO) << "port config: node_id=" << node_id_ << " region_config="
+              << (region_config_.empty() ? std::string("$CXL_REGION_CONFIG") : region_config_)
+              << " reinit=" << reinit_ << " attach_mprotect=" << attach_mprotect_
+              << " stuck_timeout_ms=" << stuck_timeout_ms_ << " log_sync_interval_us=" << log_sync_interval_us_
+              << " nr_log_bytes=" << nr_log_bytes_;
 }
 
 bool RackOBJConfig::IsPathExcluded(const std::filesystem::path &path) const {
