diff --git a/config/destijl-2vm.yaml b/config/destijl-2vm.yaml
new file mode 100644
index 0000000..d7de9ca
--- /dev/null
+++ b/config/destijl-2vm.yaml
@@ -0,0 +1,29 @@
+# De Stijl 2-VM port: one Megalon process per VM, one node per process.
+# Use the same file on both VMs except node_id (or set MEGALON_NODE_ID).
+# The shared layout (device, map_va, HWcc/SWcc ranges) comes only from the
+# region config (CXL_SWMC/config/cxl_region.yaml); scr_size/ncr_size/local_size
+# are not used by the port.
+mount_directory: /mydata        # required by the config parser; unused by kv-store
+key_space: 1000000
+slots: 1001000                  # same value for every flavor [V9]
+logical_scr_size: 200MB         # required; same value for every flavor [V9]
+node_id: 0                      # 0 = init (VM0), 1 = attach (VM1)
+region_config: ""               # empty: $CXL_REGION_CONFIG
+reinit: false                   # node 0: allow re-initializing a non-empty control block (or MEGALON_REINIT=1)
+attach_mprotect: true           # node 1: write-protect HWcc/SWcc while attaching
+stuck_timeout_ms: 10000         # abort if the other node holds back the NR log this long
+log_sync_interval_us: 100       # background NR log replay period (<= 100)
+nr_log_size: 64MB
+attach_timeout_s: 600
+start_barrier_timeout_s: 600
+replicate: false
+flush: false
+evict: false
+partition_ratio: 0.0
+excluded_files:
+excluded_directories:
+  - /usr
+  - /proc
+  - /etc
+  - /dev
+  - /sys
diff --git a/lib/globals.cc b/lib/globals.cc
