@@ -7,6 +7,7 @@
 #include <sched.h>
 
 #include <array>
+#include <atomic>
 #include <iostream>
 #include <limits>
 #include <vector>
@@ -37,10 +38,7 @@ void pinThreadtoNumaNode(int target_node) {
 
     pthread_setaffinity_np(pthread_self(), sizeof(cpu_set_t), &cpuset);
 
-    uint32_t numa_node = UINT32_MAX;
