 bool verifyThreadNuma(int numa_node) {
@@ -165,11 +163,20 @@ static const std::vector<int>& GetExecNodes() {
     return exec_nodes;
 }
 
+static std::atomic<int> g_node_id{-1};
+
+void SetNodeId(int node_id) { g_node_id.store(node_id, std::memory_order_release); }
+
+int GetNodeId() {
+    int n = g_node_id.load(std::memory_order_acquire);
+    CHECK(n >= 0) << "node id not set (Megalon not initialized)";
+    return n;
+}
+
+// De Stijl port: a replica id is a node id; there is no NUMA mapping any more.
 int RidToNumaNode(int rid) {
-    const std::vector<int>& exec_nodes = GetExecNodes();
-    const int kNumExec = static_cast<int>(exec_nodes.size());
-    int exec_idx = rid % kNumExec;
-    return exec_nodes[static_cast<size_t>(exec_idx)];
+    (void)rid;
+    return GetNodeId();
 }
 
 std::vector<int> NumaNodeRids(int numa_node) {
@@ -192,9 +199,10 @@ std::vector<int> NumaNodeRids(int numa_node) {
     return result;
 }
 
+// De Stijl port: every thread of this process maps to this process's node.
 int TidToRid(int tid) {
-    // simple round-robin assignment of thread to logical nodes
-    return tid % LOGICAL_NODE_NUM;
+    (void)tid;
+    return GetNodeId();
