diff --git a/src/core/seqcount.h b/src/core/seqcount.h
index 8820d1f..eb15940 100644
--- a/src/core/seqcount.h
+++ b/src/core/seqcount.h
@@ -83,14 +83,20 @@ constexpr uint32_t SEQ_MASK = ~(FREE_BIT | LOCK_BIT);
  * data layout:
  * | free bit | lock bit | ... sequence count ... |
  */
+// De Stijl port: WMETA_PACKED4 (paper layout) keeps only the 32-bit sequence (free and lock bits included). The
+// active_node byte is not read anywhere in the artifact (active-node tracking lives in CacheNode).
 typedef struct seqlock {
 #ifdef __cplusplus
     std::atomic<uint32_t> sequence;
+#ifndef WMETA_PACKED4
     std::atomic<uint8_t> active_node;
+#endif
 #else
     volatile uint32_t sequence;
+#ifndef WMETA_PACKED4
     volatile uint8_t active_node;
 #endif
+#endif
 
 #if C3_RWLOCK != 0
     C3RwLock rw_lock;
@@ -98,13 +104,21 @@ typedef struct seqlock {
 #endif
 } seqlock_t;
 
+#if defined(WMETA_PACKED4) && C3_RWLOCK != 0
+#error "WMETA_PACKED4 needs C3_RWLOCK == 0 (the record is the 32-bit sequence only)"
+#endif
+
 static inline void seqlock_init(seqlock_t *s) {
     s->sequence = FREE_BIT;
+#ifndef WMETA_PACKED4
     s->active_node = 0;
+#endif
 }
 
+#ifndef WMETA_PACKED4
 uint8_t get_active_node(seqlock_t *s);
 void set_active_node(seqlock_t *s, uint8_t node);
+#endif
 
 uint32_t read_seqlock_begin(seqlock_t *s);
 
