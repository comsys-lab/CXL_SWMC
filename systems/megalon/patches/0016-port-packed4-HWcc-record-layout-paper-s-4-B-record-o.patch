+# De Stijl port: HWcc record layout. artifact64 = upstream (64 B line per record, owner BlockId in the record);
+# packed4 = the paper's 4 B record (sequence only); with DYN_WMETA the owner key moves to the NR replica
+# (nr feature wmeta-rev).
+set(MEGALON_WMETA_LAYOUT "artifact64" CACHE STRING "artifact64 | packed4")
+set_property(CACHE MEGALON_WMETA_LAYOUT PROPERTY STRINGS artifact64 packed4)
+if (MEGALON_WMETA_LAYOUT STREQUAL "packed4")
+    add_definitions(-DWMETA_PACKED4=1)
+elseif (NOT MEGALON_WMETA_LAYOUT STREQUAL "artifact64")
+    message(FATAL_ERROR "MEGALON_WMETA_LAYOUT must be artifact64 or packed4 (got '${MEGALON_WMETA_LAYOUT}')")
+endif()
+message(STATUS "MEGALON_WMETA_LAYOUT=${MEGALON_WMETA_LAYOUT}")
+
 if (FULL_COHERENCE)
     add_definitions(-DFULL_COHERENCE=1)
 endif()
@@ -164,6 +176,10 @@ elseif (NO_COHERENCE)
 else()
     set(MEGALON_NR_FEATURES "")
 endif()
+if (MEGALON_WMETA_LAYOUT STREQUAL "packed4" AND LIMITED_SCR)
+    # reverse map only where records are reclaimed (DYN_WMETA); static records never need the owner key
+    string(APPEND MEGALON_NR_FEATURES " wmeta-rev")
+endif()
 set(MEGALON_NR_LIB "" CACHE FILEPATH "absolute path of the per-flavor libnr_hashmap.a")
 if (NOT MEGALON_NR_LIB OR NOT IS_ABSOLUTE "${MEGALON_NR_LIB}" OR NOT EXISTS "${MEGALON_NR_LIB}")
     message(FATAL_ERROR "MEGALON_NR_LIB must be the absolute path of an existing libnr_hashmap.a (got '${MEGALON_NR_LIB}')")
