+//! De Stijl port, packed4 record layout (feature wmeta-rev): tests of the per-replica reverse map
+//! wmeta_idx -> key and of SwitchToReadOnlyByWmeta. Pure Rust, heap memory only.
+
+use std::collections::HashMap;
+
+use node_replication::nr::Dispatch;
+use rand::rngs::SmallRng;
+use rand::{Rng, SeedableRng};
+
+use super::port_tests::{key, node, shared_mem, min_entries};
+use super::*;
+
+const KEYS: u64 = 8;
+const WMETAS: isize = 6;
+
+fn entry_with_wmeta(cn: isize, w: isize) -> GCDEntry {
+    let mut e = init_gcd_entry(cn, NUMA_MEM);
+    e.wmeta_idx_ = w;
+    e
+}
+
+fn random_op(r: &mut SmallRng) -> Modify {
+    let k = key(r.gen_range(0..KEYS));
+    let k2 = key(r.gen_range(0..KEYS));
+    let w = r.gen_range(-1..WMETAS);
+    let cn = r.gen_range(0..16) as isize;
+    match r.gen_range(0..11) {
+        0 => Modify::PutArrayWmeta(k, cn, NUMA_MEM, w),
+        1 => Modify::CheckPutArrayWmeta(k, cn, NUMA_MEM, w),
+        2 => Modify::CheckSwitchWmetaArray(k, w),
+        3 => Modify::InvalidateExceptArrayUpdateWmeta(k, NUMA_MEM, w),
+        4 => Modify::Delete(k),
+        5 => Modify::DeleteIfArray(k, NUMA_MEM),
+        6 => Modify::DeleteArray(k, NUMA_MEM),
+        7 => Modify::Swap(k, k2, entry_with_wmeta(cn, w)),
+        8 => Modify::Put(k, entry_with_wmeta(cn, w)),
+        9 => Modify::CheckSwapArray(k, k2, cn, NUMA_MEM, NUMA_MEM),
+        _ => Modify::SwitchToReadOnlyByWmeta(r.gen_range(0..WMETAS)),
+    }
+}
+
+/// Reverse map vs storage, and vs the upstream meaning of the record's BlockId ("the key that last got this
+/// record"): rev[w] == k  <=>  k is the last key assigned w and still holds w.
+fn check(h: &NrHashMapFFi, last: &HashMap<isize, BlockId>) {
+    for (w, k) in &h.rev {
+        assert_eq!(h.storage.get(k).map(|e| e.wmeta_idx_), Some(*w), "rev[{}] = {:?} does not hold it", w, k);
+    }
+    for w in 0..WMETAS {
+        let expect = last.get(&w).copied().filter(|k| h.storage.get(k).map(|e| e.wmeta_idx_) == Some(w));
+        assert_eq!(h.rev.get(&w).copied(), expect, "rev[{}]", w);
+    }
+}
+
+#[test]
+fn reverse_map_tracks_every_wmeta_change() {
+    for seed in 0..200u64 {
+        let mut r = SmallRng::seed_from_u64(seed);
+        let mut h = NrHashMapFFi::new(64);
+        let mut last: HashMap<isize, BlockId> = HashMap::new();
+        for _ in 0..400 {
+            let op = random_op(&mut r);
+            // shadow of upstream's record BlockId: the key whose wmeta was last set to w
+            let before: HashMap<BlockId, isize> = h.storage.iter().map(|(k, e)| (*k, e.wmeta_idx_)).collect();
+            let expect_switch = if let Modify::SwitchToReadOnlyByWmeta(w) = op { Some((w, h.rev.get(&w).copied())) } else { None };
+            let resp = h.dispatch_mut(op.clone());
+            for (k, e) in &h.storage {
+                if e.wmeta_idx_ != -1 && before.get(k) != Some(&e.wmeta_idx_) {
+                    last.insert(e.wmeta_idx_, *k);
+                }
+            }
+            if let Some((w, holder)) = expect_switch {
+                match holder {
+                    Some(k) => {
+                        let g = resp.0.expect("switch of a held record succeeds");
+                        assert_eq!((g.key, g.value.wmeta_idx_), (k, w));
+                        assert_eq!(h.storage[&k].wmeta_idx_, -1);
+                    }
+                    None => assert!(resp.0.is_none(), "no holder => None"),
+                }
+            }
+            check(&h, &last);
+        }
+    }
+}
+
+#[test]
+fn switch_by_wmeta_never_returns_another_record() {
+    // upstream hazard: victim record 1's BlockId still names key A, but A now holds record 2;
+    // SwitchToReadOnly(A) would return 2. By-wmeta resolution returns None instead.
+    let mut h = NrHashMapFFi::new(8);
+    let a = key(1);
+    h.dispatch_mut(Modify::PutArrayWmeta(a, 3, NUMA_MEM, 1));
+    h.dispatch_mut(Modify::CheckSwitchWmetaArray(a, -1));
+    h.dispatch_mut(Modify::CheckSwitchWmetaArray(a, 2));
+    assert!(h.dispatch_mut(Modify::SwitchToReadOnlyByWmeta(1)).0.is_none());
+    assert_eq!(h.storage[&a].wmeta_idx_, 2);
+    let g = h.dispatch_mut(Modify::SwitchToReadOnlyByWmeta(2)).0.unwrap();
+    assert_eq!((g.key, g.value.wmeta_idx_), (a, 2));
+    assert!(h.rev.is_empty());
+}
+
+#[test]
+fn replicas_resolve_victims_identically_across_nodes() {
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    // node 0 makes keys RW with records 0..50; node 1 reclaims them by record index only
+    for k in 0..50u64 {
+        n0.execute_mut(Modify::PutArrayWmeta(key(k), k as isize, NUMA_MEM, k as isize), t0);
+    }
+    for w in 0..50isize {
+        let g = n1.execute_mut(Modify::SwitchToReadOnlyByWmeta(w), t1).0.expect("node 1 resolves node 0's record");
+        assert_eq!((g.key, g.value.wmeta_idx_), (key(w as u64), w));
+    }
+    // reassign a record on node 1, reclaim it on node 0: node 0 must see the new owner
+    n1.execute_mut(Modify::CheckSwitchWmetaArray(key(7), 3), t1);
+    let g = n0.execute_mut(Modify::SwitchToReadOnlyByWmeta(3), t0).0.unwrap();
+    assert_eq!(g.key, key(7));
+    assert!(n0.execute_mut(Modify::SwitchToReadOnlyByWmeta(3), t0).0.is_none());
+    for k in 0..50u64 {
+        assert_eq!(n0.execute(Access::Get(key(k)), t0).0.unwrap().value.wmeta_idx_, -1);
+        assert_eq!(n1.execute(Access::Get(key(k)), t1).0.unwrap().value.wmeta_idx_, -1);
+    }
+}
