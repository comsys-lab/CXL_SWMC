+void ObjectStore::ThreadLookupHist(rackobj::ObjectLookupHist *s) {
+    static_assert(rackobj::ObjectLookupHist::kBins == coh::kLookupHistBins, "lookup histogram bin count");
+    const coh::Tls &t = coh::tls;
+    const double hz = coh::g_cfg.timers ? coh::TscHz() : 0.0;
+    auto ns = [&](uint64_t cyc) -> uint64_t {
+        return hz > 0 ? static_cast<uint64_t>(static_cast<double>(cyc) * 1e9 / hz + 0.5) : 0;
+    };
+    *s = rackobj::ObjectLookupHist{};
+    s->tsc_khz = static_cast<uint64_t>(hz / 1000.0 + 0.5);
+    for (int i = 0; i < coh::kLookupHistBins; i++) {
+        s->read[i] = t.rlk_hist.cnt[i];
+        s->write[i] = t.wlk_hist.cnt[i];
+        s->read_samples += t.rlk_hist.cnt[i];
+        s->write_samples += t.wlk_hist.cnt[i];
+        s->lo_ns[i] = i == 0 ? 0 : ns(1ull << (i - 1));
+    }
+    s->read_sum_ns = ns(t.rlk_hist.sum_cyc);
+    s->write_sum_ns = ns(t.wlk_hist.sum_cyc);
+}
+
