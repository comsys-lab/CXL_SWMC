index 8123bda..8c0a63f 100644
--- a/include/rackobj.h
+++ b/include/rackobj.h
@@ -179,6 +179,26 @@ struct ThreadAnchor {
 // shim/megalon_objapi.h (CXL_SWMC) and M2 §19.
 
 void GetThreadAnchor(ThreadAnchor* s);
+
+/* Build 79 (megalon-page): distribution of the index lookup of ONE timed GetAnchor, calling thread since Register().
+ * The lookup is the same quantity as ThreadAnchor.read_lookup_ns_sampled / write_lookup_ns (the index dispatch timed
+ * by NR inside GetAnchorTimed), but one sample per timed GetAnchor CALL: read = ObjectReadStart's first attempt of a
+ * timed read section and KV Get attempts outside (A) of a timed Get; write = every attempt of a timed write section
+ * (ObjectWriteStart / KV Put; retries included, so write totals can exceed ThreadAnchor's final-attempt sums). Only
+ * already-timed (sampled) sections record; unsampled sections add no work. Recorded in TSC cycles, log2 bins:
+ * bin 0 = 0 cycles, bin i in [1, kBins-2] = [2^(i-1), 2^i) cycles, bin kBins-1 = >= 2^(kBins-2) cycles. Exported in
+ * ns: lo_ns[i] = lower bin edge (cycles * 1e6 / tsc_khz, rounded), sums converted the same way. Mean per call =
+ * *_sum_ns / *_samples. All zero with timers off (MEGALON_COH_TIMERS=0). */
+struct ObjectLookupHist {
+    static constexpr int kBins = 32;
+    uint64_t tsc_khz;                         // TSC rate used for the conversion (0: timers off / not yet known)
+    uint64_t read_samples, write_samples;     // = sum of read[] / write[]
+    uint64_t read_sum_ns, write_sum_ns;       // total lookup time of the samples
+    uint64_t read[kBins], write[kBins];       // per-bin sample counts
+    uint64_t lo_ns[kBins];                    // lower edge of bin i in ns (bin 0: 0)
+};
+void GetObjectLookupHist(ObjectLookupHist* s);
+
 // build 71, overhead measurement only (object-test OBJECT_TEST_OVERHEAD): switch the instrumentation timers at run
 // time (initial value: MEGALON_COH_TIMERS). Call only while no thread of the process has an open section or a
 // wait in progress; durations recorded across a switch are meaningless.
