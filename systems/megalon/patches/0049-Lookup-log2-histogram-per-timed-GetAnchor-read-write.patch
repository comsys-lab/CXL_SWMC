diff --git a/src/common/coh_stats.h b/src/common/coh_stats.h
index 92d5fdf..037cc0e 100644
--- a/src/common/coh_stats.h
+++ b/src/common/coh_stats.h
@@ -31,6 +31,22 @@ extern Config g_cfg;
 
 inline uint64_t Now() { return g_cfg.timers ? __rdtsc() : 0; }
 
+// build 79 (megalon-page): log2 histogram of the index-lookup cycles of ONE timed GetAnchor (the lookup part that
+// TimedAnchor already measures). Bin 0: 0 cycles; bin i (1..kLookupHistBins-2): [2^(i-1), 2^i) TSC cycles; the last
+// bin is open-ended (>= 2^(kLookupHistBins-2)). Bins are in TSC cycles (no division on the hot path); the export
+// (rackobj.h ObjectLookupHist) converts sums and bin edges to ns with the TSC rate.
+inline constexpr int kLookupHistBins = 32;
+struct LookupHist {
+    uint64_t cnt[kLookupHistBins];
+    uint64_t sum_cyc;
+};
+inline void HistAdd(LookupHist &h, uint64_t cyc) {
+    int b = cyc ? 64 - __builtin_clzll(cyc) : 0;
+    if (b > kLookupHistBins - 1) b = kLookupHistBins - 1;
+    h.cnt[b]++;
+    h.sum_cyc += cyc;
+}
+
 // Thread-local accumulators, zero-initialised (no TLS constructor). Raw totals (any caller) and the object-API
 // attribution (CohSnap fields, in cycles).
 struct Tls {
@@ -76,6 +92,9 @@ struct Tls {
     void *obj_ctr;                         // this thread's ObjectStore counter block (object_store.cc; kept at Register)
     uint64_t probe_cyc;                    // build 77: median delta of back-to-back TSC pairs, measured at Register
     uint64_t ta_cnt, tbc_cnt, td_cnt;      // build 77: (A), (B)+(C) events and (D) episodes whose durations were timed
+    // build 79: per-call lookup histograms of the timed GetAnchors (read: object ReadStart / KV Get sites; write:
+    // object WriteStart / KV Put sites); every TimedAnchor call is one sample (incl. retried attempts)
+    LookupHist rlk_hist, wlk_hist;
 };
 
 // The thread's Tls through ThreadLocalMeta (set at Register; no thread-local lookup), or coh::tls.
@@ -158,9 +177,9 @@ inline Spin SpinNow(Tls &t) {
 }
 
 // Runs fn() (one GetAnchorTimed: the NR side sets its anchor flag and times the dispatch) and returns its result;
-// adds the split to *out. Timed sections only.
+// adds the split to *out and (build 79) the lookup cycles of this call to *hist. Timed sections only.
 template <class F>
-inline auto TimedAnchor(Tls &t, AnchorSplit *out, F &&fn) {
+inline auto TimedAnchor(Tls &t, AnchorSplit *out, LookupHist *hist, F &&fn) {
     uint64_t *w = const_cast<uint64_t *>(t.nr ? t.nr : NrPtr());
     const uint64_t l0 = w[4], f0 = w[5], s0 = SpinNow(t).cyc;
     w[3] = 1;  // anchor flag: the NR replay times its Megalon-only flushes into w[5]
@@ -171,6 +190,7 @@ inline auto TimedAnchor(Tls &t, AnchorSplit *out, F &&fn) {
     const uint64_t lookup = w[4] - l0, fl = w[5] - f0, spin = SpinNow(t).cyc - s0;
     out->lookup += lookup;
     out->nr += Sub(t, Sub(t, t1, t0), lookup + fl + spin);
+    HistAdd(*hist, lookup);
     return r;
 }
 
