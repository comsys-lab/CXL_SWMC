+// build 79: per-call index-lookup histogram (rackobj.h ObjectLookupHist), b - a (counts and sums; tsc_khz, lo_ns of b)
+rackobj::ObjectLookupHist Lh() {
+    rackobj::ObjectLookupHist h{};
+    rackobj::GetObjectLookupHist(&h);
+    return h;
+}
+
+rackobj::ObjectLookupHist LhDiff(const rackobj::ObjectLookupHist &a, const rackobj::ObjectLookupHist &b) {
+    rackobj::ObjectLookupHist d = b;
+    d.read_samples -= a.read_samples;
+    d.write_samples -= a.write_samples;
+    d.read_sum_ns -= a.read_sum_ns;
+    d.write_sum_ns -= a.write_sum_ns;
+    for (int i = 0; i < rackobj::ObjectLookupHist::kBins; i++) {
+        d.read[i] -= a.read[i];
+        d.write[i] -= a.write[i];
+    }
+    return d;
+}
+
+// bins and sums consistent: sum of bins == samples; the sum lies inside [sum of lower edges, sum of upper edges]
+bool LhConsistent(const rackobj::ObjectLookupHist &h) {
+    constexpr int K = rackobj::ObjectLookupHist::kBins;
+    uint64_t rs = 0, ws = 0;
+    double rlo = 0, rhi = 0, wlo = 0, whi = 0;
+    for (int i = 0; i < K; i++) {
+        rs += h.read[i];
+        ws += h.write[i];
+        const double lo = static_cast<double>(h.lo_ns[i]);
+        const double hi = i + 1 < K ? static_cast<double>(h.lo_ns[i + 1]) : 1e18;
+        rlo += lo * h.read[i];
+        rhi += hi * h.read[i];
+        wlo += lo * h.write[i];
+        whi += hi * h.write[i];
+    }
+    // +-1 ns per sample: edges and sums are rounded separately
+    auto in = [](double s, double lo, double hi, uint64_t n) { return s + n + 2 >= lo && s <= hi + n + 2; };
+    return rs == h.read_samples && ws == h.write_samples && in(h.read_sum_ns, rlo, rhi, rs) &&
+           in(h.write_sum_ns, wlo, whi, ws);
+}
+
+std::string LhStr(const char *what, const rackobj::ObjectLookupHist &h) {
+    std::string s = std::string("LOOKUP-HIST ") + what + ": tsc " + std::to_string(h.tsc_khz) + " kHz | read " +
+                    std::to_string(h.read_samples) + " samples " + std::to_string(h.read_sum_ns) + " ns | write " +
+                    std::to_string(h.write_samples) + " samples " + std::to_string(h.write_sum_ns) +
+                    " ns | bins [lo_ns]=read/write:";
+    for (int i = 0; i < rackobj::ObjectLookupHist::kBins; i++)
+        if (h.read[i] || h.write[i])
+            s += " [" + std::to_string(h.lo_ns[i]) + "]=" + std::to_string(h.read[i]) + "/" + std::to_string(h.write[i]);
+    return s;
+}
+
 std::array<uint64_t, 4> Split() {
     std::array<uint64_t, 4> a{};
     rackobj::GetThreadAnchorSplit(a.data());
@@ -547,20 +599,38 @@ void CohPhase(HelperThread &helper) {
         auto c0 = Coh();
         auto a0 = Split();
         auto z0 = Anc();
+        auto h0 = Lh();
         const uint64_t n = 16 * c0.check_sample;  // build 75: 16 sampled sections per comparison line
         for (uint64_t i = 0; i < n; i++) (void)read_gen(CohX(node_id));
         auto z = AncDiff(z0, Anc());
         LOG(INFO) << AncPerSection("object read", z) << " | probe " << Anc().reserved[2] << " ps";
+        {
+            // build 79: uncontended reads = one timed GetAnchor per sampled section (no (A) restart, no ENOENT), so
+            // the read histogram has exactly check_sampled samples and the same lookup total (+-2 ns rounding)
+            auto hd = LhDiff(h0, Lh());
+            LOG(INFO) << LhStr("object read", hd);
+            EXPECT(hd.read_samples == z.check_sampled && hd.write_samples == 0 && LhConsistent(hd));
+            EXPECT(hd.read_sum_ns + 2 >= z.read_lookup_ns_sampled && hd.read_sum_ns <= z.read_lookup_ns_sampled + 2);
+            EXPECT(!timed || (hd.read_samples > 0 && hd.read_sum_ns > 0 && hd.tsc_khz > 0));
+            EXPECT(timed || (hd.read_samples == 0 && hd.tsc_khz == 0));
+        }
         EXPECT(!timed || (Anc().reserved[2] >= 1000 && Anc().reserved[2] <= 200000));  // build 77: 1-200 ns
         EXPECT(in_range(z.check_sampled, n) && z.read_lookup_ns_sampled == Split()[0] - a0[0]);
         EXPECT(spos(z.rseq_ns_sampled) && spos(z.read_nr_ns_sampled));  // C(own) is RW: version reads
         {
             auto w0 = Anc();
+            auto hw0 = Lh();
             for (uint64_t i = 0; i < n; i++) WriteGen(CohX(node_id), 100 + i);
             auto wd = AncDiff(w0, Anc());
             LOG(INFO) << AncPerSection("object write", wd);
             EXPECT(wd.write_sections == n && (evall ? wd.reserved[0] == n : in_range(wd.reserved[0], n)));
             EXPECT(spos(wd.wseq_ns) && spos(wd.wseq_end_ns) && spos(wd.write_lookup_ns));
+            // build 79: one sample per timed attempt; retries (write_retry / RW switch) add samples, never remove
+            auto hwd = LhDiff(hw0, Lh());
+            LOG(INFO) << LhStr("object write", hwd);
+            EXPECT(hwd.write_samples >= wd.reserved[0] && hwd.read_samples == 0 && LhConsistent(hwd));
+            EXPECT(hwd.write_sum_ns + 2 >= wd.write_lookup_ns);
+            EXPECT(!timed || (hwd.write_samples > 0 && hwd.write_sum_ns > 0));
         }
         auto d = CohDiff(c0, Coh());
         auto a1 = Split();
