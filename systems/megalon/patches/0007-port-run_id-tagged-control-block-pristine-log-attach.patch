+#[test]
+fn log_counters_read_only_snapshot() {
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let mut c = NrLogCounters { head: 9, tail: 9, ltail: [9; LOGICAL_NODE_NUM] };
+    assert!(nr_log_counters(m.hdr, &mut c));
+    assert_eq!((c.head, c.tail, c.ltail), (0, 0, [0; LOGICAL_NODE_NUM]), "fresh log is pristine");
+    let t0 = n0.register(0).unwrap();
+    n0.execute_mut(Modify::PutArrayWmeta(key(1), 1, 0, -1), t0);
+    assert!(nr_log_counters(m.hdr, &mut c));
+    assert_eq!(c.tail, 1);
+    assert_eq!(c.ltail[0], 1);
+    assert_eq!(c.ltail[1], 0);
+    assert!(!nr_log_counters(std::ptr::null(), &mut c));
+}
