+void PortContext::CheckRun(const char *where) const {
+    uint64_t rid = ctrl_->run_id.load(std::memory_order_acquire);
+    uint32_t st = ctrl_->state.load(std::memory_order_acquire);
+    if (rid != run_id_ || st != kStateReady)
+        LOG(FATAL) << where << ": control block belongs to another run or is not READY (run_id 0x" << std::hex << rid
+                   << ", expected 0x" << run_id_ << std::dec << ", state " << st << ")";
+}
+
+void PortContext::NodeBarrier(uint32_t phase) {
+    CHECK(initialized_);
+    CheckRun("barrier entry");
+    const uint64_t mine = (static_cast<uint64_t>(run_tag()) << 32) | phase;
+    ctrl_->phase[node_id_].store(mine, std::memory_order_release);
+    auto start = std::chrono::steady_clock::now();
+    auto last_log = start;
+    for (;;) {
+        bool all = true;
+        for (int i = 0; i < LOGICAL_NODE_NUM; i++) {
+            uint64_t w = ctrl_->phase[i].load(std::memory_order_acquire);
+            if ((w >> 32) != run_tag() || static_cast<uint32_t>(w) < phase) all = false;
+        }
+        if (all) break;
+        auto now = std::chrono::steady_clock::now();
+        if (now - start > std::chrono::seconds(barrier_timeout_s_))
+            LOG(FATAL) << "node barrier phase " << phase << ": the other node did not arrive within "
+                       << barrier_timeout_s_ << " s";
+        if (now - last_log > std::chrono::seconds(10)) {
+            LOG(INFO) << "node barrier phase " << phase << ": waiting for the other node";
+            last_log = now;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    CheckRun("barrier exit");
+    LOG(INFO) << "node barrier phase " << phase << " passed";
+}
