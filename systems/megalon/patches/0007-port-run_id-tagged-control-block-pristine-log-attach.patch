+/// Read-only snapshot of a shared log's progress counters (no writes).
+#[repr(C)]
+pub struct NrLogCounters {
+    pub head: usize,
+    pub tail: usize,
+    pub ltail: [usize; LOGICAL_NODE_NUM],
+}
+
+/// Reads head, tail and every ltail of the shared log at `log_hdr` without
+/// writing. Used by an attaching node to refuse a log that has already been
+/// used (it must be pristine: everything 0). Returns false for a null header.
+#[no_mangle]
+pub extern "C" fn nr_log_counters(log_hdr: *const u8, out: *mut NrLogCounters) -> bool {
+    if log_hdr.is_null() || out.is_null() {
+        return false;
+    }
+    let log: &Log<Modify> = unsafe { &*(log_hdr as *const Log<Modify>) };
+    let mut c = NrLogCounters { head: log.head_now(), tail: log.tail_now(), ltail: [0; LOGICAL_NODE_NUM] };
+    for i in 0..LOGICAL_NODE_NUM {
+        c.ltail[i] = log.ltail_at(i);
+    }
+    unsafe { core::ptr::write(out, c) };
+    true
+}
