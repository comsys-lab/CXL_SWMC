diff --git a/lib/object_store.cc b/lib/object_store.cc
new file mode 100644
index 0000000..c22b9dc
--- /dev/null
+++ b/lib/object_store.cc
@@ -0,0 +1,287 @@
+#include "object_store.h"
+
+#include <cerrno>
+
+#include "absl/log/check.h"
+#include "absl/log/log.h"
+#include "index/nr_hashmap.h"
+
+namespace rackobj::lib {
+
+using common::ReadErrno;
+using common::WriteErrno;
+
+namespace {
+
+constexpr size_t A64(size_t x) { return (x + 63) & ~static_cast<size_t>(63); }
+
+// The thread's open section. One per thread: a section is validated through the thread's single change
+// notification (NR execute_anchor stores one cn index per thread), exactly as one Get/Put is.
+struct Section {
+    enum Kind { kNone, kRead, kWrite } kind = kNone;
+    uint64_t token = 0;
+    uint8_t *ptr = nullptr;
+    size_t size = 0;
+    common::ReadHandle rh;
+    common::WriteHandle wh;
+};
+thread_local Section sec;
+thread_local uint64_t next_token = 0;
+
+}  // namespace
+
+size_t ObjectStore::ScrExtraBytes(const RackOBJConfig &cfg) {
+    return cfg.GetObjectArenaBytes() ? A64(sizeof(port::ObjectShared)) + 64 : 0;
+}
+
+size_t ObjectStore::StaticRecords(const RackOBJConfig &cfg) {
+    return cfg.GetObjectArenaBytes() ? cfg.GetObjectMaxCount() : 0;
+}
+
+ObjectStore::ObjectStore(C3POHandle *c3po, const uint8_t *flush_base, size_t record_base, const RackOBJConfig &cfg,
+                         SwitchRwFn switch_rw)
+    : c3po_(c3po), flush_base_(flush_base), record_base_(record_base), switch_rw_(std::move(switch_rw)) {
+    if (cfg.GetObjectArenaBytes() == 0) {
+        LOG(INFO) << "objects: disabled (object_arena_size 0)";
+        return;
+    }
+#if KEY_SIZE != 24
+    LOG(FATAL) << "objects need KEY_SIZE 24 (BlockId inode namespace " << kObjectInode << ")";
+#endif
+#ifdef FILE_INTERFACE
+    LOG(FATAL) << "objects and FILE_INTERFACE are exclusive (real inode numbers could collide with the object "
+                  "namespace)";
+#endif
+    auto &ctx = port::PortContext::Get();
+    arena_bytes_ = cfg.GetObjectArenaBytes();
+    align_ = cfg.GetObjectAlign();
+#ifndef DYN_WMETA
+    max_records_ = cfg.GetObjectMaxCount();
+#endif
+    shared_ = reinterpret_cast<port::ObjectShared *>(ctx.scr()->AllocateBytes(sizeof(port::ObjectShared), 64));
+    if (!ctx.attach()) {
+        std::construct_at(shared_);
+        shared_->next_off.v.store(0);
+        shared_->next_record.v.store(0);
+        shared_->created.v.store(0);
+        shared_->lost_bytes.v.store(0);
+        shared_->lost_records.v.store(0);
+    }
+    arena_ = ctx.lnr()->AllocateBytes(arena_bytes_, std::max<size_t>(align_, 4096));
+    CHECK(arena_ >= flush_base_ && static_cast<size_t>(arena_ - flush_base_) % kObjGranule == 0)
+        << "object arena must follow the slot data (flush base) at a 64 B multiple";
+    CHECK(static_cast<size_t>(arena_ - flush_base_) + arena_bytes_ < kObjCnFlag) << "object arena too far";
+    LOG(INFO) << "objects: arena " << arena_bytes_ << " B at " << static_cast<void *>(arena_) << " (LNR, flush base +"
+              << (arena_ - flush_base_) << "), align " << align_ << ", "
+#ifdef DYN_WMETA
+              << "records: dynamic pool shared with slots"
+#else
+              << "static records " << record_base_ << " .. " << record_base_ + max_records_ - 1
+#endif
+        ;
+}
+
+common::BlockId ObjectStore::Key(uint64_t id) {
+    return common::BlockId(static_cast<uint64_t>(0), static_cast<ino_t>(kObjectInode), static_cast<off_t>(id));
+}
+
+bool ObjectStore::Decode(const std::optional<common::GCDEntry> &e, uint8_t **ptr, size_t *size) const {
+    if (!e.has_value() || !e->cn_array_[0].cn_idx_.has_value()) return false;
+    size_t cn = *e->cn_array_[0].cn_idx_;
+    CHECK(cn & kObjCnFlag) << "object key with a non-object entry (cn " << cn << ")";
+    CHECK(e->cn_array_[1].cn_idx_.has_value() && *e->cn_array_[1].cn_idx_ > 0) << "object entry without size";
+    *ptr = const_cast<uint8_t *>(flush_base_) + (cn & ~kObjCnFlag) * kObjGranule;
+    *size = *e->cn_array_[1].cn_idx_;
+    return true;
+}
+
+// Where the slot path flushes a slot (cache_flush_data, CopyFromUserBufferCXL), the object path flushes the object.
+void ObjectStore::Flush(uint8_t *ptr, size_t size) {
+#ifndef FULL_COHERENCE
+    c3po_->cache_flush(reinterpret_cast<char *>(ptr), size);  // ptr is 64 B aligned: [ptr, ptr+size) fully covered
+    local_.flushes.fetch_add(1, std::memory_order_relaxed);
+    local_.flush_bytes.fetch_add(size, std::memory_order_relaxed);
+#else
+    (void)ptr;
+    (void)size;
+#endif
+}
+
+int ObjectStore::Create(uint64_t id, size_t size, Tlm *tlm) {
+    if (!enabled()) return -ENOTSUP;
+    if (size == 0 || id > static_cast<uint64_t>(INT64_MAX)) return -EINVAL;
+    CHECK(sec.kind == Section::kNone) << "ObjectCreate inside an open object section";
+    const auto *nr_meta = tlm->nr_meta_per_thread_;
+    CHECK(nr_meta) << "Register() the thread before using objects";
+    const common::BlockId key = Key(id);
+    uint8_t *p;
+    size_t sz;
+    // synced lookup first: no space is reserved for an id that already exists
+    if (Decode(c3po_->Gcd()->Get(key, nr_meta), &p, &sz)) {
+        local_.create_exists.fetch_add(1, std::memory_order_relaxed);
+        return -EEXIST;
+    }
+    std::optional<size_t> wmeta = std::nullopt;  // paper §3.4.2: no coherence record at create (read-shared)
+#ifndef DYN_WMETA
+    // static records (hwcc): every object gets its own record at create, as every slot does at admit
+    {
+        uint64_t r = shared_->next_record.v.load(std::memory_order_relaxed);
+        do {
+            if (r >= max_records_) {
+                local_.create_nomem.fetch_add(1, std::memory_order_relaxed);
+                return -ENOSPC;
+            }
+        } while (!shared_->next_record.v.compare_exchange_weak(r, r + 1, std::memory_order_relaxed));
+        wmeta = record_base_ + r;
+    }
+#endif
+    const size_t rounded = (size + align_ - 1) & ~(align_ - 1);
+    uint64_t cur = shared_->next_off.v.load(std::memory_order_relaxed);
+    do {
+        if (cur + rounded > arena_bytes_ || cur + rounded < cur) {
+            if (wmeta.has_value()) shared_->lost_records.v.fetch_add(1, std::memory_order_relaxed);
+            local_.create_nomem.fetch_add(1, std::memory_order_relaxed);
+            return -ENOMEM;
+        }
+    } while (!shared_->next_off.v.compare_exchange_weak(cur, cur + rounded, std::memory_order_relaxed));
+    const size_t off_units = (static_cast<size_t>(arena_ - flush_base_) + cur) / kObjGranule;
+    if (!c3po_->Gcd()->CreateObject(key, off_units, size, wmeta, nr_meta)) {
+        // another node created the id between the lookup and our log entry: the space (and record) stay unused
+        shared_->lost_bytes.v.fetch_add(rounded, std::memory_order_relaxed);
+        if (wmeta.has_value()) shared_->lost_records.v.fetch_add(1, std::memory_order_relaxed);
+        local_.create_exists.fetch_add(1, std::memory_order_relaxed);
+        return -EEXIST;
+    }
+    shared_->created.v.fetch_add(1, std::memory_order_relaxed);
+    local_.creates.fetch_add(1, std::memory_order_relaxed);
+    return 0;
+}
+
+int ObjectStore::Lookup(uint64_t id, size_t *size, Tlm *tlm) {
+    if (!enabled()) return -ENOTSUP;
+    CHECK(sec.kind == Section::kNone) << "ObjectLookup inside an open object section";
+    uint8_t *p;
+    return Decode(c3po_->Gcd()->Get(Key(id), tlm->nr_meta_per_thread_), &p, size) ? 0 : -ENOENT;
+}
+
+// read_start = the slot Get up to the data copy: GetAnchor (replica synced to the log, notification armed on the
+// object), then read_seq_start (RW: wait for an even counter c, compare with the host-side counter l; on mismatch
+// flush the object and retry, as Get's PAGE_INCOHERENT branch does). RO objects skip the pre-read check.
+int ObjectStore::ReadStart(uint64_t id, ObjectHandle *h, Tlm *tlm) {
+    if (!enabled()) return -ENOTSUP;
+    CHECK(sec.kind == Section::kNone) << "nested object section (one open section per thread)";
+    const auto *nr_meta = tlm->nr_meta_per_thread_;
+    CHECK(nr_meta) << "Register() the thread before using objects";
+    const common::BlockId key = Key(id);
+    uint8_t *ptr;
+    size_t size;
+    for (;;) {
+        std::optional<common::GCDEntry> entry = c3po_->Gcd()->GetAnchor(key, nr_meta);
+        if (!Decode(entry, &ptr, &size)) return -ENOENT;  // objects are created explicitly (no admit)
+        common::init_read_handle(sec.rh, key, entry, tlm->logical_node_id_);
+        sec.rh.from_cxl = true;
+        sec.rh.cn_index = entry->cn_array_[0].cn_idx_;
+        if (c3po_->read_seq_start(sec.rh)) break;
+        CHECK(sec.rh.rh_errno == ReadErrno::PAGE_INCOHERENT) << "read_seq_start: unexpected error";
+        Flush(ptr, size);
+        local_.read_retry_incoherent.fetch_add(1, std::memory_order_relaxed);
+    }
+    sec.kind = Section::kRead;
+    sec.token = ++next_token;
+    sec.ptr = ptr;
+    sec.size = size;
+    *h = ObjectHandle{ptr, size, id, sec.token};
+    local_.read_sections.fetch_add(1, std::memory_order_relaxed);
+    return 0;
+}
+
+// read_end = Get's post-read checks: read_seq_end (tail check + "log updates concerning A" via the notification;
+// RW: counter changed -> flush the object; success records l = c). false = the caller must redo the read.
+bool ObjectStore::ReadEnd(ObjectHandle *h, Tlm *tlm) {
+    CHECK(sec.kind == Section::kRead && h && h->token == sec.token) << "ObjectReadEnd without its ObjectReadStart";
+    sec.kind = Section::kNone;
+    if (c3po_->read_seq_end(sec.rh, tlm->nr_meta_per_thread_)) return true;
+    switch (sec.rh.rh_errno) {
+        case ReadErrno::META_OUTDATE:  // a log event on the object: the replay already flushed it (Get: retry)
+            local_.read_retry_notify.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        case ReadErrno::PAGE_INCOHERENT:  // counter changed during the read (Get: flush, retry)
+            Flush(sec.ptr, sec.size);
+            local_.read_retry_incoherent.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        default:
+            LOG(FATAL) << "read_seq_end: unexpected error";
+    }
+    return false;
+}
+
+// write_start = the slot Put up to the data copy: GetAnchor; RO -> SwitchRW (allocate a record via the log, with
+// critical-path reclaim) and retry; write_seq_start (lock bit, counter odd, tail check + notification check) or retry.
+int ObjectStore::WriteStart(uint64_t id, ObjectHandle *h, Tlm *tlm) {
+    if (!enabled()) return -ENOTSUP;
+    CHECK(sec.kind == Section::kNone) << "nested object section (one open section per thread)";
+    const auto *nr_meta = tlm->nr_meta_per_thread_;
+    CHECK(nr_meta) << "Register() the thread before using objects";
+    const common::BlockId key = Key(id);
+    uint8_t *ptr;
+    size_t size;
+    for (;;) {
+        std::optional<common::GCDEntry> entry = c3po_->Gcd()->GetAnchor(key, nr_meta);
+        if (!Decode(entry, &ptr, &size)) return -ENOENT;
+        common::init_write_handle(sec.wh, key, entry, tlm->logical_node_id_);
+        sec.wh.cn_index = entry->cn_array_[0].cn_idx_;
+        if (c3po_->IsRO(entry)) {
+#ifndef DYN_WMETA
+            LOG(FATAL) << "object " << id << " has no static record (hwcc objects are created RW)";
+#endif
+            std::error_code ec = switch_rw_(sec.wh, tlm);
+            CHECK(ec != std::make_error_code(std::errc::operation_not_permitted)) << "object entry vanished";
+            local_.switch_rw.fetch_add(1, std::memory_order_relaxed);
+            continue;
+        }
+        sec.wh.from_cxl = true;
+        if (c3po_->write_seq_start(sec.wh, nr_meta)) break;
+        local_.write_retry.fetch_add(1, std::memory_order_relaxed);
+    }
+    sec.kind = Section::kWrite;
+    sec.token = ++next_token;
+    sec.ptr = ptr;
+    sec.size = size;
+    *h = ObjectHandle{ptr, size, id, sec.token};
+    local_.write_sections.fetch_add(1, std::memory_order_relaxed);
+    return 0;
+}
+
+// write_end = Put's post-write steps: flush the written data (here the whole object, the API has no range), then
+// write_seq_end (counter even, wrap-around event, l = c, unlock).
+void ObjectStore::WriteEnd(ObjectHandle *h, Tlm *tlm) {
+    CHECK(sec.kind == Section::kWrite && h && h->token == sec.token) << "ObjectWriteEnd without its ObjectWriteStart";
+    Flush(sec.ptr, sec.size);
+    c3po_->write_seq_end(sec.wh, tlm->nr_meta_per_thread_);
+    sec.kind = Section::kNone;
+}
+
+void ObjectStore::Stats(ObjectStats *s) const {
+    *s = ObjectStats{};
+    if (!enabled()) return;
+    s->arena_bytes = arena_bytes_;
+    s->used_bytes = shared_->next_off.v.load(std::memory_order_relaxed);
+    s->created = shared_->created.v.load(std::memory_order_relaxed);
+    s->lost_bytes = shared_->lost_bytes.v.load(std::memory_order_relaxed);
+    s->static_records_used = shared_->next_record.v.load(std::memory_order_relaxed);
+    s->lost_records = shared_->lost_records.v.load(std::memory_order_relaxed);
+    s->creates = local_.creates.load();
+    s->create_exists = local_.create_exists.load();
+    s->create_nomem = local_.create_nomem.load();
+    s->read_sections = local_.read_sections.load();
+    s->read_retry_notify = local_.read_retry_notify.load();
+    s->read_retry_incoherent = local_.read_retry_incoherent.load();
+    s->write_sections = local_.write_sections.load();
+    s->write_retry = local_.write_retry.load();
+    s->switch_rw = local_.switch_rw.load();
+    s->flushes = local_.flushes.load();
+    s->flush_bytes = local_.flush_bytes.load();
+    NrFfi::nr_obj_replay_flush_stats(&s->replay_flushes, &s->replay_flush_bytes);
+}
+
+}  // namespace rackobj::lib
diff --git a/lib/object_store.h b/lib/object_store.h
new file mode 100644
index 0000000..326dfbc
--- /dev/null
+++ b/lib/object_store.h
@@ -0,0 +1,96 @@
+// De Stijl port, phase B: variable-size objects as the Megalon paper proposes (§4: "MEGALON can be easily extended
+// to support variable-sized objects at object creation time by keeping the object size as a field in the logically
+// shared metadata"). Design and every difference from the slot path: reports/M2-megalon-objects-paper.md (De Stijl
+// control repo).
+//
+// One object = one index entry = one coherence record, exactly like a slot:
+//   index entry (NR replicated map, key BlockId(0, kObjectInode, id)):
+//     cn_array_[0] = kObjCnFlag | (object offset from the slot data base) / 64   location, also the "cn index"
+//     cn_array_[1] = size in bytes (invalidate_ set: never a local copy)            fixed at create
+//     wmeta_idx_   = coherence record; -1 while read-shared (DYN_WMETA); static record in hwcc
+//   data: [ptr, ptr + size) contiguous in an SWcc (LNR) arena, bump-allocated at create, never freed
+//   SCR: ObjectShared (bump cursor + counters), and in hwcc the static object records
+//
+// The coherence protocol is the slot path's, reused function by function: GetAnchor, C3POHandle::read_seq_start /
+// read_seq_end / write_seq_start / write_seq_end, SharedMemoryObjectHandle::SwitchRW (RO->RW, critical-path
+// reclaim), the wmeta manager (reclaim) and the NR replay (exec_notify). Where the slot path flushes a slot, the object
+// path flushes [ptr, ptr + size). Nothing else is added: no chunking, no per-chunk records, no writer preflush.
+#pragma once
+
+#include <rackobj.h>
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <system_error>
+
+#include "common/config.h"
+#include "common/thread_local.h"
+#include "core/c3.h"
+#include "core/lru_policy.h"
+#include "shared_memory/cxl_port.h"
+
+namespace rackobj::lib {
+
+// Key namespace (BlockId inode) of objects; Put/Get slot keys use inode 0. Same value in ffi/object_tests.rs.
+constexpr uint64_t kObjectInode = 0x4d4f424a;  // "MOBJ"
+// Location encoding in cn_array_[0]; same values as ffi/types.rs OBJ_CN_FLAG / OBJ_GRANULE.
+constexpr size_t kObjCnFlag = static_cast<size_t>(1) << 62;
+constexpr size_t kObjGranule = 64;
+
+using common::C3POHandle;
+
+class ObjectStore {
+public:
+    using Tlm = ThreadLocalMeta<common::LruPolicy>;
+    // The slot path's RO->RW switch (SharedMemoryObjectHandle::SwitchRW), called with the object's WriteHandle.
+    using SwitchRwFn = std::function<std::error_code(const common::WriteHandle &, Tlm *)>;
+
+    /* SCR bytes for ObjectShared (0 when objects are disabled), for PortContext::ScrFootprint. */
+    static size_t ScrExtraBytes(const RackOBJConfig &cfg);
+
+    /* Static object records to reserve (hwcc; C3POHandle::RecordCount ignores it with DYN_WMETA). */
+    static size_t StaticRecords(const RackOBJConfig &cfg);
+
+    /* Allocates ObjectShared (SCR) and the object arena (LNR) when enabled; must run in the same order on every node,
+     * before PortContext::Finish. flush_base = the NR replica's flush base (slot data base). */
+    ObjectStore(C3POHandle *c3po, const uint8_t *flush_base, size_t record_base, const RackOBJConfig &cfg,
+                SwitchRwFn switch_rw);
+
+    bool enabled() const { return arena_bytes_ != 0; }
+
+    int Create(uint64_t id, size_t size, Tlm *tlm);
