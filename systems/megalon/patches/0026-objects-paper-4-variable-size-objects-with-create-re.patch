 #pragma once
 
+#include <cstddef>
 #include <cstdint>
 #include <unistd.h>
 #include <string>
@@ -44,6 +45,50 @@ double GetPartitionRatio();
  * Only the calling thread waits. */
 void NodeBarrier(uint32_t phase);
 
+/* ---- De Stijl port, phase B: variable-size objects as the Megalon paper proposes (§4, API as in §4/§5) ----
+ * Enabled by object_arena_size > 0 in the config. An object is `size` contiguous bytes in shared memory (SWcc), size
+ * fixed at create; its descriptor and coherence record live in its index entry (one object = one entry = one record).
+ *   ObjectCreate(id, size)          0 | -EINVAL | -EEXIST (id exists) | -ENOMEM (arena full) | -ENOSPC (hwcc: no
+ *                                   static record left) | -ENOTSUP (objects disabled)
+ *   ObjectReadStart(id, &h)         0 | -ENOENT | -ENOTSUP; then read [h.ptr, h.ptr + h.size) IN PLACE
+ *   ObjectReadEnd(&h)               true: the read is valid; false: redo it (start again with ObjectReadStart)
+ *   ObjectWriteStart(id, &h)        0 | -ENOENT | -ENOTSUP; then write [h.ptr, h.ptr + h.size) IN PLACE
+ *   ObjectWriteEnd(&h)              publishes the write (flushes the whole object, unlocks)
+ * Read pattern:  do { ObjectReadStart(id, &h); use(h.ptr, h.size); } while (!ObjectReadEnd(&h));
+ * Contract: Register(tid) first; at most one open section per thread; no Put/Get/Create inside a section; data read
+ * inside a section is only valid after ObjectReadEnd returned true. No delete (bump allocation, no reclamation). */
+struct ObjectHandle {
+    uint8_t* ptr = nullptr;
+    size_t size = 0;
+    uint64_t id = 0;
+    uint64_t token = 0;  // internal: identifies the thread's open section
+};
+
+struct ObjectStats {
+    // shared (every node)
+    uint64_t arena_bytes, used_bytes, created, lost_bytes, static_records_used, lost_records;
+    // this node
+    uint64_t creates, create_exists, create_nomem;
+    uint64_t read_sections, read_retry_notify, read_retry_incoherent;
+    uint64_t write_sections, write_retry, switch_rw;
+    uint64_t flushes, flush_bytes;                // read-side incoherent flushes + write_end flushes
+    uint64_t replay_flushes, replay_flush_bytes;  // NR replay of the other node's object events
+};
+
+int ObjectCreate(uint64_t id, size_t size);
+
+int ObjectLookup(uint64_t id, size_t* size);  // synced index lookup; 0 | -ENOENT | -ENOTSUP
+
+int ObjectReadStart(uint64_t id, ObjectHandle* h);
+
+bool ObjectReadEnd(ObjectHandle* h);
+
+int ObjectWriteStart(uint64_t id, ObjectHandle* h);
+
+void ObjectWriteEnd(ObjectHandle* h);
+
+void GetObjectStats(ObjectStats* s);
+
 /* De Stijl port diagnostics (MEGALON_DIAG=1): this thread's last Get (path/entry/seq) and the process counters. */
 std::string DiagLastGet();
 std::string DiagSummary();
