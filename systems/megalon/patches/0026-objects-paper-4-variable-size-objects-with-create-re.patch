diff --git a/benchmarks/object_test.cc b/benchmarks/object_test.cc
new file mode 100644
index 0000000..cedd6ab
--- /dev/null
+++ b/benchmarks/object_test.cc
@@ -0,0 +1,402 @@
+// De Stijl port, phase B: self-checking 2-node test of the paper's variable-size objects (§4; lib/object_store.h).
+// Run one process per node exactly like kv-store (RACKOBJ_CONFIG, MEGALON_NODE_ID, MEGALON_RUN_ID, region config);
+// the Megalon config must set object_arena_size (>= 64MB) and should be the same file on both nodes.
+//
+//   object-test <concurrent phase seconds> [reader threads per node, default 2]
+//
+// Exit: 0 PASS, 3 FAIL. Both nodes run the same phase sequence, separated by NodeBarrier:
+//   0 errors and races: -EINVAL / -ENOENT / -ENOMEM paths; both nodes create the same id (exactly one wins, the
+//     loser gets -EEXIST); a second create of an existing id is -EEXIST; lookups report the creator's size.
+//   1 pattern: node n fills its object P(n) (odd size, > 1 MiB) in place in one write section; both nodes verify both
+//     objects in place through read sections (also checks that the reported size and contents agree across nodes).
+//   2 cross-node writer: node n rewrites the OTHER node's object P(1-n) (gen 2), the owner verifies it.
+//   3 concurrent: node n's writer thread rewrites C(n) whole (one generation per section) and both nodes' writers
+//     rewrite the shared object S; reader threads on both nodes read C(0), C(1), S in place. Every read that
+//     ObjectReadEnd accepts must be one complete generation (no torn read) and generations must not go backwards per
+//     reader and object; afterwards each node must see the writers' last generations (exchanged via a mailbox).
+//   4 many objects: each node creates and writes kMany objects of varied sizes (alignment, partial last line),
+//     the other node verifies all of them (many records: with a small logical_scr_size this drives reclaim).
+//   5 slots unchanged: a Put on node 0 is read by node 1 with Get (objects and slots coexist).
+// Shared counters are checked at the end (created == expected, lost bytes only from the phase-0 race).
+#include <rackobj.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "absl/log/check.h"
+#include "absl/log/globals.h"
+#include "absl/log/initialize.h"
+#include "absl/log/log.h"
+
+namespace {
+
+size_t node_id = 0;
+std::atomic<uint64_t> failures{0};
+uint32_t phase = 0;
+
+#define EXPECT(cond)                                                   \
+    do {                                                               \
+        if (!(cond)) {                                                 \
+            failures.fetch_add(1);                                     \
+            LOG(ERROR) << "FAIL (line " << __LINE__ << "): " << #cond; \
+        }                                                              \
+    } while (0)
+
+void Barrier(const char *what) {
+    rackobj::NodeBarrier(++phase);
+    LOG(INFO) << "phase " << phase << " (" << what << ") reached by both nodes";
+}
+
+constexpr uint64_t kBase = 0x0b1ec7000000ull;
+constexpr uint64_t kRace = kBase + 1;
+constexpr uint64_t kMailbox = kBase + 2;
+constexpr uint64_t kMissing = kBase + 3;
+constexpr uint64_t kShared = kBase + 4;
+uint64_t PatId(size_t n) { return kBase + 10 + n; }
+uint64_t ConcId(size_t n) { return kBase + 20 + n; }
+uint64_t ManyId(size_t n, size_t i) { return kBase + 0x100000 + n * 0x10000 + i; }
+constexpr size_t kMany = 1000;
+constexpr size_t kMailboxHalf = 512;
+constexpr uint64_t kMailMagic = 0x4d41494c424f5821ull;
+const size_t kPatLen[2] = {(1u << 20) + 13, (1u << 20) + 300 * 1024 + 7};
+constexpr size_t kConcLen = (64u << 10) + 72;  // multiple of 8 bytes, not of 64
+
+inline uint64_t mix64(uint64_t x) {
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+    return x;
+}
+
+inline uint8_t PatByte(uint64_t id, uint64_t gen, size_t off) {
+    uint64_t w = mix64(id * 0x9E3779B97F4A7C15ull ^ (gen << 48) ^ static_cast<uint64_t>(off / 8));
+    return static_cast<uint8_t>(w >> ((off % 8) * 8));
+}
+
+void FillPat(uint8_t *dst, uint64_t id, uint64_t gen, size_t len) {
+    for (size_t i = 0; i < len; i++) dst[i] = PatByte(id, gen, i);
+}
+
+size_t Mismatch(const uint8_t *p, uint64_t id, uint64_t gen, size_t len) {
+    size_t bad = 0;
+    for (size_t i = 0; i < len; i++) bad += p[i] != PatByte(id, gen, i);
+    return bad;
+}
+
+// Writes generation `gen` of the byte pattern over the whole object, in place.
+void WritePat(uint64_t id, uint64_t gen) {
+    rackobj::ObjectHandle h;
+    CHECK_EQ(rackobj::ObjectWriteStart(id, &h), 0) << "write_start " << id;
+    FillPat(h.ptr, id, gen, h.size);
+    rackobj::ObjectWriteEnd(&h);
+}
+
+// Reads object `id` in place until a read is accepted; returns (size, mismatching bytes vs generation gen).
+std::pair<size_t, size_t> CheckPat(uint64_t id, uint64_t gen, uint64_t *retries = nullptr) {
+    rackobj::ObjectHandle h;
+    size_t bad = 0;
+    for (;;) {
+        CHECK_EQ(rackobj::ObjectReadStart(id, &h), 0) << "read_start " << id;
+        bad = Mismatch(h.ptr, id, gen, h.size);
+        if (rackobj::ObjectReadEnd(&h)) break;
+        if (retries) ++*retries;
+    }
+    return {h.size, bad};
+}
+
+// mailbox: node n owns bytes [n * 512, (n+1) * 512): magic, count, values
+void MailPut(const std::vector<uint64_t> &v) {
+    CHECK_LE(v.size() + 2, kMailboxHalf / 8);
+    rackobj::ObjectHandle h;
+    CHECK_EQ(rackobj::ObjectWriteStart(kMailbox, &h), 0);
+    auto *w = reinterpret_cast<uint64_t *>(h.ptr + node_id * kMailboxHalf);
+    w[0] = kMailMagic;
+    w[1] = v.size();
+    for (size_t i = 0; i < v.size(); i++) w[2 + i] = v[i];
+    rackobj::ObjectWriteEnd(&h);
+}
+
+std::vector<uint64_t> MailGet(size_t from) {
+    rackobj::ObjectHandle h;
+    std::vector<uint64_t> out;
+    for (;;) {
+        CHECK_EQ(rackobj::ObjectReadStart(kMailbox, &h), 0);
+        const auto *w = reinterpret_cast<const uint64_t *>(h.ptr + from * kMailboxHalf);
+        out.clear();
+        bool ok = w[0] == kMailMagic && w[1] + 2 <= kMailboxHalf / 8;
+        if (ok) out.assign(w + 2, w + 2 + w[1]);
+        if (rackobj::ObjectReadEnd(&h)) {
+            CHECK(ok) << "mailbox of node " << from << " not written";
+            return out;
+        }
+    }
+}
+
+// concurrent-phase layout: word 0 = gen, word 1 = writer node, word i = f(id, gen, i)
+inline uint64_t ConcWord(uint64_t id, uint64_t gen, size_t i) { return mix64(id ^ (gen << 20) ^ (i << 44)); }
+
+void WriteGen(uint64_t id, uint64_t gen) {
+    rackobj::ObjectHandle h;
+    CHECK_EQ(rackobj::ObjectWriteStart(id, &h), 0);
+    auto *w = reinterpret_cast<uint64_t *>(h.ptr);
+    const size_t n = h.size / 8;
+    for (size_t i = 2; i < n; i++) w[i] = ConcWord(id, gen, i);
+    w[1] = node_id;
+    w[0] = gen;
+    rackobj::ObjectWriteEnd(&h);
+}
+
+// gen of a complete generation, 0 if torn (inspected inside the section; only valid if ReadEnd accepts)
+uint64_t InspectGen(const uint8_t *p, size_t size, uint64_t id) {
+    const auto *w = reinterpret_cast<const uint64_t *>(p);
+    const size_t n = size / 8;
+    const uint64_t gen = w[0];
+    if (gen == 0) return 0;
+    for (size_t i = 2; i < n; i++)
+        if (w[i] != ConcWord(id, gen, i)) return 0;
+    return gen;
+}
+
+struct ReaderResult {
+    uint64_t reads = 0, retries = 0, torn = 0, backwards = 0, unwritten = 0;
+};
+
+void Reader(int tid, const std::vector<uint64_t> &ids, std::chrono::steady_clock::time_point until, ReaderResult *r) {
+    rackobj::Register(tid);
+    std::vector<uint64_t> last(ids.size(), 0);
+    std::mt19937_64 rng(static_cast<uint64_t>(tid) * 7919 + node_id);
+    while (std::chrono::steady_clock::now() < until) {
+        size_t k = rng() % ids.size();
+        rackobj::ObjectHandle h;
+        uint64_t gen;
+        bool zero;
+        for (;;) {
+            CHECK_EQ(rackobj::ObjectReadStart(ids[k], &h), 0);
+            // everything is inspected inside the section; it only counts if ObjectReadEnd accepts the read
+            gen = InspectGen(h.ptr, h.size, ids[k]);
+            zero = reinterpret_cast<const volatile uint64_t *>(h.ptr)[0] == 0;
+            if (rackobj::ObjectReadEnd(&h)) break;
+            r->retries++;
+        }
+        r->reads++;
+        if (gen == 0) {
+            // an accepted read of a never-written object (gen word 0) is fine; anything else is torn
+            if (zero) r->unwritten++;
+            else r->torn++;
+            continue;
+        }
+        if (gen < last[k]) r->backwards++;
+        last[k] = gen;
+    }
+    rackobj::UnRegister();
+}
+
+// generations are (counter << 1 | node) so the two writers of S never produce the same gen
+uint64_t Writer(int tid, uint64_t own, std::chrono::steady_clock::time_point until, uint64_t *shared_last) {
+    rackobj::Register(tid);
+    uint64_t g = 0;
+    while (std::chrono::steady_clock::now() < until) {
+        ++g;
+        WriteGen(own, (g << 1) | node_id);
+        if (g % 4 == 0) {
+            WriteGen(kShared, (g << 1) | node_id);
+            *shared_last = (g << 1) | node_id;
+        }
+    }
+    rackobj::UnRegister();
+    return (g << 1) | node_id;
+}
+
+}  // namespace
+
+int main(int argc, char **argv) {
+    absl::SetStderrThreshold(absl::LogSeverity::kInfo);
+    absl::InitializeLog();
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: %s <concurrent phase seconds> [reader threads per node]\n", argv[0]);
+        return 1;
+    }
+    const int conc_s = std::atoi(argv[1]);
+    const int readers = argc > 2 ? std::atoi(argv[2]) : 2;
+    CHECK(conc_s > 0 && readers > 0 && readers <= 16);
+    node_id = rackobj::GetConfigSize_t("node_id");
+    const size_t other = 1 - node_id;
+    rackobj::Register(0);
+
+    rackobj::ObjectStats st0{};
+    rackobj::GetObjectStats(&st0);
+    CHECK(st0.arena_bytes >= (64u << 20)) << "object_arena_size must be >= 64MB for this test";
+
+    // ---- phase 0: errors and races ----
+    EXPECT(rackobj::ObjectCreate(kBase + 99, 0) == -EINVAL);
+    {
+        rackobj::ObjectHandle h;
+        EXPECT(rackobj::ObjectReadStart(kMissing, &h) == -ENOENT);
+        EXPECT(rackobj::ObjectWriteStart(kMissing, &h) == -ENOENT);
+        size_t sz = 0;
+        EXPECT(rackobj::ObjectLookup(kMissing, &sz) == -ENOENT);
+        EXPECT(rackobj::ObjectCreate(kBase + 98 + 2 * node_id, st0.arena_bytes + 1) == -ENOMEM);
+    }
+    if (node_id == 0) {
+        EXPECT(rackobj::ObjectCreate(kMailbox, 2 * kMailboxHalf) == 0);
+        EXPECT(rackobj::ObjectCreate(kShared, kConcLen) == 0);
+    }
+    EXPECT(rackobj::ObjectCreate(PatId(node_id), kPatLen[node_id]) == 0);
+    EXPECT(rackobj::ObjectCreate(ConcId(node_id), kConcLen) == 0);
+    EXPECT(rackobj::ObjectCreate(PatId(node_id), 64) == -EEXIST);
+    Barrier("created");
+    const int race_rc = rackobj::ObjectCreate(kRace, 1000 + node_id);  // both nodes, same id
+    EXPECT(race_rc == 0 || race_rc == -EEXIST);
+    MailPut({static_cast<uint64_t>(race_rc == 0)});
+    Barrier("race done");
+    {
+        auto o = MailGet(other);
+        EXPECT(o.size() == 1);
+        const uint64_t wins = (race_rc == 0) + (o.empty() ? 0 : o[0]);
+        EXPECT(wins == 1);
+        size_t sz = 0;
+        EXPECT(rackobj::ObjectLookup(kRace, &sz) == 0);
+        EXPECT(sz == 1000 || sz == 1001);
+        EXPECT(rackobj::ObjectLookup(PatId(other), &sz) == 0 && sz == kPatLen[other]);
+        LOG(INFO) << "race on id " << kRace << ": this node " << (race_rc == 0 ? "won" : "lost") << ", size " << sz;
+    }
+
+    // ---- phase 1: pattern, in place ----
+    WritePat(PatId(node_id), 1);
+    Barrier("pattern written");
+    for (size_t n = 0; n < 2; n++) {
+        auto [sz, bad] = CheckPat(PatId(n), 1);
+        EXPECT(sz == kPatLen[n]);
+        EXPECT(bad == 0);
+        LOG(INFO) << "pattern P(" << n << "): size " << sz << ", bad bytes " << bad;
+    }
+    Barrier("pattern checked");
+
+    // ---- phase 2: cross-node writer ----
+    WritePat(PatId(other), 2);
+    Barrier("cross-node written");
+    {
+        auto [sz, bad] = CheckPat(PatId(node_id), 2);
+        EXPECT(sz == kPatLen[node_id] && bad == 0);
+        LOG(INFO) << "own object rewritten by node " << other << ": bad bytes " << bad;
+    }
+    Barrier("cross-node checked");
+
+    // ---- phase 3: concurrent ----
+    uint64_t own_last = 0, shared_last = 0;
+    std::vector<ReaderResult> rr(static_cast<size_t>(readers));
+    {
+        auto until = std::chrono::steady_clock::now() + std::chrono::seconds(conc_s);
+        std::vector<uint64_t> ids = {ConcId(0), ConcId(1), kShared};
+        std::vector<std::thread> th;
+        for (int i = 0; i < readers; i++)
+            th.emplace_back(Reader, 2 + i, std::cref(ids), until, &rr[static_cast<size_t>(i)]);
+        std::thread w([&] { own_last = Writer(1, ConcId(node_id), until, &shared_last); });
+        w.join();
+        for (auto &t : th) t.join();
+    }
+    MailPut({own_last, shared_last});
+    Barrier("concurrent done");
+    {
+        ReaderResult tot;
+        for (auto &r : rr) {
+            tot.reads += r.reads;
+            tot.retries += r.retries;
+            tot.torn += r.torn;
+            tot.backwards += r.backwards;
+            tot.unwritten += r.unwritten;
+        }
+        LOG(INFO) << "concurrent: reads " << tot.reads << ", retries " << tot.retries << ", torn " << tot.torn
+                  << ", backwards " << tot.backwards << ", own last gen " << own_last;
+        EXPECT(tot.reads > 0);
+        EXPECT(tot.torn == 0);
+        EXPECT(tot.backwards == 0);
+        auto o = MailGet(other);
+        EXPECT(o.size() == 2);
+        const uint64_t other_last = o.empty() ? 0 : o[0];
+        const uint64_t other_shared = o.size() < 2 ? 0 : o[1];
+        rackobj::ObjectHandle h;
+        auto final_gen = [&](uint64_t id) {
+            uint64_t g;
+            for (;;) {
+                CHECK_EQ(rackobj::ObjectReadStart(id, &h), 0);
+                g = InspectGen(h.ptr, h.size, id);
+                if (rackobj::ObjectReadEnd(&h)) return g;
+            }
+        };
+        EXPECT(final_gen(ConcId(node_id)) == own_last);
+        EXPECT(final_gen(ConcId(other)) == other_last);
+        const uint64_t s = final_gen(kShared);
+        EXPECT(s == shared_last || s == other_shared);
+        LOG(INFO) << "final gens: C(own) " << final_gen(ConcId(node_id)) << ", C(other) " << final_gen(ConcId(other))
+                  << " (other reported " << other_last << "), S " << s;
+    }
+    Barrier("concurrent checked");
+
+    // ---- phase 4: many objects ----
+    {
+        std::mt19937_64 rng(1234 + node_id);
+        for (size_t i = 0; i < kMany; i++) {
+            const size_t sz = 1 + rng() % 9000;
+            EXPECT(rackobj::ObjectCreate(ManyId(node_id, i), sz) == 0);
+            WritePat(ManyId(node_id, i), 5);
+        }
+    }
+    Barrier("many written");
+    {
+        std::mt19937_64 rng(1234 + other);
+        size_t bad_objs = 0;
+        uint64_t retries = 0;
+        for (size_t i = 0; i < kMany; i++) {
+            const size_t want = 1 + rng() % 9000;
+            auto [sz, bad] = CheckPat(ManyId(other, i), 5, &retries);
+            if (sz != want || bad) bad_objs++;
+        }
+        EXPECT(bad_objs == 0);
+        LOG(INFO) << "many: " << kMany << " objects of node " << other << " checked, bad " << bad_objs << ", retries "
+                  << retries;
+    }
+    Barrier("many checked");
+
+    // ---- phase 5: slots unchanged (Put/Get next to objects) ----
+    const off_t slot_key = 4242;
+    char val[64];
+    std::snprintf(val, sizeof(val), "slot-from-node-0");
+    if (node_id == 0) EXPECT(rackobj::Put(reinterpret_cast<const uint8_t *>(val), sizeof(val), slot_key) > 0);
+    Barrier("slot put");
+    {
+        char got[64] = {};
+        ssize_t n = rackobj::Get(reinterpret_cast<uint8_t *>(got), sizeof(got), slot_key);
+        EXPECT(n > 0 && std::strcmp(got, val) == 0);
+    }
+    Barrier("slot checked");
+
+    rackobj::ObjectStats st{};
+    rackobj::GetObjectStats(&st);
+    const uint64_t expect_created = 4 /*mailbox, S, P(0), P(1)*/ + 2 /*C(0), C(1)*/ + 1 /*race*/ + 2 * kMany;
+    EXPECT(st.created == expect_created);
+    EXPECT(st.lost_bytes <= 4096);  // only the losing race create (1000 or 1001 B rounded up to object_align)
+    LOG(INFO) << "OBJECT-STATS node " << node_id << ": arena " << st.used_bytes << "/" << st.arena_bytes << " B, created "
+              << st.created << " (expected " << expect_created << "), lost " << st.lost_bytes << " B / "
+              << st.lost_records << " records, static records " << st.static_records_used << "; creates " << st.creates
+              << ", read sections " << st.read_sections << " (retry notify " << st.read_retry_notify
+              << ", incoherent " << st.read_retry_incoherent << "), write sections " << st.write_sections
+              << " (retry " << st.write_retry << ", RW switches " << st.switch_rw << "), flushes " << st.flushes << " ("
+              << st.flush_bytes << " B), replay flushes " << st.replay_flushes << " (" << st.replay_flush_bytes << " B)";
+    Barrier("end");
+    rackobj::UnRegister();
+    const bool pass = failures.load() == 0;
+    LOG(INFO) << "OBJECT-TEST " << (pass ? "PASS" : "FAIL") << " node " << node_id << " (" << failures.load()
+              << " failed checks)";
+    return pass ? 0 : 3;
+}
diff --git a/config/destijl-2vm-objects.yaml b/config/destijl-2vm-objects.yaml
new file mode 100644
index 0000000..1aff38b
--- /dev/null
+++ b/config/destijl-2vm-objects.yaml
@@ -0,0 +1,30 @@
+# De Stijl 2-VM port, phase B: destijl-2vm.yaml plus the paper's variable-size objects (§4; object-test, vectordb).
+# Same file on both VMs except node_id (or set MEGALON_NODE_ID); run_id via MEGALON_RUN_ID.
+mount_directory: /mydata        # required by the config parser; unused
+key_space: 1000000
+slots: 1001000                  # same value for every flavor [V9]
+logical_scr_size: 200MB         # required; same value for every flavor [V9] (small values drive record reclaim)
+node_id: 0                      # 0 = init (VM0), 1 = attach (VM1)
+region_config: ""               # empty: $CXL_REGION_CONFIG
+reinit: false
+attach_mprotect: true
+stuck_timeout_ms: 10000
+log_sync_interval_us: 100
+nr_log_size: 64MB
+attach_timeout_s: 600
+start_barrier_timeout_s: 600
+# phase B: object arena in SWcc after the slot data and the NR log body; bump allocation at create, never freed
+object_arena_size: 256MB        # 0 disables objects (layout then identical to destijl-2vm.yaml)
+object_align: 64                # start alignment and size rounding: 64 or 4096
+object_max_count: 65536         # hwcc flavor only: static coherence records reserved for objects (one per object)
+replicate: false
+flush: false
+evict: false
+partition_ratio: 0.0
+excluded_files:
+excluded_directories:
+  - /usr
+  - /proc
+  - /etc
+  - /dev
+  - /sys
