         coh::Tls& t = coh::tls;
         t.rseq_spin_cnt++;
-        t.rseq_spin_cyc += coh::Now() - spin_t0;
+        t.rseq_spin_cyc += coh::Sub(t, coh::Now(), spin_t0);
     }
 
     return seq & SEQ_MASK;
