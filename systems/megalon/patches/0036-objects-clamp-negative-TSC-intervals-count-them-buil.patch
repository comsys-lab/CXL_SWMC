 /// De Stijl port instrumentation (MOT1 v6, build 71): address of the calling thread's NR read-side wait totals
-/// [episodes, TSC cycles] (node_replication::nr::waitstat); stable for the thread's lifetime.
+/// [episodes, TSC cycles, clamped negative intervals] (node_replication::nr::waitstat); stable for the thread's lifetime.
 #[no_mangle]
 pub extern "C" fn nr_thread_wait_stat() -> *const u64 {
     node_replication::nr::waitstat::thread_ptr()
diff --git a/third-party/nr_rust/node-replication/src/nr/waitstat.rs b/third-party/nr_rust/node-replication/src/nr/waitstat.rs
index 022b723..bc73b33 100644
--- a/third-party/nr_rust/node-replication/src/nr/waitstat.rs
+++ b/third-party/nr_rust/node-replication/src/nr/waitstat.rs
@@ -10,9 +10,9 @@
 
 use core::sync::atomic::{AtomicBool, Ordering};
 
-/// Totals of the calling thread: [episodes, cycles].
+/// Totals of the calling thread: [episodes, cycles, negative intervals clamped to 0 (build 72)].
 #[thread_local]
-static mut WAIT: [u64; 2] = [0, 0];
+static mut WAIT: [u64; 3] = [0, 0, 0];
 
 /// Timers on (default) or off (MEGALON_COH_TIMERS=0): off keeps the counts, durations stay 0.
 pub static TIMERS: AtomicBool = AtomicBool::new(true);
@@ -34,11 +34,15 @@ pub fn add(t0: u64) {
     unsafe {
         let w = &mut *core::ptr::addr_of_mut!(WAIT);
         w[0] += 1;
-        w[1] += t1.wrapping_sub(t0);
+        if t1 >= t0 {
+            w[1] += t1 - t0;
+        } else {
+            w[2] += 1; // TSC went backwards (CPU migration / skew): clamp to 0
+        }
     }
 }
 
-/// Address of the calling thread's [episodes, cycles]; stable for the thread's lifetime.
+/// Address of the calling thread's [episodes, cycles, clamped]; stable for the thread's lifetime.
 pub fn thread_ptr() -> *const u64 {
     unsafe { core::ptr::addr_of!(WAIT) as *const u64 }
 }
