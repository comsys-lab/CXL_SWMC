diff --git a/src/common/coh_stats.h b/src/common/coh_stats.h
index 213a354..8698899 100644
--- a/src/common/coh_stats.h
+++ b/src/common/coh_stats.h
@@ -43,14 +43,24 @@ struct Tls {
     uint64_t sec_ret;      // Now() at ReadStart return
     uint64_t sec_sp0_cnt, sec_sp0_cyc, sec_sp1_cyc;  // SpinNow at ReadStart entry (cnt, cyc) and return (cyc)
     bool sec_sampled;      // this section's checks are timed
+    uint64_t tsc_backwards;  // build 72: negative TSC intervals clamped to 0 (CPU migration / TSC skew guard)
 };
 extern thread_local Tls tls;
 
+// end - start of two TSC values (or of an interval and its nested part); a negative result (TSC not monotonic
+// across CPUs, or skew between nested timestamps) is clamped to 0 and counted in tls.tsc_backwards.
+inline uint64_t Sub(Tls &t, uint64_t end, uint64_t start) {
+    if (end >= start) [[likely]]
+        return end - start;
+    t.tsc_backwards++;
+    return 0;
+}
+
 // Contended-wait totals of the calling thread (read_seqlock_begin spin + NR read-side waits).
 struct Spin {
     uint64_t cnt, cyc;
 };
-const uint64_t *NrPtr();
+const uint64_t *NrPtr();  // [episodes, cycles, clamped negative intervals]
 inline Spin SpinNow(Tls &t) {
     const uint64_t *nr = t.nr ? t.nr : NrPtr();
     return Spin{t.rseq_spin_cnt + nr[0], t.rseq_spin_cyc + nr[1]};
