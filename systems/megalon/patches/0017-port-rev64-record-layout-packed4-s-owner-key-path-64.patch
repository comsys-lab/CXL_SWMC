 std::optional<size_t> GlobalCacheDirectoryHandleNr::SwitchToReadOnlyByWmeta(size_t wmeta_idx,
                                                                             const NrFfi::NrMeta* nr_meta) {
     ssize_t result = NrFfi::SwitchToReadOnlyByWmeta(nr_meta, static_cast<ssize_t>(wmeta_idx));
diff --git a/src/index/gcd_nr.h b/src/index/gcd_nr.h
index fe6879d..ba11791 100644
--- a/src/index/gcd_nr.h
+++ b/src/index/gcd_nr.h
@@ -72,7 +72,7 @@ public:
                                  const NrFfi::NrMeta* nr_meta);
 
