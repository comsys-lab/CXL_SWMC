--- a/benchmarks/kv_store.cc
+++ b/benchmarks/kv_store.cc
@@ -238,8 +238,9 @@ static void workload(AccessPattern* ap, const std::string& latency_filename, con
             } else if (check_values && !CheckValue(vbuf, offset)) {
                 if (bad < 5)
                     LOG(ERROR) << "value check failed: key " << offset << " got key "
-                               << *reinterpret_cast<const uint64_t*>(vbuf) << " stamp 0x" << std::hex
-                               << *reinterpret_cast<const uint64_t*>(vbuf + 8) << std::dec;
+                               << *reinterpret_cast<const uint64_t*>(vbuf) << " stamp " << std::hex
+                               << *reinterpret_cast<const uint64_t*>(vbuf + 8) << std::dec << "; "
+                               << rackobj::DiagLastGet();
                 bad++;
             } else if (check_values && (*reinterpret_cast<const uint64_t*>(vbuf + 8) >> 56) != node_id) {
                 remote++;
@@ -423,6 +424,8 @@ int main(int argc, char** argv) {
     // warmup Puts per worker for the warmup watchdog (kWarmFinished once the worker's warmup share is done)
     constexpr uint64_t kWarmFinished = UINT64_MAX;
     std::vector<PaddedCounter> warm_counters(thread_cnt);
+    // 1 once a worker has returned from its measured loop (post-stop watchdog)
+    std::vector<PaddedCounter> worker_left(thread_cnt);
 
     std::atomic<uint64_t> read_cnt{0};
     std::atomic<uint64_t> read_retry_cnt{0};
@@ -472,6 +475,7 @@ int main(int argc, char** argv) {
             // pass pointer to this thread's counter
             workload(ap_local.get(), latency_filename, write_latency_filename, tput_filename, &read_retry_cnt,
                      &read_cnt, &read_retry_invoc, &control, &thread_counters[i], i, &vstats);
+            worker_left[i].ops.store(1, std::memory_order_release);
 
             barrier.Wait();  // optional: wait for all to finish
             rackobj::UnRegister();
@@ -612,10 +616,35 @@ int main(int argc, char** argv) {
         }
     });
 
+    // De Stijl port diagnostics: after stop, a worker still inside an op for KV_WATCHDOG_S seconds is aborted
+    // with its stack (G-B v2.9 r1-P-rev64 hung here until timeout 900 with no message).
+    std::jthread stop_watchdog;
+    if (watchdog_s > 0)
+        stop_watchdog = std::jthread([&](std::stop_token st) {
+            while (!st.stop_requested() && !control.stop.load(std::memory_order_acquire))
+                std::this_thread::sleep_for(std::chrono::milliseconds(100));
+            for (uint64_t waited = 0; !st.stop_requested(); waited++) {
+                std::this_thread::sleep_for(std::chrono::seconds(1));
+                if (waited + 1 < watchdog_s) continue;
+                for (size_t i = 0; i < thread_cnt; ++i) {
+                    if (worker_left[i].ops.load(std::memory_order_acquire)) continue;
+                    LOG(ERROR) << "WATCHDOG: worker " << i << " still inside an op " << watchdog_s
+                               << "s after stop; " << rackobj::DiagSummary() << "; aborting with its stack";
+                    pthread_kill(workers[i].native_handle(), SIGABRT);
+                    std::this_thread::sleep_for(std::chrono::seconds(10));
+                }
+                return;
+            }
+        });
+
     // join workers
     for (auto& th : workers) {
         if (th.joinable()) th.join();
     }
+    if (stop_watchdog.joinable()) {
+        stop_watchdog.request_stop();
+        stop_watchdog.join();
+    }
 
     // join controller + reporter (they should exit after stop)
     if (controller.joinable()) controller.join();
@@ -658,6 +687,7 @@ int main(int argc, char** argv) {
         verdict = "PASS";
         code = 0;
     }
+    LOG(INFO) << rackobj::DiagSummary();
     LOG(INFO) << "VALUE CHECK: node=" << node_id << " gets=" << vg << " remote_values=" << vr << " bad_values=" << vb
               << " misses=" << vm << " short_reads=" << vs << " " << verdict;
     return code;
