diff --git a/src/common/diag.h b/src/common/diag.h
new file mode 100644
index 0000000..42443d9
--- /dev/null
+++ b/src/common/diag.h
@@ -0,0 +1,37 @@
+#pragma once
+// De Stijl port diagnostics (G-B v2.9 torn reads under reclaim pressure). Active only with MEGALON_DIAG=1;
+// otherwise every hook is a single predictable branch on a cached flag and behaviour is unchanged.
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace rackobj::diag {
+
+inline bool Enabled() {
+    static const bool on = [] {
+        const char *v = std::getenv("MEGALON_DIAG");
+        return v && std::atoi(v) != 0;
+    }();
+    return on;
+}
+
+// Last successful Get on this thread: which path it took and what it validated against.
+struct LastGet {
+    bool valid = false;
+    int64_t cn = -1;     // CXL cache node index of the entry used
+    int64_t wmeta = -1;  // -1: RO path (no seqlock validation)
+    uint32_t seq = 0;    // sequence observed at read start (RW path)
+    uint32_t retries = 0;
+};
+inline thread_local LastGet last_get;
+
+// Writer, after taking the record lock and passing the change-notification check (NR path):
+//   stale_entry:     a synced GCD re-read shows the key no longer holds this record (or is gone)
+//   owner_mismatch:  artifact64 only, the locked record's BlockId names another key
+inline std::atomic<uint64_t> writer_checks{0};
+inline std::atomic<uint64_t> writer_stale_entry{0};
+inline std::atomic<uint64_t> writer_owner_mismatch{0};
+inline std::atomic<uint64_t> gets_ro_path{0};
+inline std::atomic<uint64_t> gets_rw_path{0};
+
+}  // namespace rackobj::diag
diff --git a/src/core/c3.cc b/src/core/c3.cc
index 53617b9..456f673 100644
--- a/src/core/c3.cc
+++ b/src/core/c3.cc
@@ -4,6 +4,7 @@
 #include "lru_policy.h"
 #include "object_slot.h"
 #include "shared_memory/cxl_port.h"
+#include "common/diag.h"
 
 namespace rackobj::common {
 using std::make_unique;
@@ -627,6 +628,26 @@ bool C3POHandle::write_seq_start(WriteHandle &wh
         set_write_handle_errno(wh, WriteErrno::META_OUTDATE);
         return false;
     }
+    if (diag::Enabled()) {
+        // observe only (behaviour unchanged): does the key still hold the record we just locked?
+        diag::writer_checks.fetch_add(1, std::memory_order_relaxed);
+#ifndef WMETA_OWNER_REV
+        if (!(wmeta->GetBlockID() == wh.key)) {
+            uint64_t n = diag::writer_owner_mismatch.fetch_add(1, std::memory_order_relaxed);
+            LOG_IF(WARNING, n < 10) << "DIAG writer: locked record " << wmeta_index.value() << " for key " << wh.key
+                                    << " but its BlockId is " << wmeta->GetBlockID();
+        }
+#endif
+        std::optional<common::GCDEntry> re = Gcd()->Get(wh.key, nr_meta);
+        if (!re.has_value() || re->wmeta_idx_ != wmeta_index) {
+            uint64_t n = diag::writer_stale_entry.fetch_add(1, std::memory_order_relaxed);
+            LOG_IF(WARNING, n < 10) << "DIAG writer: key " << wh.key << " locked record " << wmeta_index.value()
+                                    << " but a synced re-read shows "
+                                    << (!re.has_value() ? std::string("no entry")
+                                        : re->wmeta_idx_.has_value() ? "record " + std::to_string(*re->wmeta_idx_)
+                                                                     : std::string("RO (no record)"));
+        }
+    }
 #else
     // recheck metadata update, prevent time-to-check and time-to-modify problem, use gcd_get again
     std::optional<common::GCDEntry> recheck_optional = Gcd()->Get(wh.key);
