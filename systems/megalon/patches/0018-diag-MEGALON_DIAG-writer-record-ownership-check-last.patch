+std::string DiagLastGet() {
+    const auto &g = diag::last_get;
+    if (!g.valid) return "no Get recorded (MEGALON_DIAG unset?)";
+    return "last Get: cn=" + std::to_string(g.cn) + (g.wmeta < 0 ? " path=RO" : " path=RW wmeta=" + std::to_string(g.wmeta)) +
+           " seq=" + std::to_string(g.seq) + " coherence_retries=" + std::to_string(g.retries);
+}
+
+std::string DiagSummary() {
+    if (!diag::Enabled()) return "diag off";
+    return "DIAG gets_ro=" + std::to_string(diag::gets_ro_path.load()) + " gets_rw=" + std::to_string(diag::gets_rw_path.load()) +
+           " writer_checks=" + std::to_string(diag::writer_checks.load()) +
+           " writer_stale_entry=" + std::to_string(diag::writer_stale_entry.load()) +
+           " writer_owner_mismatch=" + std::to_string(diag::writer_owner_mismatch.load());
+}
+
 }  // namespace rackobj
 
