+// Build 76 port fix (not instrumentation): the object counters of ObjectStats ("this node") were process-wide atomics
+// (one locked add per read section, three per write section, on cache lines shared by every thread). They are now
+// per-thread blocks, written only by their thread (relaxed load + store, no lock prefix) and summed by Stats().
+struct alignas(64) ObjCounters {
+    std::atomic<uint64_t> creates{0}, create_exists{0}, create_nomem{0};
+    std::atomic<uint64_t> read_sections{0}, read_retry_notify{0}, read_retry_incoherent{0};
+    std::atomic<uint64_t> read_retry_stale{0}, read_retry_concurrent{0};
+    std::atomic<uint64_t> write_sections{0}, write_retry{0}, switch_rw{0};
+    std::atomic<uint64_t> flushes{0}, flush_bytes{0};
+};
+std::mutex ctr_mu;
+std::vector<ObjCounters *> *ctr_all = new std::vector<ObjCounters *>;  // never freed: blocks outlive their threads
+thread_local ObjCounters *t_ctr = nullptr;
+
+ObjCounters &Ctr() {
+    if (!t_ctr) [[unlikely]] {
+        auto *c = new ObjCounters;
+        std::lock_guard<std::mutex> g(ctr_mu);
+        ctr_all->push_back(c);
+        t_ctr = c;
+    }
+    return *t_ctr;
+}
+
+inline void Inc(std::atomic<uint64_t> &a, uint64_t v) {
+    a.store(a.load(std::memory_order_relaxed) + v, std::memory_order_relaxed);
+}
+
+uint64_t Sum(std::atomic<uint64_t> ObjCounters::*f) {
+    std::lock_guard<std::mutex> g(ctr_mu);
+    uint64_t n = 0;
+    for (const ObjCounters *c : *ctr_all) n += (c->*f).load(std::memory_order_relaxed);
+    return n;
+}
+
