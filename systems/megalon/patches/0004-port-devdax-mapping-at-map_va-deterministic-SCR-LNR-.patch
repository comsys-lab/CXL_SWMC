+size_t PortContext::ScrFootprint(size_t num_slots, size_t wmeta_slots, size_t log_header_size) {
+    size_t bitmap = A64(((num_slots + 63) / 64) * sizeof(uint64_t));
+    return kCtrlSize + A64(sizeof(SharedCounters)) + 4 * bitmap + 128 + A64(log_header_size) + 64 +
+           wmeta_slots * sizeof(common::WriteMetadata);
+}
+
+uint64_t PortContext::ComputeLayoutHash(const RackOBJConfig &cfg, size_t num_slots) const {
+    NrFfi::NrLogLayout lay = NrFfi::nr_log_layout(nr_log_bytes_);
+    std::ostringstream o;
+    o << "v=" << kCtrlVersion << " dev_size=" << region_.device_size << " map_va=" << region_.map_va
+      << " hwcc=" << region_.hwcc.offset << "+" << region_.hwcc.size << " swcc=" << region_.swcc.offset << "+"
+      << region_.swcc.size << " slots=" << num_slots << " logical_scr=" << cfg.GetLogicalSCRSize()
+      << " SLOT_SIZE=" << SLOT_SIZE << " KEY_SIZE=" << KEY_SIZE << " nodes=" << LOGICAL_NODE_NUM
+      << " flavor=" << MEGALON_FLAVOR_NAME << " defs=" << FlavorDefines() << " build=" << MEGALON_BUILD_ID
+      << " sz(CacheNode)=" << sizeof(common::CacheNode) << " sz(WriteMetadata)=" << sizeof(common::WriteMetadata)
+      << " sz(SharedCounters)=" << sizeof(SharedCounters) << " sz(ControlBlock)=" << sizeof(ControlBlock)
+      << " sz(GCDEntry)=" << sizeof(NrFfi::GCDEntry) << " nrlog_hdr=" << lay.header_size
+      << " nrlog_entry=" << lay.entry_size << " nrlog_entries=" << lay.entries;
+    LOG(INFO) << "layout: " << o.str();
+    return Fnv1a(o.str());
+}
+
+void PortContext::Init(const RackOBJConfig &cfg, size_t num_slots, size_t scr_footprint) {
+    CHECK(!initialized_) << "PortContext initialized twice";
+    node_id_ = cfg.GetNodeId();
+    SetNodeId(node_id_);
+    attach_ = node_id_ != 0;
+    mprotect_ = cfg.AttachMprotect();
+    barrier_timeout_s_ = cfg.BarrierTimeoutS();
+    stuck_timeout_ms_ = cfg.StuckTimeoutMs();
+    log_sync_interval_us_ = cfg.LogSyncIntervalUs();
+    nr_log_bytes_ = cfg.GetNrLogBytes();
+
+    std::string err;
+    const char *path = cfg.GetRegionConfig().empty() ? nullptr : cfg.GetRegionConfig().c_str();
+    if (!cxl::region_load(path, &region_, &err)) LOG(FATAL) << "CXL region config: " << err;
+    LOG(INFO) << "node " << node_id_ << " (" << (attach_ ? "attach" : "init") << "), "
+              << cxl::region_describe(region_);
+    CHECK(region_.hwcc.size > kCtrlSize) << "hwcc_size too small";
+
+    // [V9] refuse runs whose SCR structures do not fit into the HW-coherent range
+    LOG(INFO) << "SCR footprint (upper bound): " << scr_footprint << " bytes of hwcc_size " << region_.hwcc.size;
+    if (scr_footprint > region_.hwcc.size)
+        LOG(FATAL) << "SCR footprint " << scr_footprint << " exceeds hwcc_size " << region_.hwcc.size
+                   << " (reduce slots/logical_scr_size or enlarge hwcc_size); refusing to run";
+
+    int fd = open(region_.device.c_str(), O_RDWR | O_CLOEXEC);
+    PCHECK(fd >= 0) << "open " << region_.device;
+    void *want = reinterpret_cast<void *>(region_.map_va);
+    void *p = mmap(want, region_.device_size, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED_NOREPLACE, fd, 0);
+    PCHECK(p != MAP_FAILED) << "mmap " << region_.device << " at " << want << " length " << region_.device_size;
+    if (p != want) {
+        munmap(p, region_.device_size);
+        LOG(FATAL) << "mapping landed at " << p << " instead of map_va " << want;
+    }
+    close(fd);
+    map_ = static_cast<uint8_t *>(p);
+    ctrl_ = reinterpret_cast<ControlBlock *>(map_ + region_.hwcc.offset);
+    layout_hash_ = ComputeLayoutHash(cfg, num_slots);
+
+    if (!attach_) {
+        bool empty = true;
+        const uint8_t *c = reinterpret_cast<const uint8_t *>(ctrl_);
+        for (size_t i = 0; i < kCtrlSize; i++) {
+            if (c[i]) {
+                empty = false;
+                break;
+            }
+        }
+        if (!empty) {
+            uint32_t st = ctrl_->state.load(std::memory_order_acquire);
+            if (!cfg.Reinit())
+                LOG(FATAL) << "control block is not EMPTY (magic=0x" << std::hex << ctrl_->magic << std::dec
+                           << " state=" << st << "); set reinit: true (or MEGALON_REINIT=1) on node 0 to "
+                           << "re-initialize the shared region";
+            LOG(WARNING) << "re-initializing shared region (previous state " << st << ")";
+        }
+        ctrl_->state.store(kStateInitializing, std::memory_order_release);
+        for (int i = 0; i < kMaxNodes; i++) ctrl_->node_alive[i].store(0, std::memory_order_relaxed);
+        ctrl_->version = kCtrlVersion;
+        ctrl_->init_node = static_cast<uint32_t>(node_id_);
+        ctrl_->layout_hash = layout_hash_;
+        ctrl_->scr_cursor_end = 0;
+        ctrl_->lnr_cursor_end = 0;
+        ctrl_->log_root = 0;
+        ctrl_->init_epoch_ns = NowNs();
+        ctrl_->magic = kCtrlMagic;
+        std::atomic_thread_fence(std::memory_order_release);
+    } else {
+        auto start = std::chrono::steady_clock::now();
+        auto last_log = start;
+        while (!(ctrl_->magic == kCtrlMagic && ctrl_->state.load(std::memory_order_acquire) == kStateReady)) {
+            auto now = std::chrono::steady_clock::now();
+            if (now - start > std::chrono::seconds(cfg.AttachTimeoutS()))
+                LOG(FATAL) << "node 0 did not publish READY within " << cfg.AttachTimeoutS() << " s";
+            if (now - last_log > std::chrono::seconds(10)) {
+                LOG(INFO) << "waiting for node 0 to publish READY (state "
+                          << ctrl_->state.load(std::memory_order_relaxed) << ")";
+                last_log = now;
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        std::atomic_thread_fence(std::memory_order_acquire);
+        if (ctrl_->version != kCtrlVersion)
+            LOG(FATAL) << "control block version " << ctrl_->version << " != " << kCtrlVersion;
+        if (ctrl_->layout_hash != layout_hash_)
+            LOG(FATAL) << "layout_hash mismatch: node 0 0x" << std::hex << ctrl_->layout_hash << ", node "
+                       << std::dec << node_id_ << " 0x" << std::hex << layout_hash_
+                       << " (same binaries, region config, slots and logical_scr_size required)";
+        LOG(INFO) << "attaching to layout 0x" << std::hex << layout_hash_ << std::dec << " (init epoch "
+                  << ctrl_->init_epoch_ns << ")";
+        if (mprotect_) SetProtect(true);
+    }
+
+    scr_ = std::make_shared<common::AllocatableLocalMemoryRegion>(
+        common::AllocatableLocalMemoryRegion::ArenaTag{}, "scr", map_ + region_.hwcc.offset + kCtrlSize,
+        region_.hwcc.size - kCtrlSize);
+    lnr_ = std::make_shared<common::AllocatableLocalMemoryRegion>(common::AllocatableLocalMemoryRegion::ArenaTag{},
+                                                                   "lnr", map_ + region_.swcc.offset,
+                                                                   region_.swcc.size);
+    priv_ = std::make_shared<common::AllocatableLocalMemoryRegion>(common::AllocatableLocalMemoryRegion::HeapTag{},
+                                                                    "private");
+
+    // [V1] shared counter block: the first SCR allocation
+    counters_ = reinterpret_cast<SharedCounters *>(scr_->AllocateBytes(sizeof(SharedCounters), 64));
+    if (!attach_) {
+        std::construct_at(counters_);
+        counters_->wmeta_allocated.v.store(0);
+        counters_->wmeta_reclaim.v.store(0);
+        counters_->wmeta_allocate.v.store(0);
+        counters_->bitmap_count.v.store(0);
+        counters_->bitmap_dirty.v.store(0);
+    }
+    initialized_ = true;
+}
+
+void PortContext::SetProtect(bool read_only) {
+    int prot = read_only ? PROT_READ : (PROT_READ | PROT_WRITE);
+    PCHECK(mprotect(map_ + region_.hwcc.offset, region_.hwcc.size, prot) == 0) << "mprotect hwcc";
+    PCHECK(mprotect(map_ + region_.swcc.offset, region_.swcc.size, prot) == 0) << "mprotect swcc";
+    protected_ = read_only;
+    LOG(INFO) << "shared ranges " << (read_only ? "write-protected for attach" : "writable");
+}
+
+void PortContext::Finish(uint64_t log_root) {
+    CHECK(initialized_);
+    if (!attach_) {
+        ctrl_->scr_cursor_end = scr_->Cursor();
+        ctrl_->lnr_cursor_end = lnr_->Cursor();
+        ctrl_->log_root = log_root;
+        ctrl_->state.store(kStateReady, std::memory_order_release);
+        LOG(INFO) << "init complete, READY published";
+    } else {
+        if (scr_->Cursor() != ctrl_->scr_cursor_end || lnr_->Cursor() != ctrl_->lnr_cursor_end ||
+            log_root != ctrl_->log_root)
+            LOG(FATAL) << "attach layout diverged from node 0: scr cursor " << scr_->Cursor() << " vs "
+                       << ctrl_->scr_cursor_end << ", lnr cursor " << lnr_->Cursor() << " vs "
+                       << ctrl_->lnr_cursor_end << ", log_root 0x" << std::hex << log_root << " vs 0x"
+                       << ctrl_->log_root;
+        if (protected_) SetProtect(false);
+        LOG(INFO) << "attach complete, layout matches node 0";
+    }
+    scr_->Seal();
+    lnr_->Seal();
+    LOG(INFO) << "SCR used: " << kCtrlSize + scr_->Cursor() << " of hwcc_size " << region_.hwcc.size
+              << " bytes; LNR used: " << lnr_->Cursor() << " of swcc_size " << region_.swcc.size
+              << " bytes; log_root 0x" << std::hex << log_root;
+}
+
+void PortContext::StartBarrier() {
+    CHECK(initialized_);
+    ctrl_->node_alive[node_id_].store(1, std::memory_order_release);
+    auto start = std::chrono::steady_clock::now();
+    auto last_log = start;
+    for (;;) {
+        bool all = true;
+        for (int i = 0; i < LOGICAL_NODE_NUM; i++)
+            if (ctrl_->node_alive[i].load(std::memory_order_acquire) != 1) all = false;
+        if (all) break;
+        auto now = std::chrono::steady_clock::now();
+        if (now - start > std::chrono::seconds(barrier_timeout_s_))
+            LOG(FATAL) << "start barrier: not every node became alive within " << barrier_timeout_s_ << " s";
+        if (now - last_log > std::chrono::seconds(10)) {
+            LOG(INFO) << "start barrier: waiting for the other node";
+            last_log = now;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    LOG(INFO) << "start barrier passed: all " << LOGICAL_NODE_NUM << " nodes alive";
+}
+
+void PortContext::Shutdown() {
+    if (!initialized_ || !ctrl_) return;
+    ctrl_->node_alive[node_id_].store(0, std::memory_order_release);
+    if (!attach_) ctrl_->state.store(kStateClosed, std::memory_order_release);
+}
+
+}  // namespace rackobj::port
