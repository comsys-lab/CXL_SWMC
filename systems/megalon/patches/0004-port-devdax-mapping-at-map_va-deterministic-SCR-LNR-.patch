+// De Stijl 2-VM port of Megalon: one process per VM acts as one node; both map
+// the whole shared device at the same virtual address (cxl_region map_va).
+//
+// Layout (from cxl_region.yaml only; HWcc <-> SCR, SWcc <-> LNR):
+//   HWcc page 0                 control block
+//   HWcc [4 KiB, end)           scr arena: shared counters, SCR bitmaps,
+//                               NR log header, WriteMetadata records
+//   SWcc                        lnr arena: CacheNode array, slot data,
+//                               NR log entries
+// Process-local state (handles, local seqcount maps, NR replicas) lives in
+// private memory.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
