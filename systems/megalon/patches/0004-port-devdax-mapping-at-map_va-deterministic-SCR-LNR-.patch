+std::string FlavorDefines() {
+    std::string d;
+#ifdef SCR
+    d += "SCR,";
+#endif
+#ifdef DYN_WMETA
+    d += "DYN_WMETA,";
+#endif
+#ifdef NO_COHERENCE
+    d += "NO_COHERENCE,";
+#endif
+#ifdef FULL_COHERENCE
+    d += "FULL_COHERENCE,";
+#endif
+#ifdef PARTITIONED_NODE
+    d += "PARTITIONED_NODE,";
+#endif
+#ifdef FILE_INTERFACE
+    d += "FILE_INTERFACE,";
+#endif
+    return d;
+}
