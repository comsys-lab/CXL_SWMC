+
+constexpr uint64_t kCtrlMagic = 0x4d45474c4e325643ull;  // "CV2NLGEM"
+constexpr uint32_t kCtrlVersion = 1;
+constexpr size_t kCtrlSize = 4096;
+constexpr int kMaxNodes = 2;
+
+enum CtrlState : uint32_t {
+    kStateEmpty = 0,
+    kStateInitializing = 1,
+    kStateReady = 2,
+    kStateClosed = 3,  // node 0 exited cleanly; attach must wait for a new init
+};
+
+struct alignas(64) PaddedCounter {
+    std::atomic<uint64_t> v;
+};
+
+/* [V1] Counters that every node must see: they used to be process-local members
+ * of BaseMetadata / SharedBitmap. Lives in SCR, accessed as atomics. */
+struct SharedCounters {
+    PaddedCounter wmeta_allocated;  // BaseMetadata::allocated_slot_num_ (gates CheckReserveWmeta, DYN_WMETA reclaim)
+    PaddedCounter wmeta_reclaim;    // BaseMetadata::reclaim_count_
+    PaddedCounter wmeta_allocate;   // BaseMetadata::allocate_count_
+    PaddedCounter bitmap_count;     // SharedBitmap::count_ (stats only, RANDSLOTALLOC)
+    PaddedCounter bitmap_dirty;     // SharedBitmap::dirty_count_ (stats only)
+};
+
+struct ControlBlock {
+    uint64_t magic;
+    uint32_t version;
+    uint32_t init_node;
+    uint64_t layout_hash;
+    uint64_t scr_cursor_end;
+    uint64_t lnr_cursor_end;
+    uint64_t log_root;  // VA of the NR log header (same on every node)
+    uint64_t init_epoch_ns;
+    alignas(64) std::atomic<uint32_t> state;
+    alignas(64) std::atomic<uint32_t> node_alive[kMaxNodes];
+};
+static_assert(sizeof(ControlBlock) <= kCtrlSize, "control block must fit in one page");
+static_assert(std::atomic<uint32_t>::is_always_lock_free && std::atomic<uint64_t>::is_always_lock_free);
+
+class PortContext {
+public:
+    static PortContext &Get();
+
+    /* Map the device, take the init (node 0) or attach (node 1) role, set up the
+     * arenas and the shared counter block. On attach this waits for READY and,
+     * if configured, write-protects both shared ranges until Finish(). */
+    void Init(const RackOBJConfig &cfg, size_t num_slots, size_t scr_footprint);
+
+    bool attach() const { return attach_; }
+    int node_id() const { return node_id_; }
+
+    const std::shared_ptr<common::AllocatableLocalMemoryRegion> &scr() const { return scr_; }
+    const std::shared_ptr<common::AllocatableLocalMemoryRegion> &lnr() const { return lnr_; }
+    const std::shared_ptr<common::AllocatableLocalMemoryRegion> &priv() const { return priv_; }
+
+    SharedCounters *counters() const { return counters_; }
+
+    uint64_t stuck_timeout_ms() const { return stuck_timeout_ms_; }
+    uint64_t log_sync_interval_us() const { return log_sync_interval_us_; }
+    size_t nr_log_bytes() const { return nr_log_bytes_; }
+
+    /* Init: record cursors and log_root, publish READY. Attach: check that the
+     * own construction ended at the recorded cursors and log_root (abort on a
+     * mismatch), then lift the write protection. Both: seal the arenas. */
+    void Finish(uint64_t log_root);
+
+    /* [C4] Mark this node alive and wait until every node is; no NR write may
+     * happen before this returns. */
+    void StartBarrier();
+
+    void Shutdown();
+
+    const cxl::region &region() const { return region_; }
+
+    uint64_t layout_hash() const { return layout_hash_; }
+
+    /* Upper bound of the SCR bytes used by the shared structures, used to refuse
+     * runs that would not fit into hwcc_size [V9]. */
+    static size_t ScrFootprint(size_t num_slots, size_t wmeta_slots, size_t log_header_size);
+
+private:
+    PortContext() = default;
+
+    void SetProtect(bool read_only);
+    uint64_t ComputeLayoutHash(const RackOBJConfig &cfg, size_t num_slots) const;
+
+    bool initialized_ = false;
+    bool attach_ = false;
+    bool protected_ = false;
+    bool mprotect_ = true;
+    int node_id_ = -1;
+    uint64_t barrier_timeout_s_ = 600;
+    uint64_t stuck_timeout_ms_ = 10000;
+    uint64_t log_sync_interval_us_ = 100;
+    size_t nr_log_bytes_ = 64UL << 20;
+    uint64_t layout_hash_ = 0;
+
+    cxl::region region_;
+    uint8_t *map_ = nullptr;
+    ControlBlock *ctrl_ = nullptr;
+    SharedCounters *counters_ = nullptr;
+
+    std::shared_ptr<common::AllocatableLocalMemoryRegion> scr_;
+    std::shared_ptr<common::AllocatableLocalMemoryRegion> lnr_;
+    std::shared_ptr<common::AllocatableLocalMemoryRegion> priv_;
+};
+
