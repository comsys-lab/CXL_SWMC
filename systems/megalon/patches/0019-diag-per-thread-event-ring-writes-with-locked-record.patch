 }  // namespace rackobj::diag
+
+// ---- event ring (MEGALON_DIAG=1): per-thread, lock-free append, dumped once at the end (DiagDump) ----
+#include <ctime>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+namespace rackobj::diag {
+
+enum EvType : uint16_t {
+    kEvWrite = 1,    // Put returned: key, record locked by write_seq_start (-2: path without it), aux = value bytes 8..11
+    kEvPromote = 2,  // SwitchRW: key -> RW with record wmeta, aux = NR result code
+    kEvReclaim = 3,  // reclaim RO switch of victim record wmeta: aux = returned record + 1 (0 = none); key = BlockId (artifact64) or ~0
+};
+enum EvFlag : uint8_t { kFlStale = 1, kFlOwnerMismatch = 2 };
+
+struct Ev {
+    uint64_t t_ns;  // CLOCK_REALTIME
+    uint32_t key;
+    int32_t wmeta;
+    uint32_t aux;
+    uint16_t type;
+    uint8_t tid;  // ring index in this process
+    uint8_t flags;
+};
+static_assert(sizeof(Ev) == 24);
+
+struct Ring {
+    std::unique_ptr<Ev[]> buf;
+    size_t cap = 0, n = 0, dropped = 0;
+    uint8_t tid = 0;
+};
+inline std::mutex ring_mu;
+inline std::vector<Ring *> rings;
+
+inline size_t RingCap() {
+    static const size_t cap = [] {
+        const char *v = std::getenv("MEGALON_DIAG_RING");
+        return v ? static_cast<size_t>(std::atoll(v)) : static_cast<size_t>(8) << 20;  // events per thread
+    }();
+    return cap;
+}
+
+inline Ring *MyRing() {
+    thread_local Ring *r = [] {
+        auto *x = new Ring;  // never freed: dumped at exit by DiagDump
+        x->cap = RingCap();
+        x->buf.reset(new Ev[x->cap]);  // untouched pages until written
+        std::lock_guard<std::mutex> g(ring_mu);
+        x->tid = static_cast<uint8_t>(rings.size());
+        rings.push_back(x);
+        return x;
+    }();
+    return r;
+}
+
+inline uint64_t NowNs() {
+    timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return static_cast<uint64_t>(ts.tv_sec) * 1000000000ull + static_cast<uint64_t>(ts.tv_nsec);
+}
+
+inline void Rec(uint16_t type, uint64_t key, int64_t wmeta, uint32_t aux, uint8_t flags = 0) {
+    if (!Enabled()) return;
+    Ring *r = MyRing();
+    if (r->n < r->cap)
+        r->buf[r->n++] = Ev{NowNs(), static_cast<uint32_t>(key), static_cast<int32_t>(wmeta), aux, type, r->tid, flags};
+    else
+        r->dropped++;
+}
+
+// set by write_seq_start for the current Put (reset by the Put wrapper)
+struct LastWrite {
+    int64_t wmeta = -2;
+    uint8_t flags = 0;
+};
+inline thread_local LastWrite last_write;
+
+}  // namespace rackobj::diag
