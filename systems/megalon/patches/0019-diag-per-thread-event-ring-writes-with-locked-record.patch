+++ b/benchmarks/kv_store.cc
@@ -97,6 +97,35 @@ static inline uint64_t mix64(uint64_t x) {
     return x;
 }
 
+// inverse of mix64 (diagnostics: recover which write's stamp produced each word of a torn value)
+static inline uint64_t unmix64(uint64_t x) {
+    x ^= x >> 33;
+    x *= 0x9cb4b2f8129337dbULL;
+    x ^= x >> 33;
+    x *= 0x4f74430c22a54005ULL;
+    x ^= x >> 33;
+    return x;
+}
+
+// "words a-b <- stamp S" runs of a torn value (word i was written with stamp unmix64(w[i]) ^ key ^ (i << 48))
+static std::string TornValueSources(const uint8_t* buf, off_t key) {
+    uint64_t w[kValueWords];
+    memcpy(w, buf, ACCESS_SIZE);
+    std::ostringstream os;
+    os << "head stamp " << std::hex << w[1];
+    size_t start = 2;
+    uint64_t cur = unmix64(w[2]) ^ static_cast<uint64_t>(key) ^ (2ULL << 48);
+    for (size_t i = 3; i <= kValueWords; i++) {
+        uint64_t s = i < kValueWords ? (unmix64(w[i]) ^ static_cast<uint64_t>(key) ^ (static_cast<uint64_t>(i) << 48)) : ~cur;
+        if (s != cur) {
+            os << "; words " << std::dec << start << "-" << i - 1 << " <- stamp " << std::hex << cur;
+            start = i;
+            cur = s;
+        }
+    }
+    return os.str();
+}
+
 static inline void FillValue(uint8_t* buf, off_t key, uint64_t stamp) {
     uint64_t w[kValueWords];
     w[0] = static_cast<uint64_t>(key);
