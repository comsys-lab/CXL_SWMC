@@ -110,6 +119,23 @@ std::string DiagLastGet() {
            " seq=" + std::to_string(g.seq) + " coherence_retries=" + std::to_string(g.retries);
 }
 
+// Raw dump of every thread's event ring: a sequence of diag::Ev records (24 B, see common/diag.h). Returns a summary.
+std::string DiagDump(const std::string &path) {
+    if (!diag::Enabled()) return "diag off";
+    std::lock_guard<std::mutex> g(diag::ring_mu);
+    FILE *f = fopen(path.c_str(), "wb");
+    if (!f) return "diag dump: cannot open " + path;
+    size_t total = 0, dropped = 0;
+    for (auto *r : diag::rings) {
+        fwrite(r->buf.get(), sizeof(diag::Ev), r->n, f);
+        total += r->n;
+        dropped += r->dropped;
+    }
+    fclose(f);
+    return "diag dump " + path + ": " + std::to_string(total) + " events, " + std::to_string(diag::rings.size()) +
+           " threads, dropped " + std::to_string(dropped);
+}
+
