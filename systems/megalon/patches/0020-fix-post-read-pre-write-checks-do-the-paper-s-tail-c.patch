@@ -296,7 +296,10 @@ bool C3POHandle::CheckNotification(
 ) {
 #if defined(SCR) && defined(DYN_WMETA)
     // our system
-    return Gcd()->CheckNotificationReset(
+    // De Stijl port: post-read check per the paper (§3.4.5 "checks if there were any log updates concerning A",
+    // §3.3 tail check): sync to the log tail first, so an event another host appended during the read is seen
+    // even if this host has not replayed it yet (G-B attempts 9-11, torn reads on the RO path).
+    return Gcd()->CheckNotificationResetSynced(
 #ifdef NR
         nr_meta
 #endif
@@ -315,7 +318,15 @@ bool C3POHandle::CheckNotificationWrite(
 #endif
 ) {
     // our system
+#ifdef DYN_WMETA
+    // De Stijl port: pre-write check per the paper (§3.4.5 "acquires the lock bit, and checks if there were any
+    // log updates since it initially got the index entry"): tail check first, so a record deallocation (RO switch)
+    // appended by another host is seen before writing (G-B attempts 10-11: writes through a reclaimed record).
+    return Gcd()->CheckNotificationResetSynced(
+#else
+    // static records (hwcc flavor): a key's record never changes after install; upstream check kept
     return Gcd()->CheckNotificationReset(
+#endif
 #ifdef NR
         nr_meta
 #endif
