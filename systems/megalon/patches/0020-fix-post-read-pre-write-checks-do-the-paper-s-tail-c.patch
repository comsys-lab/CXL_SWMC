@@ -1394,6 +1395,18 @@ pub extern "C" fn CheckNotificationReset(metadata: *mut NrMeta) -> bool {
     }
 }
 
+/// De Stijl port (paper §3.3 tail check, §3.4.5 post-read / pre-write checks): bring the local replica up to
+/// the shared log's completed tail (replay through exec_notify) and only then test the change notification.
+/// Upstream tested the notification without the tail check, so an event appended by another host but not yet
+/// replayed here was missed (G-B attempts 9-11: torn reads on the RO path).
+#[no_mangle]
+pub extern "C" fn CheckNotificationResetSynced(metadata: *mut NrMeta) -> bool {
+    unsafe {
+        (*metadata).nrht.sync((*metadata).ttkn);
+        (*metadata).nrht.check_notification_reset((*metadata).ttkn)
+    }
+}
+
 #[no_mangle]
 pub extern "C" fn DummyEvent(metadata: *mut NrMeta, key: BlockId) {
     unsafe {
diff --git a/third-party/nr_rust/ffi/port_tests.rs b/third-party/nr_rust/ffi/port_tests.rs
index b888745..528e936 100644
--- a/third-party/nr_rust/ffi/port_tests.rs
+++ b/third-party/nr_rust/ffi/port_tests.rs
@@ -237,3 +237,27 @@ fn stuck_remote_replica_times_out() {
         n0.execute_mut(Modify::PutArrayWmeta(key(k % 16), (k as usize % SLOTS) as isize, 0, -1), t0);
     }
 }
+
+#[test]
+fn ro_switch_notifies_on_replay_and_synced_check_sees_remote_events() {
+    // Paper §3.4.3/§3.4.5: a coherence-record deallocation (RO switch) is an event on the object, and the
+    // post-read check must see events another host appended even if no replay has happened here yet.
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    n0.execute_mut(Modify::PutArrayWmeta(key(1), 11, 0, 5), t0);
+
+    // RO switch response carries the key's cn (upstream: -1).
+    let _ = n1.execute_anchor(Access::Get(key(1)), t1);
+    let r = n0.execute_mut(Modify::CheckSwitchWmetaArray(key(1), -1), t0).0.unwrap();
+    assert_eq!((r.value.wmeta_idx_, r.value.cn_array_[0].cn_idx_), (5, 11));
+
+    // Node 1 has not replayed: the plain check misses the event, the synced check does not.
+    assert!(n1.check_notification_reset(t1), "without a tail check the remote event is invisible");
+    let _ = n1.execute_anchor(Access::Get(key(1)), t1);
+    n0.execute_mut(Modify::CheckSwitchWmetaArray(key(1), 6), t0); // RO -> RW on node 0
+    n1.sync(t1);
+    assert!(!n1.check_notification_reset(t1), "tail check + replay must clear the notification");
+}
