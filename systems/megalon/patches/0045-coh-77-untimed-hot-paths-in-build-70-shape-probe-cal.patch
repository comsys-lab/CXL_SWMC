@@ -2,6 +2,7 @@
 
 #include <time.h>
 
+#include <algorithm>
 #include <atomic>
 #include <cstdlib>
 #include <cstring>
@@ -59,6 +60,24 @@ void ResetThread() {
     t.reclaim_cyc = rc_cyc;
     t.nr = NrFfi::nr_thread_wait_stat();
     t.rng = __rdtsc() ^ (reinterpret_cast<uintptr_t>(&t) * 0x9e3779b97f4a7c15ull) ^ 1;  // jitter seed per thread
+    // build 77 probe calibration: the cost of one timed interval's own TSC reads = median delta of back-to-back
+    // TSC pairs on this thread (after 64 warm-up pairs); 0 with timers off
+    if (g_cfg.timers) {
+        constexpr int kPairs = 255;
+        uint64_t d[kPairs];
+        for (int i = 0; i < 64; i++) {
+            const uint64_t a = Now();
+            const uint64_t b = Now();
+            d[0] = b - a;
+        }
+        for (int i = 0; i < kPairs; i++) {
+            const uint64_t a = Now();
+            const uint64_t b = Now();
+            d[i] = b >= a ? b - a : 0;
+        }
+        std::nth_element(d, d + kPairs / 2, d + kPairs);
+        t.probe_cyc = d[kPairs / 2];
+    }
     const_cast<uint64_t *>(t.nr)[6] = 0;
 }
 
