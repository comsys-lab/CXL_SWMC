         coh_ev_spin += spin;
@@ -1199,6 +1353,7 @@ size_t SharedMemoryObjectHandle<Policy>::Get(const common::BlockId &block_id, ui
     auto coh_spin_total = [&]() -> uint64_t {  // (D) of the whole Get
         ct.spin_cnt += coh::SpinCnt(ct) - coh_sp0_cnt;
         if (!coh_ev) return 0;
