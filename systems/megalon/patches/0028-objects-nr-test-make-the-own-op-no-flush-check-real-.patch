From 14adb06b8b47cac8527ef5a81b692af28ff0abe0 Mon Sep 17 00:00:00 2001
From: Sungsu Ahn <sungsu_ahn@korea.ac.kr>
Date: Thu, 15 Oct 2026 09:11:56 +0900
Subject: [PATCH 28/51] objects nr test: make the own-op no-flush check real
 (n0 replays its own event, n1 then flushes)

Verifier D6. Also note that the process-wide flush counters need --test-threads=1.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 third-party/nr_rust/ffi/object_tests.rs | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/third-party/nr_rust/ffi/object_tests.rs b/third-party/nr_rust/ffi/object_tests.rs
index 3fc677b..27333f3 100644
--- a/third-party/nr_rust/ffi/object_tests.rs
+++ b/third-party/nr_rust/ffi/object_tests.rs
@@ -54,6 +54,7 @@ fn entry(n: &Node, t: ThreadToken, k: BlockId) -> Option<GCDEntry> {
 }
 
 /// Object replay flushes expected per remote event: one per event, `size` bytes each, only with `scr`.
+/// The counters are process-wide: these checks need `--test-threads=1` (as build.sh runs them).
 fn flush_delta(before: (usize, usize)) -> (usize, usize) {
     let now = obj_replay_flush_stats();
     (now.0 - before.0, now.1 - before.1)
@@ -164,11 +165,15 @@ fn every_coherence_event_on_an_object_notifies_and_flushes_its_range() {
     assert!(n1.check_notification_reset(t1));
     expect_flushes(f, 0, size);
 
-    // own ops are not flushed by the issuing node (upstream rule, same as slots)
+    // own ops are not flushed by the issuing node (upstream rule, same as slots): n0 issues an event and replays the
+    // log itself (its own op is applied in its combine, `mine`), with n1 not syncing: no flush; n1's replay: one flush
     let f = obj_replay_flush_stats();
-    let _ = n0.execute_anchor(Access::Get(k), t0);
+    DummyEvent(m0, k);
     n0.sync(t0);
+    n0.log_sync_local();
     expect_flushes(f, 0, size);
+    n1.sync(t1);
+    expect_flushes(f, 1, size);
 }
 
 #[test]
-- 
