+void ObjectStore::ThreadAnchorSnap(rackobj::ThreadAnchor *s) {
+    const coh::Tls &t = coh::tls;
+    const double hz = coh::g_cfg.timers ? coh::TscHz() : 0.0;
+    auto ns = [&](uint64_t cyc) -> uint64_t {
+        return hz > 0 ? static_cast<uint64_t>(static_cast<double>(cyc) * 1e9 / hz + 0.5) : 0;
+    };
+    *s = rackobj::ThreadAnchor{};
+    s->read_sections = t.read_sections;
+    s->write_sections = t.write_sections;
+    s->check_sampled = t.check_sampled;
+    s->read_lookup_ns_sampled = ns(t.lookup_cyc);
+    s->read_nr_ns_sampled = ns(t.rnr_cyc);
+    s->rseq_ns_sampled = ns(t.rseq_cyc);
+    s->write_lookup_ns = ns(t.wlookup_cyc);
+    s->write_nr_ns = ns(t.wnr_cyc);
+    s->wseq_ns = ns(t.wseq_cyc);
+    s->wseq_end_ns = ns(t.wseq_end_cyc);
+}
