 // check_sampled.
 void GetThreadAnchorSplit(uint64_t out[4]);
+
+/* Build 75: the work of the CALLING thread that a Megalon-hwcc all-HWcc also executes, since Register(), ns (field
+ * order = mshim::AnchorSnap, systems/megalon/shim/megalon_objapi.h v3; intervals reports/M2-megalon-port-changes.md
+ * §16). Sampled fields cover the same sampled read sections as ObjectThreadCoh.check_ns_sampled.
+ *   read_lookup_ns_sampled  index lookup of the first anchor outside (A) (excluded from check; = reserved[7])
+ *   read_nr_ns_sampled      NR anchor work of that anchor (excluded from check)
+ *   rseq_ns_sampled         seqlock version reads whose time is in check: RSeqBegin of read_seq_start (minus its (D)
+ *                           spin) of attempts outside (A), RSeqRetry of read_seq_end of accepted sections (INSIDE check)
+ *   write_lookup_ns, write_nr_ns   the final attempt's anchor of every write section (excluded from wstart)
+ *   wseq_ns                 WSeqBegin (lock CAS, incl. its wait) of the final attempt's write_seq_start (INSIDE wstart)
+ *   wseq_end_ns             WSeqEnd (unlock store) of write_seq_end (INSIDE wflush) */
+struct ThreadAnchor {
+    uint64_t read_sections, write_sections, check_sampled;
+    uint64_t read_lookup_ns_sampled, read_nr_ns_sampled, rseq_ns_sampled;
+    uint64_t write_lookup_ns, write_nr_ns, wseq_ns, wseq_end_ns;
+    uint64_t reserved[6];
+};
+
+void GetThreadAnchor(ThreadAnchor* s);
 // build 71, overhead measurement only (object-test OBJECT_TEST_OVERHEAD): switch the instrumentation timers at run
 // time (initial value: MEGALON_COH_TIMERS). Call only while no thread of the process has an open section or a
 // wait in progress; durations recorded across a switch are meaningless.
