+rackobj::ThreadAnchor AncDiff(const rackobj::ThreadAnchor &a, const rackobj::ThreadAnchor &b) {
+    rackobj::ThreadAnchor d = b;
+    const uint64_t *pa = reinterpret_cast<const uint64_t *>(&a);
+    uint64_t *pd = reinterpret_cast<uint64_t *>(&d);
+    for (size_t i = 0; i < offsetof(rackobj::ThreadAnchor, reserved) / 8; i++) pd[i] -= pa[i];
+    return d;
+}
