+// ---------- Value checks (De Stijl port) ----------
+// Every Put writes a self-describing value: [0] key, [1] stamp (node, thread, seq),
+// [2..] words derived from (key, stamp, index). A Get must return a complete value
+// of the requested key; a torn or misplaced value fails the check.
+static_assert(ACCESS_SIZE % sizeof(uint64_t) == 0 && ACCESS_SIZE >= 3 * sizeof(uint64_t));
+static constexpr size_t kValueWords = ACCESS_SIZE / sizeof(uint64_t);
+
+static inline uint64_t mix64(uint64_t x) {
+    x ^= x >> 33;
+    x *= 0xff51afd7ed558ccdULL;
+    x ^= x >> 33;
+    x *= 0xc4ceb9fe1a85ec53ULL;
+    x ^= x >> 33;
+    return x;
+}
+
+static inline void FillValue(uint8_t* buf, off_t key, uint64_t stamp) {
+    uint64_t w[kValueWords];
+    w[0] = static_cast<uint64_t>(key);
+    w[1] = stamp;
+    for (size_t i = 2; i < kValueWords; i++) w[i] = mix64(static_cast<uint64_t>(key) ^ stamp ^ (i << 48));
+    memcpy(buf, w, ACCESS_SIZE);
+}
+
+static inline bool CheckValue(const uint8_t* buf, off_t key) {
+    uint64_t w[kValueWords];
+    memcpy(w, buf, ACCESS_SIZE);
+    if (w[0] != static_cast<uint64_t>(key)) return false;
+    for (size_t i = 2; i < kValueWords; i++)
+        if (w[i] != mix64(static_cast<uint64_t>(key) ^ w[1] ^ (i << 48))) return false;
+    return true;
+}
+
+static inline uint64_t MakeStamp(size_t thread_idx, uint64_t seq) {
+    return (static_cast<uint64_t>(node_id) << 56) | (static_cast<uint64_t>(thread_idx & 0xffff) << 40) |
+           (seq & ((1ULL << 40) - 1));
+}
+
+struct ValueCheckStats {
+    std::atomic<uint64_t> gets{0};
+    std::atomic<uint64_t> misses{0};       // Get found no entry (all keys are warmed up first)
+    std::atomic<uint64_t> bad_values{0};   // Get returned a value that fails CheckValue
+    std::atomic<uint64_t> short_reads{0};  // Get returned fewer than ACCESS_SIZE bytes
+};
