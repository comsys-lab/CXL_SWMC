+/// Build 74 instrumentation: a flagged anchor records its index-lookup cycles (slot 4); an unflagged one records
+/// nothing; replaying another node's ops inside a flagged anchor records Megalon-only flush cycles (slot 5) only with
+/// the `scr` feature.
+#[test]
+fn waitstat_flagged_anchor_records_lookup_only_when_flagged() {
+    use node_replication::nr::waitstat;
+    let w = || waitstat::thread_ptr() as *mut u64;
+    let rd = |i: usize| unsafe { *w().add(i) };
+    let m = shared_mem(min_entries());
+    let n0 = node(&m, 0, true, 2000);
+    let n1 = node(&m, 1, false, 2000);
+    let t0 = n0.register(0).unwrap();
+    let t1 = n1.register(1).unwrap();
+    n0.execute_mut(Modify::PutArrayWmeta(key(1), 11, 0, -1), t0);
+    let (l0, f0) = (rd(4), rd(5));
+    let _ = n1.execute_anchor(Access::Get(key(1)), t1);
+    assert_eq!((rd(4), rd(5)), (l0, f0), "unflagged anchor must not record");
+    for k in 0..50u64 {
+        n0.execute_mut(Modify::PutArrayWmeta(key(100 + k), 100 + k as isize, 0, -1), t0);
+    }
+    unsafe { *w().add(3) = 1 };
+    let r = n1.execute_anchor(Access::Get(key(1)), t1);
+    unsafe { *w().add(3) = 0 };
+    assert_eq!(r.0.unwrap().value.cn_array_[0].cn_idx_, 11);
+    assert!(rd(4) > l0, "flagged anchor records the lookup");
+    if cfg!(feature = "scr") {
+        assert!(rd(5) > f0, "replaying 50 remote ops in a flagged anchor records coherence flushes (scr)");
+    } else {
+        assert_eq!(rd(5), f0);
+    }
+}
