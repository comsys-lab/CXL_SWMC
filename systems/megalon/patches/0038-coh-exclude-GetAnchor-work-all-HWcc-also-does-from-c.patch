+// Runs fn() (one GetAnchor) with the NR anchor flag set and returns its result; adds the split to *out.
+template <class F>
+inline auto TimedAnchor(Tls &t, AnchorSplit *out, F &&fn) {
+    uint64_t *w = const_cast<uint64_t *>(t.nr ? t.nr : NrPtr());
+    const uint64_t l0 = w[4], f0 = w[5], s0 = SpinNow(t).cyc;
+    w[3] = 1;
+    const uint64_t t0 = Now();
+    auto r = fn();
+    const uint64_t t1 = Now();
+    w[3] = 0;
+    const uint64_t lookup = w[4] - l0, fl = w[5] - f0, spin = SpinNow(t).cyc - s0;
+    out->lookup += lookup;
+    out->nr += Sub(t, Sub(t, t1, t0), lookup + fl + spin);
+    return r;
+}
