+void ObjectStore::ThreadAnchorSplit(uint64_t out[4]) {
+    const coh::Tls &t = coh::tls;
+    const double hz = coh::g_cfg.timers ? coh::TscHz() : 0.0;
+    auto ns = [&](uint64_t cyc) -> uint64_t {
+        return hz > 0 ? static_cast<uint64_t>(static_cast<double>(cyc) * 1e9 / hz + 0.5) : 0;
+    };
+    out[0] = ns(t.lookup_cyc);
+    out[1] = ns(t.rnr_cyc);
+    out[2] = ns(t.wlookup_cyc);
+    out[3] = ns(t.wnr_cyc);
+}
+
 void ObjectStore::ThreadCoh(ObjectThreadCoh *s) {
     const coh::Tls &t = coh::tls;
     const bool on = coh::g_cfg.timers;
@@ -390,6 +414,7 @@ void ObjectStore::ThreadCoh(ObjectThreadCoh *s) {
     s->reserved[4] = ns(t.admit_cyc);
     s->reserved[5] = t.kv_reads;                          // build 73: KV Gets / Puts among read/write_sections
     s->reserved[6] = t.kv_writes;
+    s->reserved[7] = ns(t.lookup_cyc);  // build 74: (i) index lookup of the sampled read sections (like check)
 }
 
