     )
 }
 
+/// Builds with more than two nodes: nodes 2..LOGICAL_NODE_NUM attach and only replay (log_sync_local) until `stop`,
+/// so tests that wrap the log are not held back by replicas that never execute. None for a 2-node build.
+pub(crate) fn idle_extra_nodes(m: &SharedMem, timeout_ms: u64, stop: &Arc<AtomicBool>) -> Vec<std::thread::JoinHandle<()>> {
+    (2..LOGICAL_NODE_NUM)
+        .map(|id| {
+            let n = node(m, id, false, timeout_ms);
+            let s = Arc::clone(stop);
+            std::thread::spawn(move || {
+                while !s.load(Ordering::Acquire) {
+                    n.log_sync_local();
+                    std::thread::sleep(std::time::Duration::from_micros(50));
+                }
+            })
+        })
+        .collect()
+}
+
 pub(crate) fn key(k: u64) -> BlockId {
     let mut b = null_BlockId();
     b.offset_ = k as _;
@@ -202,6 +219,7 @@ fn remote_progress_unblocks_gc_and_log_wraps() {
     let n0 = node(&m, 0, true, 10_000);
     let n1 = node(&m, 1, false, 10_000);
     let stop = Arc::new(AtomicBool::new(false));
+    let extra = idle_extra_nodes(&m, 10_000, &stop);
     let (n1c, stopc) = (Arc::clone(&n1), Arc::clone(&stop));
     let syncer = std::thread::spawn(move || {
         while !stopc.load(Ordering::Acquire) {
@@ -217,6 +235,7 @@ fn remote_progress_unblocks_gc_and_log_wraps() {
     }
     stop.store(true, Ordering::Release);
     syncer.join().unwrap();
+    extra.into_iter().for_each(|h| h.join().unwrap());
     let l = n0.log();
     assert!(l.tail_now() >= total as usize);
     assert!(l.head_now() > 0, "GC advanced past the first wrap");
@@ -334,6 +353,7 @@ fn op_enqueued_during_sync_round_is_served() {
