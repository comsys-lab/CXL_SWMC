         .and_then(|s| s.parse::<usize>().ok());
diff --git a/third-party/nr_rust/ffi/constants.rs b/third-party/nr_rust/ffi/constants.rs
index 977ea91..efb2529 100644
--- a/third-party/nr_rust/ffi/constants.rs
+++ b/third-party/nr_rust/ffi/constants.rs
@@ -9,8 +9,22 @@ pub const NUM_EXEC: usize = 3;
 /**
  * number of logical node (replicas) that shares the cxl memory
  * there is a round robin assignment of replicas to hardware numa execution node
+ * De Stijl port: build-time parameter, env MEGALON_NODES (build.rs; default 2); must match the C++ LOGICAL_NODE_NUM
  */
-pub const LOGICAL_NODE_NUM: usize = 2;
+pub const LOGICAL_NODE_NUM: usize = parse_nodes(env!("MEGALON_NODES"));
+
+const fn parse_nodes(s: &str) -> usize {
+    let b = s.as_bytes();
+    assert!(!b.is_empty(), "MEGALON_NODES is empty");
+    let mut n = 0usize;
+    let mut i = 0;
+    while i < b.len() {
+        assert!(b[i] >= b'0' && b[i] <= b'9', "MEGALON_NODES is not a decimal number");
+        n = n * 10 + (b[i] - b'0') as usize;
+        i += 1;
+    }
+    n
+}
 
