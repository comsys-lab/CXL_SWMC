index 70fff36..23c68dd 100644
--- a/third-party/nr_rust/ffi/build.rs
+++ b/third-party/nr_rust/ffi/build.rs
@@ -4,6 +4,22 @@ fn main() {
     // Declare expected cfg keys (prevents warnings)
     println!("cargo:rustc-check-cfg=cfg(key_size_24)");
 
+    // De Stijl port: node count (LOGICAL_NODE_NUM, constants.rs) is a build-time parameter, env MEGALON_NODES
+    // (default 2, the 2-VM build). Must equal the C++ side (-DMEGALON_NODES=N -> LOGICAL_NODE_NUM, constants.h).
+    // Declaring rerun-if lines disables cargo's "rerun on any package file change", so list every input.
+    println!("cargo:rerun-if-env-changed=MEGALON_NODES");
+    println!("cargo:rerun-if-env-changed=KEY_SIZE");
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rerun-if-changed=constants.rs");
+    let nodes = match env::var("MEGALON_NODES") {
+        Ok(s) => s.trim().parse::<usize>().unwrap_or_else(|_| panic!("MEGALON_NODES={:?} is not a number", s)),
+        Err(_) => 2,
+    };
+    // node-replication: num_replicas < MAX_REPLICAS_PER_LOG (16); the port tests use nodes 0 and 1
+    assert!((2..=15).contains(&nodes), "MEGALON_NODES={} out of range [2, 15]", nodes);
