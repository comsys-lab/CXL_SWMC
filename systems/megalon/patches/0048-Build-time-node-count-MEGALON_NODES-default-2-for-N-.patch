diff --git a/CMakeLists.txt b/CMakeLists.txt
index ca096d3..4db2b74 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,18 @@ elseif (NOT MEGALON_WMETA_LAYOUT STREQUAL "artifact64")
 endif()
 message(STATUS "MEGALON_WMETA_LAYOUT=${MEGALON_WMETA_LAYOUT}")
 
+# De Stijl port: node count (one node per VM) = LOGICAL_NODE_NUM (src/common/constants.h, default 2). The nr lib must be
+# built with the same count (env MEGALON_NODES for cargo; checked below through <lib>.features "nodes=" and at run time
+# by PortContext::Init). The definition is only added for N != 2, so a 2-node build compiles exactly as before.
+set(MEGALON_NODES "2" CACHE STRING "number of Megalon nodes (VMs), 2..15")
+if (NOT MEGALON_NODES MATCHES "^[0-9]+$" OR MEGALON_NODES LESS 2 OR MEGALON_NODES GREATER 15)
+    message(FATAL_ERROR "MEGALON_NODES must be in [2, 15] (got '${MEGALON_NODES}')")
+endif()
+if (NOT MEGALON_NODES EQUAL 2)
+    add_definitions(-DLOGICAL_NODE_NUM=${MEGALON_NODES})
+endif()
+message(STATUS "MEGALON_NODES=${MEGALON_NODES}")
+
 if (FULL_COHERENCE)
     add_definitions(-DFULL_COHERENCE=1)
 endif()
@@ -198,6 +210,14 @@ file(STRINGS "${MEGALON_NR_LIB}.features" _nr_tag REGEX "^features=")
 if (NOT _nr_tag STREQUAL "features=${MEGALON_NR_FEATURES}")
     message(FATAL_ERROR "nr lib ${MEGALON_NR_LIB} was built with '${_nr_tag}', flavor ${MEGALON_FLAVOR} needs 'features=${MEGALON_NR_FEATURES}'")
 endif()
+# node count of the nr lib: "nodes=N" line of the tag; tags without it (2-node builds before megalon-n) mean 2
+file(STRINGS "${MEGALON_NR_LIB}.features" _nr_nodes REGEX "^nodes=")
+if (NOT _nr_nodes)
+    set(_nr_nodes "nodes=2")
+endif()
+if (NOT _nr_nodes STREQUAL "nodes=${MEGALON_NODES}")
+    message(FATAL_ERROR "nr lib ${MEGALON_NR_LIB} was built with '${_nr_nodes}', this build needs 'nodes=${MEGALON_NODES}'")
+endif()
 message(STATUS "linking nr lib ${MEGALON_NR_LIB} (features='${MEGALON_NR_FEATURES}')")
 target_link_libraries(megalon ${MEGALON_NR_LIB} hwloc)
 
