From 304d80e33d50916b6b7762518ca54c22e29b75b6 Mon Sep 17 00:00:00 2001
From: Sungsu Ahn <sungsu_ahn@korea.ac.kr>
Date: Wed, 14 Oct 2026 22:59:38 +0900
Subject: [PATCH 12/51] diag: absl failure signal handler before static init;
 init step logs

G-B attempt 2 run 1 aborted (SIGABRT, rc 134) after InitSharedMetadata with no
message and no core (ulimit -c 0). Print a symbolized trace on the next run.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt        |  2 +-
 lib/shm_obj_handle.cc |  6 ++++++
 src/common/config.cc  | 16 ++++++++++++++++
 3 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 7f36f49..1b7cee3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -146,7 +146,7 @@ target_include_directories(megalon SYSTEM PRIVATE ${YAML_CPP_INCLUDE_DIR})
 
 add_subdirectory(${MEGALON_SOURCE_DIR}/third-party/abseil-cpp)
 
-target_link_libraries(megalon absl::log absl::check absl::flat_hash_map absl::status yaml-cpp::yaml-cpp numa atomic)
+target_link_libraries(megalon absl::log absl::check absl::flat_hash_map absl::status absl::failure_signal_handler absl::symbolize yaml-cpp::yaml-cpp numa atomic)
 
 # linking nr: the per-flavor libnr_hashmap.a is built out of tree (absolute
 # CARGO_TARGET_DIR, systems/megalon/build.sh) and passed in. Its feature tag
diff --git a/lib/shm_obj_handle.cc b/lib/shm_obj_handle.cc
index 0d5d118..a0b091c 100644
--- a/lib/shm_obj_handle.cc
+++ b/lib/shm_obj_handle.cc
@@ -56,16 +56,21 @@ SharedMemoryObjectHandle<Policy>::SharedMemoryObjectHandle(const int node, const
     c3po_ = C3POHandle::CreateOrMap(shared_num_slots, (void *)0x6f0000000000, NUMA_MEM, cache_->GetPageBaseAddr(),
                                     sc_shm_region_, cfg.GetLogicalSCRSize());
     c3po_->InitSharedMetadata(shared_num_slots, sc_shm_region_, &cache_shrd_ptr_->scr_bitmap_);
+    LOG(INFO) << "init step: shared metadata done";
     c3po_->SetPartitionRatio(cfg.GetKeySpace(), cfg.GetPartitionRatio());
+    LOG(INFO) << "init step: partition ratio set";
 
     // per-node local state: only this process's node
     c3po_->CreateLocalSeqMap(node_id);
+    LOG(INFO) << "init step: local seq map created";
 #ifdef PARTITIONED_NODE
     cache_lcl_ptr_[node_id] = common::LocalMemoryObject<Policy>::CreateLocalMemoryObject(num_slots, local_region_);
 #endif
     // one background wmeta manager, on node 0 only; critical-path reclamation runs on every node [V2]
     if (node_id == 0) c3po_->CreateWmetaMgr(node_id, local_region_);
+    LOG(INFO) << "init step: wmeta manager created";
     c3po_->SetSharedPageCache(cache_shrd_ptr_);
+    LOG(INFO) << "init step: page cache set";
 #ifdef PARTITIONED_NODE
     c3po_->SetCaches(cache_shrd_ptr_, cache_lcl_ptr_);
 #endif
@@ -75,6 +80,7 @@ SharedMemoryObjectHandle<Policy>::SharedMemoryObjectHandle(const int node, const
     ctx.StartBarrier();
 
     c3po_->StartManager();
+    LOG(INFO) << "init step: managers started";
 }
 
 template <typename Policy>
diff --git a/src/common/config.cc b/src/common/config.cc
index 46f2072..a193fa3 100644
--- a/src/common/config.cc
+++ b/src/common/config.cc
@@ -1,3 +1,5 @@
+#include "absl/debugging/failure_signal_handler.h"
+#include "absl/debugging/symbolize.h"
 #include "config.h"
 
 #include <algorithm>
@@ -17,9 +19,23 @@ using std::stoull;
 using std::string;
 
 static const char *kConfigPathEnvVar = "RACKOBJ_CONFIG";
+
+// De Stijl port: libmegalon initializes during static init, before main(); install a failure signal
+// handler first so an abort/crash there prints a symbolized stack trace to stderr (G-B run 1 aborted
+// with SIGABRT and no message).
+static void InstallCrashDiagnostics() {
+    static bool done = false;
+    if (done) return;
+    done = true;
+    absl::InitializeSymbolizer("/proc/self/exe");
+    absl::FailureSignalHandlerOptions opts;
+    opts.call_previous_handler = true;
+    absl::InstallFailureSignalHandler(opts);
+}
 static const char *kDefaultConfigPath = "/opt/rackobj/config";
 
 RackOBJConfig::RackOBJConfig() {
+    InstallCrashDiagnostics();
 #ifdef NDEBUG
     LOG(INFO) << "Initializing configuration (NDEBUG)...";
 #else
-- 
